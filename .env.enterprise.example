# Secora AI — additional variables read by docker-compose.enterprise.yml
# on top of the base .env file (see .env.example). Copy to
# `.env.enterprise`, fill in real values, then pass both files with
# `--env-file`:
#
#   docker compose -f docker-compose.yml -f docker-compose.enterprise.yml \
#     --env-file .env --env-file .env.enterprise \
#     up -d --build --scale api=3 --scale worker=3

# --- Redis (Queue + Cache providers) ---
REDIS_PASSWORD=

# --- MinIO (S3-compatible Storage provider) ---
MINIO_ROOT_USER=pentesthub
MINIO_ROOT_PASSWORD=
STORAGE_S3_BUCKET=pentesthub
STORAGE_S3_REGION=us-east-1

# --- Backups — required if any BackupPolicy has encrypt=true (the
# default; see apps/api/prisma/schema.prisma's BackupPolicy model) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
