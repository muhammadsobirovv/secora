# Secora AI — Docker Compose deployment environment (Module 10:
# Production Deployment). This is the variable set docker-compose.yml
# reads; for local (non-Docker) development against `pnpm dev`, see
# apps/api/.env.example instead, which covers the full development-time
# surface (recon tool binary overrides, etc.) this file intentionally
# doesn't repeat.
#
# Copy to `.env` in the repo root, fill in real values, then:
#   docker compose up -d --build

# --- Postgres ---
POSTGRES_USER=pentesthub
POSTGRES_PASSWORD=
POSTGRES_DB=pentesthub

# --- API secrets — generate each with: ---
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Do not reuse the same value for both.
JWT_ACCESS_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# --- API/worker tuning ---
DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=5
# Set to the number of reverse-proxy hops in front of this stack (1 if
# you put nginx/Caddy/an ALB directly in front of the `api` container,
# as the deploy/ examples do) — see TRUST_PROXY_HOPS's doc comment in
# apps/api/src/config/env.validation.ts.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# --- URLs ---
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Observability (Module 10) — both optional ---
# Shared-secret required to scrape the per-organization Prometheus
# endpoint (see metrics.controller.ts) — leave unset only for a
# deployment where /enterprise/*/distributed-jobs/metrics/prometheus is
# never exposed publicly.
OBSERVABILITY_METRICS_TOKEN=
# OTLP/HTTP collector endpoint (Jaeger, Tempo, Honeycomb, ...) for
# distributed tracing — leave unset to run with tracing enabled but
# nothing exported anywhere.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Monitoring (Module 14) — only read if using docker-compose.monitoring.yml ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- OAuth (optional — leave unset to disable Google/GitHub login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# --- Billing (Module 15) — all optional. Leave every value below unset
# (BILLING_PROVIDER defaults to "none") to run in Community Edition mode:
# BillingService still creates a real Subscription row per organization,
# pinned to PlanTier.FREE, it just never calls out to a payment provider,
# and every RECON_JOBS/SCANNER_JOBS/AI_* quota/budget resolves to
# unlimited unless a QuotaPolicy/AiBudgetPolicy row is created explicitly.
# Set BILLING_PROVIDER=stripe and fill in the three STRIPE_* keys below
# to accept real payments — STRIPE_WEBHOOK_SECRET verifies Stripe's own
# HMAC signature on POST /billing/webhooks/stripe. BILLING_WEBHOOK_SECRET
# is a separate shared secret for the generic (non-Stripe) enterprise
# billing webhook (POST /enterprise/billing/webhook) — only needed if
# that endpoint is used; it deliberately has no "accept with no secret
# configured" fallback. ---
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
BILLING_WEBHOOK_SECRET=
