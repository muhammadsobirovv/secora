{
  "name": "@pentesthub/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for the PentestHub AI REST API.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@pentesthub/shared": "workspace:*"
  },
  "devDependencies": {
    "@pentesthub/eslint-config": "workspace:*",
    "@pentesthub/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
