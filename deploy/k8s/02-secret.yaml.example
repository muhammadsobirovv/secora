# Template for the Secret the api/worker Deployments mount via
# `envFrom`. Deliberately named `*.yaml.example` (not `.yaml`) so it's
# never accidentally `kubectl apply -f deploy/k8s/`'d as-is with empty
# placeholder secrets, and so it's safe to commit — copy this to
# `02-secret.yaml` (already covered by .gitignore's `deploy/k8s/*secret*`
# — do not remove that entry) and fill in real values before applying,
# or better, generate it directly without ever writing plaintext to
# disk:
#
#   kubectl create secret generic pentesthub-secrets -n pentesthub \
#     --from-literal=DATABASE_URL='postgresql://user:pass@host:5432/pentesthub' \
#     --from-literal=JWT_ACCESS_SECRET="$(node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))')" \
#     --from-literal=CREDENTIAL_ENCRYPTION_KEY="$(node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))')"
#
# For a real production cluster, prefer an external-secrets operator
# (External Secrets Operator, Sealed Secrets, or your cloud provider's
# native secret manager integration) over either approach — plain
# Kubernetes Secrets are only base64-encoded, not encrypted, unless the
# cluster has encryption-at-rest configured for the Secrets resource
# type specifically (not on by default on most managed clusters).
apiVersion: v1
kind: Secret
metadata:
  name: pentesthub-secrets
  namespace: pentesthub
type: Opaque
stringData:
  # Only needed if using 03-postgres.yaml's self-managed StatefulSet —
  # must match the password embedded in DATABASE_URL below. Omit both
  # this key and 03-postgres.yaml entirely if pointing DATABASE_URL at
  # a managed Postgres instance instead (recommended — see that file's
  # closing comment).
  POSTGRES_PASSWORD: "CHANGE_ME"
  DATABASE_URL: "postgresql://pentesthub:CHANGE_ME@postgres:5432/pentesthub"
  JWT_ACCESS_SECRET: "CHANGE_ME_32_PLUS_CHARS"
  CREDENTIAL_ENCRYPTION_KEY: "CHANGE_ME_32_PLUS_CHARS_DIFFERENT_FROM_ABOVE"
  OBSERVABILITY_METRICS_TOKEN: "CHANGE_ME"
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  GITHUB_CLIENT_ID: ""
  GITHUB_CLIENT_SECRET: ""
  # --- Module 14: Cloud Platform / HA / Backups — all optional, only
  # needed if the corresponding *_PROVIDER ConfigMap value in
  # 01-configmap.yaml is set to something other than the Community
  # Edition default (memory/local/memory). Leave blank to run this
  # cluster in the same zero-external-dependency mode Community Edition
  # runs in on a single machine. ---
  REDIS_PASSWORD: "" # consumed directly by 13-redis.yaml's Redis container's own --requirepass
  REDIS_URL: "" # e.g. redis://:<same password as REDIS_PASSWORD above>@redis:6379 — read by the api/worker Deployments
  STORAGE_S3_ACCESS_KEY_ID: ""
  STORAGE_S3_SECRET_ACCESS_KEY: ""
  # AES-256-GCM key for BackupPolicy.encrypt=true (the default) — see
  # apps/api/src/common/utils/buffer-encryption.util.ts. Backups
  # triggered with encrypt=true fail loudly (BACKUP_ENCRYPTION_KEY_NOT_CONFIGURED)
  # rather than silently writing plaintext archives if this is unset.
  BACKUP_ENCRYPTION_KEY: "CHANGE_ME_32_PLUS_CHARS"
