# Secora AI — background worker process (Module 10: Production
# Deployment). Runs `dist/src/worker.main.js` — the Recon/Vuln
# ToolRunner execution loop (Modules 3/4), a separate OS process from
# the main HTTP API server (`apps/api/Dockerfile`) so a long-running or
# CPU-heavy tool execution never competes with the API's own event loop
# for request-handling latency. Same multi-stage shape as the API
# Dockerfile — see that file's comments for the reasoning behind each
# stage; only the final CMD differs.
#
# Build from the monorepo root:
#   docker build -f apps/api/Dockerfile.worker -t pentesthub-worker .
FROM node:25-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /workspace

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/browser-extension/package.json apps/browser-extension/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
COPY packages/agent-sdk/package.json packages/agent-sdk/package.json
COPY packages/sdk-typescript/package.json packages/sdk-typescript/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter api exec prisma generate
RUN pnpm --filter shared build
# apps/api imports @pentesthub/agent-sdk and @pentesthub/sdk directly --
# see apps/api/Dockerfile's matching comment. @pentesthub/sdk must build
# first: agent-sdk imports from it.
RUN pnpm --filter @pentesthub/sdk build
RUN pnpm --filter @pentesthub/agent-sdk build
# See apps/api/Dockerfile for why this needs an explicit heap ceiling.
RUN NODE_OPTIONS="--max-old-space-size=6144" pnpm --filter api build

# Recon tool binaries (Module 3's ToolRunner adapters spawn these by name
# from PATH — see RECON_TOOL_BIN_* in src/config/env.validation.ts).
# Without this stage the runtime image had none of them, so every tool
# run failed with `spawn <tool> ENOENT`. Built from the official upstream
# Go modules at pinned versions: `go install module@version` verifies each
# module (and every dependency) against the Go checksum database
# (sum.golang.org), so no binaries are downloaded from release URLs and
# nothing is piped into a shell. Same Debian release (bookworm) as the
# runtime stage, so naabu's cgo/libpcap link matches the runtime libpcap.
#
# Intentionally NOT installed: gowitness (needs a full Chromium) and
# whatweb (Ruby) — jobs that request those tools record a FAILED tool run.
FROM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS recon-tools
ARG SUBFINDER_VERSION=v2.16.0
ARG DNSX_VERSION=v1.3.1
ARG NAABU_VERSION=v2.6.1
ARG KATANA_VERSION=v1.8.0
# v4, not v5: AmassToolRunner calls the v4 CLI (`enum -passive -silent`).
ARG AMASS_VERSION=v4.2.0
ARG GAU_VERSION=v2.2.4
ARG WAYBACKURLS_VERSION=v0.1.0
ARG ASSETFINDER_VERSION=v0.1.1
RUN apt-get update \
  && apt-get install -y --no-install-recommends libpcap-dev \
  && rm -rf /var/lib/apt/lists/*
ENV GOBIN=/out GOFLAGS=-trimpath GOTOOLCHAIN=local CGO_ENABLED=0
RUN go install -ldflags="-s -w" github.com/projectdiscovery/subfinder/v2/cmd/subfinder@${SUBFINDER_VERSION} \
  && go install -ldflags="-s -w" github.com/projectdiscovery/dnsx/cmd/dnsx@${DNSX_VERSION} \
  && go install -ldflags="-s -w" github.com/projectdiscovery/katana/cmd/katana@${KATANA_VERSION} \
  && go install -ldflags="-s -w" github.com/owasp-amass/amass/v4/cmd/amass@${AMASS_VERSION} \
  && go install -ldflags="-s -w" github.com/lc/gau/v2/cmd/gau@${GAU_VERSION} \
  && go install -ldflags="-s -w" github.com/tomnomnom/waybackurls@${WAYBACKURLS_VERSION} \
  && go install -ldflags="-s -w" github.com/tomnomnom/assetfinder@${ASSETFINDER_VERSION}
# naabu links libpcap via cgo.
RUN CGO_ENABLED=1 go install -ldflags="-s -w" github.com/projectdiscovery/naabu/v2/cmd/naabu@${NAABU_VERSION}

# Pentest pipeline tools: httpx and nuclei from the official ProjectDiscovery
# GitHub releases, plus the nuclei template set at a pinned tag. Everything is
# verified with SHA256 before it is unpacked; a mismatch fails the build.
#
# The httpx/nuclei values are copied from the official release files
#   httpx_1.12.0_checksums.txt and nuclei_3.11.1_checksums.txt
# (the same file the upstream project publishes next to each release). The
# nuclei-templates archive has no upstream checksum file, so its SHA256 below
# was computed once from the v10.5.0 tag archive and is pinned here: the build
# fails if the archive ever changes.
#
# To update: pick the new release, copy its checksums for linux_amd64 and
# linux_arm64 into the ARGs below, recompute the templates archive hash, and
# run  docker build --target pd-tools  (see docs/operations/pentest-tools.md).
# TARGETARCH is set by BuildKit / buildx (compose uses BuildKit by default).
FROM debian:bookworm-slim AS pd-tools
ARG TARGETARCH
ARG HTTPX_VERSION=1.12.0
ARG NUCLEI_VERSION=3.11.1
ARG NUCLEI_TEMPLATES_VERSION=v10.5.0
ARG HTTPX_SHA256_AMD64=9d8439e8b6c9aa7d1e2314817a392e00d5178da3af5652f7475f88868f418f76
ARG HTTPX_SHA256_ARM64=fd7b123c1dfbc3d69f19f524e4eebcd6ec06b9a6cbd56813c76f11645197331e
ARG NUCLEI_SHA256_AMD64=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6
ARG NUCLEI_SHA256_ARM64=8044e3d9768ba0a744b2872c1a87e813006f013da97ca9f50f7661a4203bec07
ARG NUCLEI_TEMPLATES_SHA256=80fbabceca095fac40afecc7f023748df22b9576b9ff10a4422bd2fbf81f9a41
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip \
  && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
  case "${TARGETARCH}" in \
    amd64) httpx_sha="${HTTPX_SHA256_AMD64}"; nuclei_sha="${NUCLEI_SHA256_AMD64}" ;; \
    arm64) httpx_sha="${HTTPX_SHA256_ARM64}"; nuclei_sha="${NUCLEI_SHA256_ARM64}" ;; \
    *) echo "unsupported architecture: ${TARGETARCH:-unset} (build with BuildKit)" >&2; exit 1 ;; \
  esac; \
  mkdir -p /out/bin /out/nuclei-templates /tmp/dl; cd /tmp/dl; \
  curl -fsSL -o httpx.zip "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_${TARGETARCH}.zip"; \
  echo "${httpx_sha}  httpx.zip" | sha256sum -c -; \
  unzip -o -q httpx.zip httpx -d /out/bin; \
  curl -fsSL -o nuclei.zip "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_${TARGETARCH}.zip"; \
  echo "${nuclei_sha}  nuclei.zip" | sha256sum -c -; \
  unzip -o -q nuclei.zip nuclei -d /out/bin; \
  curl -fsSL -o templates.tar.gz "https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/${NUCLEI_TEMPLATES_VERSION}.tar.gz"; \
  echo "${NUCLEI_TEMPLATES_SHA256}  templates.tar.gz" | sha256sum -c -; \
  tar -xzf templates.tar.gz -C /out/nuclei-templates --strip-components=1; \
  chmod 0755 /out/bin/httpx /out/bin/nuclei; \
  rm -rf /tmp/dl

FROM base AS prod-deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/agent-sdk/package.json packages/agent-sdk/package.json
COPY packages/sdk-typescript/package.json packages/sdk-typescript/package.json
RUN pnpm install --prod --frozen-lockfile --filter api...

FROM node:25-bookworm-slim AS runtime
ENV NODE_ENV=production
# whois also backs AsnToolRunner (whois.cymru.com); netbase provides
# /etc/services, without which whois fails with "Servname not supported";
# libpcap0.8 is naabu's runtime library; ca-certificates for every tool's
# outbound HTTPS.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates netbase whois nmap libpcap0.8 \
  && rm -rf /var/lib/apt/lists/*
COPY --from=recon-tools /out/ /usr/local/bin/
# httpx and nuclei (verified releases) plus the pinned nuclei template set.
# Resolved through the VULN_TOOL_BIN_* variables, never from PATH. This image
# ships ProjectDiscovery's httpx, not Kali's Python `httpx` CLI, so recon
# uses the same binary instead of the `httpx-toolkit` default.
COPY --from=pd-tools /out/ /opt/secora-tools/
ENV VULN_TOOL_BIN_HTTPX=/opt/secora-tools/bin/httpx \
    VULN_TOOL_BIN_NUCLEI=/opt/secora-tools/bin/nuclei \
    RECON_TOOL_BIN_HTTPX=/opt/secora-tools/bin/httpx \
    VULN_NUCLEI_TEMPLATES_DIR=/opt/secora-tools/nuclei-templates
RUN groupadd --gid 1001 pentesthub && useradd --uid 1001 --gid pentesthub --shell /bin/bash --create-home pentesthub
WORKDIR /workspace
COPY --from=prod-deps /workspace/node_modules ./node_modules
COPY --from=prod-deps /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /workspace/packages/shared ./packages/shared
COPY --from=build /workspace/packages/agent-sdk ./packages/agent-sdk
COPY --from=build /workspace/packages/sdk-typescript ./packages/sdk-typescript
COPY --from=build /workspace/apps/api/dist ./apps/api/dist
COPY --from=build /workspace/apps/api/generated ./apps/api/generated
COPY --from=build /workspace/apps/api/prisma ./apps/api/prisma
COPY --from=build /workspace/apps/api/package.json ./apps/api/package.json
# Shared `api-storage` volume mount point — see apps/api/Dockerfile.
RUN mkdir -p apps/api/.storage && chown pentesthub:pentesthub apps/api/.storage
USER pentesthub
WORKDIR /workspace/apps/api
# Same fix as apps/api/Dockerfile's CMD — see that file's comment.
# worker.main.ts's boot log ("Worker starting (version ...)") reads
# npm_package_version too, and was logging 'unknown' for the identical
# reason (no npm/pnpm wrapper around a plain `node dist/...` CMD).
CMD ["sh", "-c", "export npm_package_version=$(node -p \"require('./package.json').version\") && exec node dist/src/worker.main.js"]
