# Local dev database — see docs/modules/01-auth.md "Local development database".
# Run `npx prisma dev --detach` then `npx prisma dev ls` for the connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/pentesthub?sslmode=disable"

NODE_ENV=development
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER_ME=30d

FRONTEND_URL=http://localhost:3001
MAIL_FROM="PentestHub AI <no-reply@pentesthub.local>"

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# OAuth is optional — leave unset to disable Google/GitHub login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback
