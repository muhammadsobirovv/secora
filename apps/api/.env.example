# Local dev database — see docs/modules/01-auth.md "Local development database".
# Run `npx prisma dev --detach` then `npx prisma dev ls` for the connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/pentesthub?sslmode=disable"

NODE_ENV=development
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER_ME=30d

FRONTEND_URL=http://localhost:3001
MAIL_FROM="PentestHub AI <no-reply@pentesthub.local>"

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# OAuth is optional — leave unset to disable Google/GitHub login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback

# Recon worker — all optional, shown here with their defaults. Read by both
# the API process and the separate worker process (`worker.main.ts`).
# RECON_WORKER_CONCURRENCY=3
# RECON_WORKER_POLL_INTERVAL_MS=2000
# RECON_JOB_TIMEOUT_SECONDS=600
# RECON_JOB_MAX_RETRIES=2
# RECON_JOB_RETRY_BASE_DELAY_MS=5000
# RECON_JOB_RETRY_MAX_DELAY_MS=120000
# RECON_JOB_LOG_SSE_POLL_INTERVAL_MS=1000
# RECON_WORKER_ORPHAN_SWEEP_INTERVAL_MS=60000
#
# Tool binary names — override if a tool installs under a different name.
# Kali packages ProjectDiscovery's httpx as `httpx-toolkit` specifically
# because plain `httpx` on PATH is Python's unrelated HTTP client CLI.
# RECON_TOOL_BIN_NMAP=nmap
# RECON_TOOL_BIN_SUBFINDER=subfinder
# RECON_TOOL_BIN_HTTPX=httpx-toolkit
# RECON_TOOL_BIN_DNSX=dnsx
# RECON_TOOL_BIN_NAABU=naabu
# RECON_TOOL_BIN_WHATWEB=whatweb
# RECON_TOOL_BIN_ASSETFINDER=assetfinder
# RECON_TOOL_BIN_GOWITNESS=gowitness
# RECON_TOOL_BIN_AMASS=amass
# RECON_TOOL_BIN_KATANA=katana
# RECON_TOOL_BIN_GAU=gau
# RECON_TOOL_BIN_WAYBACKURLS=waybackurls
# RECON_TOOL_BIN_WHOIS=whois
# RECON_TOOL_ASN_WHOIS_HOST=whois.cymru.com
