# =============================================================================
# PentestHub AI — apps/api environment configuration
#
# Every variable below is validated at process startup by
# apps/api/src/config/env.validation.ts (Zod schema, `validateEnv`), wired
# into ConfigModule.forRoot({ validate: validateEnv }) in both app.module.ts
# (API process) and worker.module.ts (worker process). An invalid or missing
# *required* variable fails boot immediately with a clear multi-line error
# listing every offending field — never a confusing runtime error later.
#
# This file is organized into the categories Module 18 Phase 1 (Production
# Configuration) requires: DATABASE, AUTH, OAUTH, AI, STORAGE, REDIS/QUEUE,
# SECURITY, RATE LIMITING, OBSERVABILITY, EMAIL, THREAT INTELLIGENCE,
# FEATURE FLAGS, DEPLOYMENT. It intentionally mirrors env.validation.ts
# field-for-field (task #503) — if you add/remove a variable there, update
# this file and packages/cli/.env.example / apps/web/.env.example as needed
# in the same change.
#
# Uncommented lines below are REQUIRED (no default — the app will not boot
# without them, or without you deliberately choosing to leave a secret-typed
# optional field unset). Commented (#) lines show every OPTIONAL variable at
# its schema default; uncomment and change only what you need to override.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local dev database — see docs/modules/01-auth.md "Local development database".
# Run `npx prisma dev --detach` then `npx prisma dev ls` for the connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/pentesthub?sslmode=disable"

# `pg` connection pool max size PER API PROCESS (PrismaService -> PrismaPg ->
# node-postgres Pool). Total connections across a deployment = replicas *
# this value, which must stay under Postgres's own max_connections. Size as
# roughly max_connections / replica_count once replica count is known.
# DATABASE_POOL_MAX=10

# Read-replica routing (Module 14) is opt-in — unset means every query goes
# to DATABASE_URL, correct for Community Edition's single-Postgres install.
# Set to route read-only QueryBus handlers (via PrismaService.replica()) to
# a separate connection pool.
# DATABASE_READ_REPLICA_URL=
# DATABASE_READ_REPLICA_POOL_MAX=10

# -----------------------------------------------------------------------------
# CORE / DEPLOYMENT
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Extra origins CORS should accept, on top of FRONTEND_URL — comma-separated,
# no spaces needed (trimmed either way). Use this when the web app is served
# from more than one domain at once, e.g. a bare apex domain in addition to
# an `app.` subdomain. Leave unset for a normal single-domain deployment.
# CORS_ADDITIONAL_ORIGINS=https://secora.group,https://www.secora.group

# Reverse-proxy hop count (nginx, ALB, Cloudflare, ...) in front of this app.
# 0 (default) = no proxy, trust req.ip as-is — correct for local dev. Set to
# the exact hop count in any proxied deployment so Express's `trust proxy`
# reads the real client IP from X-Forwarded-For at the right position.
# Every audit-logged IP and throttle-guard IP counter depends on this.
# TRUST_PROXY_HOPS=0

# Purely informational (surfaced on the liveness endpoint + Admin Console).
# stable = tagged vX.Y.Z release, beta = vX.Y.Z-beta.N pre-release, nightly =
# operator-built image off main. See docs/architecture/release-engineering.md.
# RELEASE_CHANNEL=stable

# EditionService's single source of truth for Enterprise-only surfaces
# (tenant billing/branding, custom domains). `community` (default) never
# accidentally boots into a gated mode on a fresh clone.
# PENTESTHUB_EDITION=community

# -----------------------------------------------------------------------------
# AUTH (JWT / sessions / account lockout)
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER_ME=30d

# Local-First Migration Phase 1 (BYOK) — encrypts each workspace's own AI
# provider API key (AES-256-GCM) at rest. Generate with the same command as
# above; do not reuse JWT_ACCESS_SECRET's value.
CREDENTIAL_ENCRYPTION_KEY=

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# OAUTH (optional — leave unset to disable Google/GitHub login)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback

# Module 10 native integrations (GitHub/GitLab/Slack/Discord/MS Teams/Google/
# Dropbox/Notion) — the *platform's own* OAuth app credentials for the
# "Connect with X" authorization-code flow. Every provider optional (BYOK-
# style); unset = that provider's OAuth flow unavailable, but token-based
# (PAT) connection still works for providers that support it.
# INTEGRATION_GITHUB_CLIENT_ID=
# INTEGRATION_GITHUB_CLIENT_SECRET=
# INTEGRATION_GITLAB_CLIENT_ID=
# INTEGRATION_GITLAB_CLIENT_SECRET=
# INTEGRATION_SLACK_CLIENT_ID=
# INTEGRATION_SLACK_CLIENT_SECRET=
# INTEGRATION_DISCORD_CLIENT_ID=
# INTEGRATION_DISCORD_CLIENT_SECRET=
# INTEGRATION_MS_TEAMS_CLIENT_ID=
# INTEGRATION_MS_TEAMS_CLIENT_SECRET=
# INTEGRATION_GOOGLE_CLIENT_ID=
# INTEGRATION_GOOGLE_CLIENT_SECRET=
# INTEGRATION_DROPBOX_CLIENT_ID=
# INTEGRATION_DROPBOX_CLIENT_SECRET=
# INTEGRATION_NOTION_CLIENT_ID=
# INTEGRATION_NOTION_CLIENT_SECRET=
# INTEGRATION_CALLBACK_BASE_URL=

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
MAIL_FROM="PentestHub AI <no-reply@pentesthub.local>"
# "dev" (default) needs nothing — mail is logged and written to
# .mail-outbox/. Set MAIL_PROVIDER=smtp and SMTP_HOST to send real mail
# through any SMTP relay (self-hosted Postfix, MailHog for local dev, or a
# paid SendGrid/SES/Postmark SMTP endpoint).
MAIL_PROVIDER=dev
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Where POST /support/tickets forwards a notification email for an operator
# to triage (no deployment-wide "platform admin" role to gate an in-app
# surface behind — email is the honest choice, same posture as SECURITY.md's
# security-report inbox).
# SUPPORT_INBOX_EMAIL=support@pentesthub.ai

# -----------------------------------------------------------------------------
# AI PROVIDERS (Module 5 — AI Security Copilot)
# -----------------------------------------------------------------------------
# Every provider key below is optional by design — the app boots and the
# provider registry reports each provider's `configured` status via
# GET /ai/providers without any of these being set; only actually sending a
# message through an unconfigured provider fails, with a clear error.
# AI_DEFAULT_PROVIDER=ANTHROPIC   # OPENAI | ANTHROPIC | GEMINI | OLLAMA | OPENROUTER

# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=gpt-4o
# AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI_ANTHROPIC_API_KEY=
# AI_ANTHROPIC_MODEL=claude-sonnet-4-5

# AI_GEMINI_API_KEY=
# AI_GEMINI_MODEL=gemini-2.0-flash

# Ollama is local — no API key, just a reachable base URL. Left unset by
# default so "is Ollama configured" means "the operator deliberately pointed
# us at a local server", not every install silently trying localhost:11434.
# AI_OLLAMA_BASE_URL=
# AI_OLLAMA_MODEL=llama3.1

# AI_OPENROUTER_API_KEY=
# AI_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# RAG tuning. AI_EMBEDDING_DIMENSIONS must match the vector(1536) column
# width in ai_memory_chunks (schema.prisma) — changing to a different
# dimension count requires a migration, not just a config change.
# AI_EMBEDDING_DIMENSIONS=1536
# AI_MEMORY_CHUNK_SIZE=800
# AI_MEMORY_CHUNK_OVERLAP=120
# AI_MEMORY_SEARCH_TOP_K=8
# AI_MEMORY_DEFAULT_TTL_DAYS=0

# AI_CHAT_STREAM_MAX_TOKENS=4096
# AI_CHAT_RATE_LIMIT_PER_MINUTE=20

# Voice Interaction (Module 5 Phase 2). WEB_SPEECH needs no key. OPENAI_SPEECH
# reuses AI_OPENAI_API_KEY (Whisper + TTS = same OpenAI account as chat).
# AI_SPEECH_AZURE_API_KEY=
# AI_SPEECH_AZURE_REGION=
# AI_SPEECH_GOOGLE_API_KEY=
# AI_SPEECH_ELEVENLABS_API_KEY=
# AI_SPEECH_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Module 11 — Autonomous Multi-Agent System orchestrator defaults. Per-
# workspace provider selection lives in data (BYOK credentials), not env —
# this is only the fallback mode when a workspace hasn't chosen one.
# AI_ORCHESTRATOR_MODE=CLOUD   # CLOUD | LOCAL | HYBRID
# AI_ORCHESTRATOR_MAX_CONCURRENT_TASKS=3
# AI_ORCHESTRATOR_MAX_TASK_DEPTH=4
# AI_ORCHESTRATOR_MAX_TASK_RETRIES=2
# AI_ORCHESTRATOR_TASK_TIMEOUT_MS=120000

# Module 13 — MCP Ecosystem + Script Engine. MCP server off by default so an
# operator opts into exposing it rather than it appearing on upgrade. Python
# scripts are stored but rejected at execution time unless explicitly enabled
# (this process has no Python interpreter to shell out to by default).
# MCP_SERVER_ENABLED=false
# MCP_SESSION_IDLE_TIMEOUT_MINUTES=60
# SCRIPT_ENGINE_TIMEOUT_MS=5000
# SCRIPT_ENGINE_PYTHON_ENABLED=false

# -----------------------------------------------------------------------------
# STORAGE (object storage abstraction, STORAGE_SERVICE token)
# -----------------------------------------------------------------------------
# `local` (default, LocalDiskStorageService) needs no configuration — a
# Docker volume is enough for Community Edition. `s3` covers AWS S3, MinIO
# (self-hosted, still free), and Cloudflare R2/any S3-compatible endpoint.
# STORAGE_PROVIDER=local
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# REDIS / QUEUE / CACHE
# -----------------------------------------------------------------------------
# `memory` (default) is a real, fully-functional single-process queue —
# correct for Community Edition's single-container deployment. `redis` is
# for multi-replica deployments where more than one API/worker process needs
# to observe the same queue; requires REDIS_URL.
# QUEUE_PROVIDER=memory
# REDIS_URL=
# QUEUE_REDIS_KEY_PREFIX=pentesthub:queue:
# QUEUE_DEFAULT_MAX_ATTEMPTS=5
# QUEUE_DEFAULT_RETRY_BASE_DELAY_MS=2000

# `memory` (default) is a real in-process TTL cache — correct for a single-
# replica install. `redis` is for multi-replica deployments needing a shared
# cache; `disk` trades memory for filesystem-backed cache survival across
# restarts.
# CACHE_PROVIDER=memory
# CACHE_DISK_DIR=.cache
# CACHE_DEFAULT_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Comma-separated CIDR blocks/exact IPs (optional, empty = disabled). Checked
# after TRUST_PROXY_HOPS resolves the real client IP.
# IP_ALLOWLIST=

# Mutual TLS is terminated by the reverse proxy/ingress (nginx/Traefik/cloud
# LB), never by this Node process — this flag only controls whether the API
# *requires* the proxy-forwarded verified-client-cert header to be present.
# MTLS_REQUIRED=false
# MTLS_CLIENT_CERT_VERIFY_HEADER=X-Client-Cert-Verify

# Module 14 Tenant Management (Enterprise Edition) — shared secret
# BillingWebhookController requires before trusting an inbound billing event.
# Unset (default) = the webhook endpoint rejects every request; there is
# deliberately no "accept billing webhooks with no secret" mode.
# BILLING_WEBHOOK_SECRET=

# Backup System / Disaster Recovery encryption key (AES-256-GCM, same
# posture as CREDENTIAL_ENCRYPTION_KEY). Optional here — required at the
# service layer the moment any BackupPolicy has encrypt=true (the default).
# BACKUP_ENCRYPTION_KEY=
# BACKUP_PG_DUMP_BIN=pg_dump
# BACKUP_PG_RESTORE_BIN=pg_restore
# BACKUP_VERIFICATION_POLL_INTERVAL_MS=3600000

# Module 16 — Terminal workspace safe command execution.
# TERMINAL_COMMAND_TIMEOUT_SECONDS=120

# Module 16 — Approval gates. How long an unanswered SecurityApprovalRequest
# stays PENDING before it's marked EXPIRED (fails closed, never open).
# SECURITY_APPROVAL_DEFAULT_EXPIRY_MINUTES=60

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# (Global request throttling is configured via the ThrottlerModule directly
# in code, not env — see @Throttle() decorators throughout the controllers.
# The AI chat endpoint has its own, tighter budget below since a single AI
# turn is far more expensive — provider $ + latency — than a typical CRUD
# request.)
# AI_CHAT_RATE_LIMIT_PER_MINUTE=20   # (duplicated here for discoverability — same key as the AI section above)

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
# LOG_LEVEL=info      # fatal | error | warn | info | debug | trace
# LOG_FORMAT=json      # json | pretty
# SLOW_QUERY_THRESHOLD_MS=500

# OTLP collector endpoint for distributed tracing. Unset = tracing
# initializes with a no-op exporter (spans created but not shipped anywhere)
# — intentional for local dev/sandbox environments with no collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Module 15 — Telemetry (task #347). Opt-in, never required for core
# functionality. Unset/false = send nothing.
# TELEMETRY_ENABLED=false
# TELEMETRY_ENDPOINT=

# -----------------------------------------------------------------------------
# THREAT INTELLIGENCE / CVE (Modules 16-17)
# -----------------------------------------------------------------------------
# `none` (default) means CveIntelligenceService only ever reads its local
# cache — no external network call, no API key required (Community Edition
# guarantee). Every named provider is a free, publicly documented feed.
# CVE_INTELLIGENCE_PROVIDER=none   # none | nvd | cisa_kev | osv | github_advisories | vendor
# CVE_INTELLIGENCE_REFRESH_INTERVAL_HOURS=24
# NVD_API_KEY=
# CVE_INTELLIGENCE_VENDOR_URL=

# SECURITY_NEWS_PROVIDER=none   # none | rss
# SECURITY_NEWS_FEED_URLS=

# Module 17 — Threat Intelligence Engine. Same Community Edition guarantee:
# `none` (default) = ThreatIntelligenceService only reads/writes the local
# cache, no outbound call, no key required.
# THREAT_INTEL_PROVIDER=none   # none | cisa_kev | nvd | osv | github_advisories | stix_taxii | vendor
# THREAT_INTEL_REFRESH_INTERVAL_HOURS=24
# THREAT_INTEL_TAXII_SERVER_URL=
# THREAT_INTEL_TAXII_COLLECTION_ID=
# THREAT_INTEL_TAXII_API_KEY=
# THREAT_INTEL_VENDOR_URL=
# THREAT_INTEL_MAX_INDICATORS_PER_IMPORT=1000

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Disabled by default (REST remains the primary, documented API surface).
# GRAPHQL_PLAYGROUND_ENABLED=false

# Module 10 Plugin Marketplace — PEM-encoded Ed25519 SPKI public key plugin-
# version signatures are verified against. Unset = verification is attempted
# but always reported unverifiable (a plugin can still be installed unsigned,
# just never carries a `verified: true` badge).
# PLUGIN_MARKETPLACE_PUBLIC_KEY=

# Module 15 — first-run onboarding + demo mode.
# DEMO_MODE_ENABLED=false
# DEMO_SESSION_TTL_HOURS=24

# Auto Update / version manifest (desktop, CLI, mobile). Every field
# optional — unset = no enforced minimum-version floor.
# AUTO_UPDATE_DESKTOP_LATEST_VERSION=
# AUTO_UPDATE_DESKTOP_MIN_VERSION=
# AUTO_UPDATE_CLI_LATEST_VERSION=
# AUTO_UPDATE_CLI_MIN_VERSION=
# AUTO_UPDATE_MOBILE_LATEST_VERSION=
# AUTO_UPDATE_MOBILE_MIN_VERSION=

# Module 15 — Monetization. `none` (default) is the Community Edition state:
# BillingService still creates a real Subscription row pinned to
# PlanTier.FREE, it just never calls out to a payment provider.
# BILLING_PROVIDER=none   # none | stripe | manual
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# RECON WORKER (Module 3) — all optional, shown at their defaults. Read by
# both the API process and the separate worker process (worker.main.ts).
# -----------------------------------------------------------------------------
# RECON_WORKER_CONCURRENCY=3
# RECON_WORKER_POLL_INTERVAL_MS=2000
# RECON_JOB_TIMEOUT_SECONDS=600
# RECON_JOB_MAX_RETRIES=2
# RECON_JOB_RETRY_BASE_DELAY_MS=5000
# RECON_JOB_RETRY_MAX_DELAY_MS=120000
# RECON_JOB_LOG_SSE_POLL_INTERVAL_MS=1000
# RECON_WORKER_ORPHAN_SWEEP_INTERVAL_MS=60000
#
# Tool binary names — override if a tool installs under a different name.
# Kali packages ProjectDiscovery's httpx as `httpx-toolkit` specifically
# because plain `httpx` on PATH is Python's unrelated HTTP client CLI.
# RECON_TOOL_BIN_NMAP=nmap
# RECON_TOOL_BIN_SUBFINDER=subfinder
# RECON_TOOL_BIN_HTTPX=httpx-toolkit
# RECON_TOOL_BIN_DNSX=dnsx
# RECON_TOOL_BIN_NAABU=naabu
# RECON_TOOL_BIN_WHATWEB=whatweb
# RECON_TOOL_BIN_ASSETFINDER=assetfinder
# RECON_TOOL_BIN_GOWITNESS=gowitness
# RECON_TOOL_BIN_AMASS=amass
# RECON_TOOL_BIN_KATANA=katana
# RECON_TOOL_BIN_GAU=gau
# RECON_TOOL_BIN_WAYBACKURLS=waybackurls
# RECON_TOOL_BIN_WHOIS=whois
# RECON_TOOL_ASN_WHOIS_HOST=whois.cymru.com

# -----------------------------------------------------------------------------
# VULNERABILITY WORKER (Module 4) — mirrors RECON_WORKER_* field-for-field,
# plus heartbeat (dead-worker detection), which Module 3 didn't need.
# -----------------------------------------------------------------------------
# VULN_WORKER_CONCURRENCY=2
# VULN_WORKER_POLL_INTERVAL_MS=2000
# VULN_JOB_TIMEOUT_SECONDS=1800
# VULN_JOB_MAX_RETRIES=2
# VULN_JOB_RETRY_BASE_DELAY_MS=5000
# VULN_JOB_RETRY_MAX_DELAY_MS=120000
# VULN_JOB_LOG_SSE_POLL_INTERVAL_MS=1000
# A RUNNING job whose lastHeartbeatAt is older than now minus this interval is
# considered orphaned (its worker died mid-job). Must be comfortably larger
# than VULN_WORKER_HEARTBEAT_INTERVAL_MS so a slow GC pause doesn't
# false-positive a live worker as dead.
# VULN_WORKER_HEARTBEAT_INTERVAL_MS=15000
# VULN_WORKER_HEARTBEAT_TIMEOUT_MS=60000
#
# Tool binary names — same rationale as RECON_TOOL_BIN_* above.
# VULN_TOOL_BIN_NUCLEI=nuclei
# VULN_TOOL_BIN_FFUF=ffuf
# VULN_TOOL_BIN_DIRSEARCH=dirsearch
# VULN_TOOL_BIN_FEROXBUSTER=feroxbuster
# VULN_TOOL_BIN_NIKTO=nikto
# Wordlist path for content-discovery fuzzers that need one supplied
# explicitly. Default matches the common SecLists install path on Kali.
# VULN_TOOL_WORDLIST_FFUF=/usr/share/seclists/Discovery/Web-Content/common.txt

# -----------------------------------------------------------------------------
# BUG BOUNTY WORKSPACE (Module 6)
# -----------------------------------------------------------------------------
# Duplicate Detection reuses the AI module's embedding pipeline — this
# threshold is the only Module-6-specific similarity knob.
# BUGBOUNTY_DUPLICATE_SIMILARITY_THRESHOLD=0.75
# BUGBOUNTY_DEFAULT_CURRENCY=USD
# BUGBOUNTY_DEADLINE_LOOKAHEAD_HOURS=48
# BUGBOUNTY_DEADLINE_POLL_INTERVAL_MS=300000

# -----------------------------------------------------------------------------
# DISTRIBUTED JOB SYSTEM (Module 10 — dead-worker recovery)
# -----------------------------------------------------------------------------
# A WorkerNode whose lastHeartbeatAt is older than WORKER_HEARTBEAT_STALE_MS
# is marked UNHEALTHY and any DistributedJob still RUNNING on it is migrated
# back to QUEUED, swept every WORKER_REAPER_POLL_INTERVAL_MS.
# WORKER_HEARTBEAT_STALE_MS=90000
# WORKER_REAPER_POLL_INTERVAL_MS=30000
