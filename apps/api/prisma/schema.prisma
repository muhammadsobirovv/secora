// --- Automation engine (visual workflow builder) --------------------------------

enum WorkflowTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// `definitionJson` is the serialized step graph a visual builder would
/// produce: an ordered/branching list of steps, each with a `kind`
/// (recon/scan/report/notify/ai-analysis/create-ticket/sync-data/condition/
/// loop/delay), `params`, and `next` pointers — interpreted by
/// `automation-engine/workflow-executor.service.ts`. Kept as one JSON
/// column rather than a normalized step table so the schema never needs a
/// migration when a new step kind is added; validity is enforced in code
/// (`workflow-definition.schema.ts`, a Zod/class-validator shape), not the
/// database.
model Workflow {
  id             String              @id @default(uuid())
  organizationId String?
  workspaceId    String?
  name           String
  description    String?
  definitionJson Json
  triggerType    WorkflowTriggerType @default(MANUAL)
  cronExpression String?
  // Module 10 addition — only meaningful when triggerType is SCHEDULE;
  // computed the same way ScheduledJob.nextRunAt is (via
  // automation/scheduled-job-cron.util.ts's computeNextRunAt), and
  // polled by WorkflowRunnerService the same way
  // ScheduledJobRunnerService polls ScheduledJob.nextRunAt.
  nextRunAt      DateTime?
  enabled        Boolean             @default(true)
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]

  @@index([organizationId, enabled])
  @@index([triggerType, enabled, nextRunAt])
  // Module 18 — task #508 (database reliability review). Workspace-scoped
  // workflow listings (a workspace without an organizationId) had no
  // covering index.
  @@index([workspaceId, enabled])
  @@map("workflows")
}

model WorkflowRun {
  id          String            @id @default(uuid())
  workflowId  String
  status      WorkflowRunStatus @default(PENDING)
  triggeredBy String?
  input       Json?
  output      Json?
  error       String?
  // Module 10 additions — support pausing mid-execution at a `delay`
  // step and resuming on a later WorkflowRunnerService tick, rather than
  // blocking a request thread on an in-process sleep. `contextJson`
  // accumulates each step's output (keyed by stepKey) as the run
  // progresses, so a step can reference an earlier step's result (see
  // workflow-executor.service.ts's `resolveTemplate`), and survives a
  // pause/resume cycle since it's persisted between ticks.
  contextJson     Json?
  pausedAtStepKey String?
  resumeAt        DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime          @default(now())

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    WorkflowStepLog[]

  @@index([workflowId, status])
  @@index([status, resumeAt])
  @@map("workflow_runs")
}

model WorkflowStepLog {
  id            String    @id @default(uuid())
  workflowRunId String
  stepKey       String
  status        String
  message       String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@map("workflow_step_logs")
}

// Module 10 — High Availability. A row-level distributed lease used by
// every setInterval-based poller service (WebhookDeliveryQueueService,
// WorkflowRunnerService, ScheduledJobRunnerService,
// ReportScheduleRunnerService, DataRetentionEnforcerService,
// BackupPolicyRunnerService, ComplianceExportProcessorService) so that
// running N replicas of the API process no longer risks double-running
// a single tick (previously each of those services' doc comments
// flagged this as an unimplemented "pin to a single replica" caveat —
// PollerLeaseService/this table resolves it). `id` is the lease name
// (e.g. "webhook-delivery-queue"); a replica only proceeds with its
// tick if a conditional `UPDATE ... WHERE id = ? AND (expiresAt < now()
// OR holderId = ?)` affects a row — see
// apps/api/src/common/concurrency/poller-lease.service.ts for the full
// compare-and-swap implementation and why this table-based lease was
// chosen over a Postgres advisory lock (avoids holding a long-lived
// transaction/connection open for the full duration of a tick that may
// itself make outbound HTTP/AI calls).
model PollerLease {
  id         String   @id
  holderId   String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@map("poller_leases")
}

// ---------------------------------------------------------------------------
// Module 11 — AI Security Copilot + Autonomous Multi-Agent System
// see docs/adr/0011-ai-security-copilot-multi-agent-system.md
//
// Integrates with, never duplicates, Modules 1-10: agents call into the
// existing Recon/Vuln/BugBounty domain services and the Module 5 AI
// provider/tool-calling/RAG infrastructure rather than re-implementing any
// of it. The only genuinely new state this module introduces is
// orchestration bookkeeping (OrchestrationRun/AgentTask/
// AgentToolCallLog — "what did the multi-agent system do and why"),
// the structured knowledge-base index (KnowledgeBaseReferenceEntry — the
// canonical OWASP/CWE/CAPEC/MITRE/NIST/CVE catalog, which is then ALSO fed
// into the existing AiMemoryChunk RAG store as KNOWLEDGE_BASE_REFERENCE
// chunks for semantic search, same one-index policy as Module 6), and
// PromptTemplate (the AI Chat "prompt library"). Conversation branching and
// memory expiration are additive columns on AiMessage/AiMemoryChunk above,
// not new tables.
// ---------------------------------------------------------------------------

/// The 12 specialist agents the Master Orchestrator can delegate a subtask
/// to. Each maps to one class implementing the `Agent` interface in
/// `modules/agents/framework/agent.interface.ts` — this enum is the
/// contract between the persisted AgentTask row and which in-process class
/// picks it up (AgentRegistryService keys its Map by this enum, exactly
/// like AiToolRegistryService keys by AiToolName).
enum AgentType {
  RECON
  WEB
  API
  MOBILE
  CLOUD
  ACTIVE_DIRECTORY
  AI_RESEARCH
  EXPLOIT_ANALYSIS
  REPORT_WRITER
  CODE_REVIEW
  RISK_ASSESSMENT
  WORKFLOW_COORDINATOR
}

enum OrchestrationRunStatus {
  PENDING
  PLANNING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

/// One user goal handed to the Master AI Orchestrator ("scan example.com
/// for auth bypass issues and draft a report"). `planJson` is the
/// decomposition the Reasoning Engine produced (an ordered/graph list of
/// subtasks with the AgentType each is assigned to) — persisted so a
/// paused/failed run can resume from its plan instead of re-planning, and
/// so the frontend orchestration dashboard can render the plan before
/// every task has executed. `resultSummary`/`confidenceScore` are the
/// orchestrator's final merged-output explanation (Explainability).
model OrchestrationRun {
  id              String                 @id @default(uuid())
  workspaceId     String
  projectId       String?
  userId          String
  goal            String
  status          OrchestrationRunStatus @default(PENDING)
  planJson        Json?
  resultSummary   String?
  confidenceScore Float?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     AgentTask[]

  @@index([workspaceId, projectId])
  @@index([userId, createdAt])
  @@map("orchestration_runs")
}

/// One subtask within an OrchestrationRun, assigned to one agent.
/// `parentTaskId` models delegation (Multi-Agent Architecture: "Support
/// delegation") — an agent that decides part of its work belongs to
/// another specialist creates a child AgentTask rather than doing it
/// itself; `subTasks` is the reverse of that self-relation. `status`
/// RETRYING + `retryCount` back the orchestrator's "retry failed tasks"
/// responsibility. `reasoningSummary`/`confidenceScore`/`sources`
/// (Explainability: every AI decision includes reasoning, confidence,
/// sources) are populated by the Reasoning Engine alongside `output`.
model AgentTask {
  id                 String          @id @default(uuid())
  orchestrationRunId String
  parentTaskId       String?
  agentType          AgentType
  title              String
  input              Json?
  output             Json?
  status             AgentTaskStatus @default(QUEUED)
  reasoningSummary   String?
  confidenceScore    Float?
  sources            Json?
  errorMessage       String?
  retryCount         Int             @default(0)
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  orchestrationRun OrchestrationRun   @relation(fields: [orchestrationRunId], references: [id], onDelete: Cascade)
  parentTask       AgentTask?         @relation("AgentTaskDelegation", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks         AgentTask[]        @relation("AgentTaskDelegation")
  toolCalls        AgentToolCallLog[]

  @@index([orchestrationRunId, status])
  @@index([parentTaskId])
  @@map("agent_tasks")
}

/// Same shape and purpose as AiToolCallLog (Module 5), scoped to an
/// AgentTask instead of a chat AiMessage — kept as a separate model
/// rather than making AiToolCallLog.conversationId nullable + adding an
/// agentTaskId column, since that would touch an existing, already-shipped
/// table's required-field contract for a Module 11-only need. Both tables
/// feed the same "AI Tool Calling" audit-trail concept via the AiToolName
/// values in packages/shared/src/ai.ts.
model AgentToolCallLog {
  id           String   @id @default(uuid())
  agentTaskId  String
  toolName     String
  input        Json
  output       Json?
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  agentTask AgentTask @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@index([agentTaskId, createdAt])
  @@map("agent_tool_call_logs")
}

enum KnowledgeBaseReferenceFramework {
  OWASP
  CWE
  CAPEC
  MITRE_ATTACK
  NIST
  CVE
}

/// The canonical AI Knowledge Base catalog (OWASP Top 10 / CWE / CAPEC /
/// MITRE ATT&CK / NIST controls / CVE records) — structured, exact-match
/// lookups by `code` (e.g. "CWE-89", "T1190"), distinct from the
/// workspace-authored `KnowledgeBaseNote` (Module 9: user notes/
/// playbooks/cheat sheets). Every row is also indexed into AiMemoryChunk
/// (sourceType=KNOWLEDGE_BASE_REFERENCE) by KnowledgeBaseIndexerService so
/// semantic search ("what CWE covers this bug") and exact lookup ("show me
/// CWE-89") both work off one source of truth. Workspace-independent
/// (reference data is the same for every tenant), unlike KnowledgeBaseNote.
model KnowledgeBaseReferenceEntry {
  id        String                          @id @default(uuid())
  framework KnowledgeBaseReferenceFramework
  code      String
  title     String
  summary   String
  url       String?
  metadata  Json?
  createdAt DateTime                        @default(now())
  updatedAt DateTime                        @updatedAt

  @@unique([framework, code])
  @@index([framework])
  @@map("knowledge_base_reference_entries")
}

/// AI Chat "prompt library" / conversation templates (AI Chat spec
/// section). A saved, reusable prompt a user can insert into a new
/// conversation — workspace-scoped (shared with teammates), not per-user,
/// matching KnowledgeBaseNote's workspace-wide sharing model rather than
/// AiConversation's per-user ownership.
model PromptTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  promptText  String
  category    String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])

  @@index([workspaceId, category])
  @@map("prompt_templates")
}

/// Module 11 — Privacy controls (task #234): per-workspace AI privacy mode,
/// overriding the operator-level AI_ORCHESTRATOR_MODE env default. Kept as
/// its own table rather than folded into WorkspaceSettings (Module 2) —
/// that table already has full generated Prisma Client support in this
/// sandbox, and this table, like every other Module 11 addition, is only
/// reachable via the raw-SQL repository pattern (no `prisma generate`
/// re-run is possible here). Deliberately has no `workspace Workspace
/// @relation(...)` field / back-relation array on Workspace — raw-SQL-only
/// access never needs Prisma relation loading, so skipping the relation
/// avoids touching the already-shipped Workspace model at all.
enum AiPrivacyMode {
  CLOUD
  LOCAL
  HYBRID
}

model WorkspaceAiPrivacySetting {
  workspaceId String        @id
  mode        AiPrivacyMode @default(CLOUD)
  // Module 15 — Local-first AI confirmation (task #341). Null until the
  // workspace has explicitly confirmed CLOUD/HYBRID usage at least once —
  // see AiPrivacyModeService.setMode and AiCloudUsageNotConfirmedError.
  cloudUsageConfirmedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("workspace_ai_privacy_settings")
}

// ============================================================
// Module 13 — AI Automation Platform + MCP Ecosystem + Security Agent
// SDK. Every model below follows Module 11's precedent: no `prisma
// generate`/`migrate` re-run could complete in this authoring sandbox
// (see docs/adr/0013-ai-automation-platform-mcp-ecosystem.md's
// Toolchain section), so every repository touching these tables uses
// the raw-SQL ($queryRaw/$executeRaw) pattern
// apps/api/src/modules/agent/infrastructure/persistence/prisma already
// established, and none of these models add a `@relation(...)`
// back-reference on an existing model (Workspace/Organization/User) —
// avoids touching any already-shipped model's generated Prisma Client
// shape at all.
// ============================================================

enum McpSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

/// One live MCP client connection (an external MCP-compatible AI
/// application, or PentestHub's own CLI/frontend acting as a client of
/// its own MCP server), created by `mcp/mcp-server.module.ts`'s
/// `initialize` handler. `protocolVersion` is the negotiated MCP
/// protocol date-version string; `capabilitiesJson` mirrors what the
/// client declared (resources/tools/prompts/sampling support) so the
/// server never offers a capability the client didn't ask for.
/// Authenticated the same way the rest of the Public API is
/// (`ApiKeyAuthGuard`, Module 9) for the HTTP+SSE transport —
/// `apiKeyId`/`scopes` are null/empty only for the stdio transport,
/// which authenticates via local process trust instead (see the MCP
/// Guide's "Transports" section).
model McpSession {
  id               String           @id @default(uuid())
  workspaceId      String
  apiKeyId         String?
  clientName       String
  clientVersion    String?
  protocolVersion  String
  transport        String
  status           McpSessionStatus @default(ACTIVE)
  capabilitiesJson Json?
  scopes           String[]
  createdAt        DateTime         @default(now())
  lastActiveAt     DateTime         @default(now())
  closedAt         DateTime?

  @@index([workspaceId, status])
  @@index([apiKeyId])
  @@map("mcp_sessions")
}

/// One MCP `tools/call` invocation — the Tool Usage half of the
/// Observability spec section, and the raw material the AI Evaluation
/// service's Tool Success Rate metric aggregates over.
model McpToolInvocation {
  id           String   @id @default(uuid())
  sessionId    String
  workspaceId  String
  toolName     String
  inputJson    Json?
  outputJson   Json?
  errorMessage String?
  durationMs   Int
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([workspaceId, toolName, createdAt])
  @@map("mcp_tool_invocations")
}

/// Prompt Registry versioning (task #280). `PromptTemplate` (Module 11)
/// already holds the *current* prompt text/name/category; this table is
/// its append-only edit history — one row per save — so a prompt can be
/// rolled back and so `PromptTestRun` rows can pin exactly which version
/// they exercised.
model PromptTemplateVersion {
  id                String   @id @default(uuid())
  promptTemplateId  String
  version           Int
  promptText        String
  variablesJson     Json?
  changelog         String?
  createdBy         String
  createdAt         DateTime @default(now())

  @@unique([promptTemplateId, version])
  @@index([promptTemplateId])
  @@map("prompt_template_versions")
}

enum PromptTestRunStatus {
  SUCCEEDED
  FAILED
}

/// Prompt Testing / Prompt History (task #280): one ad-hoc "run this
/// prompt version against a real provider" trial, kept for the Prompt
/// Registry's history view and as an AI Evaluation input (Prompt
/// Effectiveness metric).
model PromptTestRun {
  id                    String              @id @default(uuid())
  promptTemplateId      String
  promptTemplateVersion Int?
  workspaceId           String
  inputVariablesJson    Json?
  renderedPrompt        String
  outputText            String?
  provider              String?
  model                 String?
  status                PromptTestRunStatus @default(SUCCEEDED)
  errorMessage          String?
  durationMs            Int?
  ratingScore           Int?
  notes                 String?
  createdBy             String
  createdAt             DateTime            @default(now())

  @@index([promptTemplateId, createdAt])
  // Module 18 — task #508 (database reliability review). Per-workspace
  // test-run history/listing had no covering index.
  @@index([workspaceId, createdAt])
  @@map("prompt_test_runs")
}

enum AgentSdkKind {
  BUILTIN
  CUSTOM
}

enum AgentSdkStatus {
  DRAFT
  ACTIVE
  DISABLED
}

/// AI Agent SDK (task #281): one registered agent definition — either a
/// `BUILTIN` reference implementation shipped with this module (task
/// #282's eleven agents) or a `CUSTOM` agent a developer registered
/// (directly, or via installing an `AGENT_PACK` Plugin — see
/// `pluginId`). Distinct from Module 11's `AgentType`/`BaseAgent` (the
/// internal Master Orchestrator's twelve specialists,
/// `apps/api/src/modules/agent/agents/`): those are hardcoded classes
/// the orchestrator composes into one multi-agent run; these are
/// independently invocable, SDK-lifecycle agents
/// (Initialize/LoadContext/ReceiveTask/CallTools/ReadResources/
/// GenerateResult/PublishEvents/Shutdown — see `packages/agent-sdk`) a
/// third party can author without touching this repository at all.
/// `manifestJson` declares the agent's tool/resource permission
/// requests, mirroring `PluginVersion.permissions`'s
/// disclose-before-grant shape.
model AgentSdkDefinition {
  id             String         @id @default(uuid())
  organizationId String?
  workspaceId    String?
  pluginId       String?
  slug           String
  name           String
  description    String
  kind           AgentSdkKind
  status         AgentSdkStatus @default(ACTIVE)
  manifestJson   Json
  sourceCode     String?
  permissions    String[]
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([workspaceId, slug])
  @@index([organizationId])
  @@map("agent_sdk_definitions")
}

enum AgentSdkRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// One execution of an `AgentSdkDefinition` — the Agent SDK's own run
/// ledger, separate from Module 11's `AgentOrchestrationRun`/`AgentTask`
/// (which only ever runs the twelve built-in orchestrator specialists
/// as part of one decomposed goal). `eventsJson` is the ordered
/// `PublishEvents` lifecycle log (Initialize → ... → Shutdown), surfaced
/// on the run detail page and consumed by Observability's Agent
/// Activity view.
model AgentSdkRun {
  id                   String            @id @default(uuid())
  agentSdkDefinitionId String
  workspaceId          String
  projectId            String?
  status               AgentSdkRunStatus @default(PENDING)
  inputJson            Json?
  outputJson           Json?
  eventsJson           Json?
  errorMessage         String?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdBy            String?
  createdAt            DateTime          @default(now())

  @@index([agentSdkDefinitionId, createdAt])
  @@index([workspaceId, status])
  // Module 13 — Performance (task #294). `AiPlatformObservabilityRepository
  // .agentSdkRunsSummary()` filters by (workspaceId, createdAt) with no
  // status/definitionId predicate — neither existing index's leading
  // columns cover that access path efficiently (a createdAt range scan
  // under `workspaceId, status` still has to fan out across every status
  // value). Added once the Observability dashboard (task #290) made this
  // a real, recurring query shape rather than a hypothetical one.
  @@index([workspaceId, createdAt])
  @@map("agent_sdk_runs")
}

enum ScriptLanguage {
  TYPESCRIPT
  JAVASCRIPT
  PYTHON
}

/// Script Engine (task #286): a saved, named script. TypeScript/
/// JavaScript execute through the same `node:vm` sandbox
/// `PluginSandboxService` (Module 10) established, generalized by
/// `ScriptEngineService` rather than forked; Python is accepted and
/// stored but disclosed as **not executable** in this deployment shape
/// (no Python interpreter is bundled with `apps/api` — a real
/// deployment would shell out to a policy-restricted subprocess, out of
/// scope for this pass; see the Script Engine section of the Developer
/// Guide).
model ScriptDefinition {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  description String?
  language    ScriptLanguage
  sourceCode  String
  permissions String[]
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId])
  @@map("script_definitions")
}

enum ScriptExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMEOUT
}

model ScriptExecution {
  id                 String                @id @default(uuid())
  scriptDefinitionId String
  workspaceId        String
  status             ScriptExecutionStatus @default(PENDING)
  inputJson          Json?
  outputJson         Json?
  logs               String[]
  errorMessage       String?
  durationMs         Int?
  triggeredBy        String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime              @default(now())

  @@index([scriptDefinitionId, createdAt])
  // Module 13 — Performance (task #294). `ScriptExecution` previously had
  // no `workspaceId`-leading index at all — `RunScriptHandler`'s own
  // `findExecutionById`/`listExecutions` scope by scriptDefinitionId (the
  // existing index), but `AiPlatformObservabilityRepository
  // .scriptExecutionsSummary()` filters by (workspaceId, createdAt)
  // directly, which would otherwise force a full sequential scan of this
  // table.
  @@index([workspaceId, createdAt])
  @@map("script_executions")
}

enum EvaluationMetricType {
  RESPONSE_QUALITY
  HALLUCINATION_RATE
  TOOL_SUCCESS_RATE
  WORKFLOW_SUCCESS
  EXECUTION_TIME
  PROMPT_EFFECTIVENESS
  PROVIDER_COMPARISON
}

enum EvaluationSubjectType {
  PROMPT
  AGENT
  WORKFLOW
  PROVIDER
  MCP_TOOL
}

/// AI Evaluation (task #289): one computed metric sample. Deliberately a
/// flat, generic "metric type + subject + score + detail" shape rather
/// than one table per metric — `AiEvaluationService`'s seven metric
/// computations (see the Developer Guide's "Evaluation" section) all
/// write through this one model; a new metric type is a TypeScript enum
/// value + a computation function, never a migration.
model EvaluationRun {
  id          String                @id @default(uuid())
  workspaceId String
  metricType  EvaluationMetricType
  subjectType EvaluationSubjectType
  subjectId   String?
  provider    String?
  model       String?
  score       Float?
  resultJson  Json?
  createdBy   String?
  createdAt   DateTime              @default(now())

  @@index([workspaceId, metricType, createdAt])
  @@index([subjectType, subjectId])
  @@map("evaluation_runs")
}

/// Workflow Builder — inbound WEBHOOK trigger (task #283). Deliberately
/// its own table (raw-SQL only, same Module 13 constraint as every
/// model in this file) rather than a `Workflow` column, so the bearer
/// `token` never round-trips through "fetch this workflow's definition
/// to render the visual builder" — see
/// `WorkflowWebhookTriggerDto`'s doc comment in `@pentesthub/shared`.
/// `POST /public/workflow-triggers/:token` (no auth beyond the token
/// itself — same trust model as an inbound provider webhook) starts a
/// run with the request body as `WorkflowRun.input`.
model WorkflowWebhookTrigger {
  id         String   @id @default(uuid())
  workflowId String
  token      String   @unique
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([workflowId])
  @@map("workflow_webhook_triggers")
}

enum RelayCommandTarget {
  DESKTOP
  BROWSER
}

enum RelayCommandStatus {
  PENDING
  DELIVERED
  COMPLETED
  FAILED
}

/// Local Execution (task #288). The real, working half of what
/// `McpToolRegistryService`'s `desktop_agent_command`/
/// `browser_extension_command` MCP tools enqueue into —
/// `queueRelayCommand` used to only return a fake `{status: 'queued'}`
/// with no persistence at all; it now inserts a real row here. A
/// connected Desktop Agent or Browser Extension session is meant to
/// poll `GET /relay-commands/pending?target=DESKTOP` (see
/// `RelayCommandsController`) and `POST /relay-commands/:id/complete`
/// once it's run the command locally (through the Desktop Agent's
/// existing `JobQueue`/`ToolRunner`, or the extension's content-script
/// bridge) — **the client-side poll loop itself is not wired in this
/// pass** (see that controller's doc comment for exactly where it plugs
/// into the Desktop Agent's Rust `SyncEngine`/`JobQueue`, discovered but
/// deliberately not touched without a Rust toolchain available to verify
/// the change compiles). This table intentionally does NOT reuse Module
/// 7's `desktop-sync` push/pull protocol — that REST surface has no
/// server-side implementation in this codebase at all (a pre-existing
/// Module 7 gap discovered while researching this task, out of Module
/// 13's scope to backfill) — so this is a standalone, independently
/// working queue rather than one more consumer of an endpoint that
/// doesn't exist yet.
model RelayCommand {
  id          String              @id @default(uuid())
  workspaceId String
  target      RelayCommandTarget
  commandType String
  payloadJson Json
  status      RelayCommandStatus  @default(PENDING)
  resultJson  Json?
  createdBy   String?
  createdAt   DateTime            @default(now())
  deliveredAt DateTime?
  completedAt DateTime?

  @@index([workspaceId, target, status])
  @@map("relay_commands")
}

// =============================================================================
// Module 15 — Production Hardening, Monetization, Marketplace & Global Launch
// =============================================================================
// Provider-agnostic by design (see docs/adr/0015-production-hardening-monetization-marketplace.md):
// every model below describes billing/quota/marketplace *state*, never calls
// a payment provider's API directly — that lives behind
// `apps/api/src/modules/billing/providers/payment-provider.interface.ts`. A
// Community Edition deployment with no provider configured still gets a
// fully functional `Subscription` row pinned to `PlanTier.FREE`/
// `BillingProviderKind.NONE` — nothing in this block requires Stripe, or any
// paid service, to exist or be reachable. See task #361's Community Edition
// guarantee review for the audit that confirms this holds.

enum PlanTier {
  FREE
  CLOUD_FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  NONE
}

enum BillingProviderKind {
  STRIPE
  MANUAL
  NONE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// One row per plan tier — the single configuration-driven source of truth
/// for pricing/limits (task #328), so "make Pro cheaper" or "raise the Team
/// storage limit" is a data change, never a code change. Seeded by
/// `apps/api/prisma/seed-plans.ts`; `PlanTier.FREE` always exists with
/// `priceMonthlyCents: 0` and is what every new Organization starts on
/// (`SubscriptionService.ensureDefaultSubscription`).
model Plan {
  id                String   @id @default(uuid())
  tier              PlanTier @unique
  name              String
  description       String
  priceMonthlyCents Int      @default(0)
  priceYearlyCents  Int      @default(0)
  currency          String   @default("usd")
  /// Keyed by `UsageResourceType` (e.g. `{"AI_TOKENS": {"monthly":
  /// 100000}, "STORAGE_BYTES": {"total": 5368709120}}`) — consumed by
  /// `QuotaEnforcer` as the plan-level default `QuotaPolicy` when no more
  /// specific override exists. A `null` limit value means "unlimited,"
  /// used by `PlanTier.FREE`'s self-hosted-usage entries per the standing
  /// "never charge users for self-hosted usage" rule.
  limits    Json
  /// Boolean/short-string feature toggles this plan unlocks (e.g.
  /// `{"hostedWorkers": true, "sso": false, "prioritySupport": false}`) —
  /// read by `EntitlementService`, never hardcoded per-plan in business
  /// logic.
  features  Json
  isActive  Boolean  @default(true)
  /// Provider-specific config a `PaymentProvider` adapter needs but
  /// this table shouldn't hardcode a column for (e.g.
  /// `{"stripe": {"monthlyPriceId": "price_...", "yearlyPriceId":
  /// "price_..."}}`). `null`/missing entries mean "this provider isn't
  /// wired for this plan yet" — `StripePaymentProvider.createCheckoutSession()`
  /// falls back to returning `null` (no checkout) rather than throwing,
  /// so an unconfigured Stripe price never breaks the rest of the page.
  providerMetadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

/// One active subscription per Organization. Community Edition orgs get one
/// row pinned to FREE/NONE at creation — this table is not Enterprise-only
/// or Cloud-only, unlike `License` (Module 14, which gates Enterprise
/// *features*; this gates *billing state* and applies to every edition).
/// `Organization.subscriptionStatus`/`billingProviderCustomerId` (Module 14,
/// plain strings) are left as-is for backward compatibility with the
/// existing `BillingWebhookController`; this table is the typed system of
/// record `SubscriptionService` actually reads/writes, and keeps those
/// legacy columns in sync as a denormalized convenience.
model Subscription {
  id                     String              @id @default(uuid())
  organizationId         String              @unique
  planId                 String
  status                 SubscriptionStatus  @default(NONE)
  provider               BillingProviderKind @default(NONE)
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean             @default(false)
  trialEndsAt            DateTime?
  /// Module 20 — webhook event-ordering fix. The provider event ID and
  /// the provider's own `created` timestamp of the last
  /// `customer.subscription.*` webhook event actually applied to this
  /// row. `applyStripeWebhookUpdate()` compares an incoming event's
  /// timestamp against this before writing — an out-of-order redelivery
  /// of an older event (e.g. a stale `past_due` arriving after a newer
  /// `active` was already applied) is detected and skipped instead of
  /// silently overwriting newer state with older. `null` for a
  /// subscription that has never received a webhook yet (created via
  /// checkout/manual flow only).
  lastWebhookEventId     String?
  lastWebhookEventAt     DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([provider, providerSubscriptionId])
  @@map("subscriptions")
}

model Invoice {
  id                String              @id @default(uuid())
  organizationId    String
  subscriptionId    String?
  provider          BillingProviderKind
  providerInvoiceId String?
  status            InvoiceStatus       @default(DRAFT)
  amountCents       Int
  currency          String              @default("usd")
  issuedAt          DateTime            @default(now())
  paidAt            DateTime?
  dueAt             DateTime?
  hostedInvoiceUrl  String?
  pdfUrl            String?
  createdAt         DateTime            @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, issuedAt])
  @@index([provider, providerInvoiceId])
  @@map("invoices")
}

model PaymentMethod {
  id                      String              @id @default(uuid())
  organizationId          String
  provider                BillingProviderKind
  providerPaymentMethodId String
  brand                   String?
  last4                   String?
  expMonth                Int?
  expYear                 Int?
  isDefault               Boolean             @default(false)
  createdAt               DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("payment_methods")
}

// ---------------------------------------------------------------------------
// Usage metering + quota engine (tasks #329-330)
// ---------------------------------------------------------------------------

enum UsageResourceType {
  AI_TOKENS
  AI_REQUESTS
  SCANNER_JOBS
  RECON_JOBS
  WORKER_CPU_SECONDS
  STORAGE_BYTES
  BANDWIDTH_BYTES
  REPORTS_GENERATED
  WORKFLOW_EXECUTIONS
  MCP_CALLS
  API_REQUESTS
  PLUGIN_EXECUTIONS
  DESKTOP_JOBS
  MOBILE_SYNCS
  /// Module 15 — AI cost control (task #340). See
  /// packages/shared/src/usage-metering.ts's doc comment on the same value.
  AI_COST_CENTS
}

enum QuotaScopeType {
  PLAN
  ORGANIZATION
  WORKSPACE
  USER
}

enum QuotaPeriodType {
  DAILY
  MONTHLY
  TOTAL
}

/// One pre-aggregated counter per (scope, resource, period) — written by
/// `UsageService.record()` as an upsert (`quantity += $1`), not a
/// row-per-event log, so this table stays small regardless of API traffic
/// volume. `organizationId`/`workspaceId`/`userId` are plain nullable
/// FK-shaped fields with no Prisma relation, matching `ApiRequestLog`'s
/// existing convention for high-volume metering tables (Module 14) — exactly
/// one of the three is populated per row, matching whichever scope the
/// event was recorded at.
model UsageCounter {
  id           String            @id @default(uuid())
  /// Deliberately non-nullable, `@default("")` for "not scoped at this
  /// dimension" rather than `String?`/`null` — Postgres treats every
  /// `NULL` as distinct for unique-constraint purposes, which would
  /// silently break `UsageService.record()`'s upsert (`ON CONFLICT`
  /// never matches when any constraint column is `NULL`, so every call
  /// would insert a fresh row instead of incrementing one). An empty
  /// string sentinel keeps the composite `@@unique` below fully
  /// functional. Application code never treats `""` as a real ID.
  organizationId String            @default("")
  workspaceId    String            @default("")
  userId         String            @default("")
  resourceType   UsageResourceType
  periodType     QuotaPeriodType
  periodStart    DateTime
  periodEnd      DateTime
  quantity       Float             @default(0)
  unit           String
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, workspaceId, userId, resourceType, periodType, periodStart])
  @@index([organizationId, resourceType, periodStart])
  @@map("usage_counters")
}

/// A limit at one scope level. `QuotaEnforcer` resolves the *tightest*
/// applicable policy across PLAN -> ORGANIZATION -> WORKSPACE -> USER (most
/// specific wins if present, else falls back up the chain to the plan
/// default in `Plan.limits`) — generalizes the same most-specific-wins
/// pattern `ResourceQuota` (Module 10) established with fixed per-org
/// columns, now per-resource-type and per-scope. `scopeId` is null for
/// `PLAN` scope (use `planTier` instead); exactly one of `scopeId`/
/// `planTier` is set per row.
model QuotaPolicy {
  id           String            @id @default(uuid())
  scopeType    QuotaScopeType
  scopeId      String?
  planTier     PlanTier?
  resourceType UsageResourceType
  periodType   QuotaPeriodType
  softLimit    Float?
  hardLimit    Float?
  graceHours   Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([scopeType, scopeId, planTier, resourceType, periodType])
  @@index([scopeType, scopeId])
  @@map("quota_policies")
}

// ---------------------------------------------------------------------------
// Marketplace security (task #333) — extends Module 10/13's Plugin
// Marketplace, doesn't replace it. `Plugin.verified`/`downloadCount`/
// `ratingAverage`/`ratingCount` and `PluginRating` already exist (Module 10)
// and are reused as-is for download stats and community rating.
// ---------------------------------------------------------------------------

enum MarketplaceReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

/// A verified publisher identity, distinct from `Plugin.authorUserId`
/// (which just records who clicked "publish"). A Plugin published by a
/// `MarketplacePublisher` with `verified: true` is what the marketplace UI
/// badges as "Verified Publisher" — separate from `Plugin.verified`
/// (Module 10), which reflects *signature* validity. `publicKeyPem` lets a
/// verified publisher sign with their own key instead of only the
/// marketplace operator's single shared key
/// (`PLUGIN_MARKETPLACE_PUBLIC_KEY`).
model MarketplacePublisher {
  id             String    @id @default(uuid())
  userId         String    @unique
  organizationId String?
  displayName    String
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  publicKeyPem   String?
  websiteUrl     String?
  supportEmail   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plugins Plugin[]

  @@map("marketplace_publishers")
}

/// One row per automated scan run against a `PluginVersion` (dependency
/// scan, malware-scan hook, secret scan). `MarketplaceScannerService` runs a
/// best-effort static pass in-process — no paid scanning API required — and
/// records the result here regardless of outcome, so "never scanned" (no
/// rows) is visibly different from "scanned clean" (a row with `passed:
/// true`).
model MarketplaceScanResult {
  id              String   @id @default(uuid())
  pluginVersionId String
  scanType        String
  passed          Boolean
  findings        Json?
  scannedAt       DateTime @default(now())

  pluginVersion PluginVersion @relation(fields: [pluginVersionId], references: [id], onDelete: Cascade)

  @@index([pluginVersionId])
  @@map("marketplace_scan_results")
}

/// A disclosed vulnerability in a published plugin. Reuses
/// `VulnFindingSeverity` (Module 4) rather than a new severity enum — the
/// same 5-level scale a security advisory needs.
model SecurityAdvisory {
  id                   String              @id @default(uuid())
  pluginId             String?
  title                String
  description          String
  severity             VulnFindingSeverity
  affectedVersionRange String?
  patchedVersion       String?
  publishedAt          DateTime            @default(now())
  createdAt            DateTime            @default(now())

  plugin Plugin? @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId])
  @@map("security_advisories")
}

/// Explicit per-installation permission grants — a plugin's
/// `PluginVersion.permissions` (Module 10, `string[]`) is what it
/// *declares*; this is what an org admin actually *granted* at install
/// time, enforced by `PluginPermissionEnforcer` (task #334). A
/// declared-but-not-granted permission is unavailable at runtime even
/// though the plugin asked for it — the same disclose-then-consent model
/// OAuth app installs use, now actually enforced rather than only
/// disclosed.
model PluginPermissionGrant {
  id                   String   @id @default(uuid())
  pluginInstallationId String
  permission           String
  grantedByUserId      String
  grantedAt            DateTime @default(now())

  installation PluginInstallation @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)

  @@unique([pluginInstallationId, permission])
  @@map("plugin_permission_grants")
}

// ---------------------------------------------------------------------------
// Feature flags (task #357)
// ---------------------------------------------------------------------------

enum FeatureFlagScopeType {
  ORGANIZATION
  WORKSPACE
  USER
}

/// A named toggle. `defaultEnabled` is the fallback when no
/// `FeatureFlagOverride` matches — Community/Cloud/Enterprise/Beta/
/// Developer/Self-hosted targeting is expressed as JSON conditions in
/// `editionRules` (e.g. `{"minEdition": "enterprise"}` or `{"planTiers":
/// ["PRO","TEAM","ENTERPRISE"]}`), evaluated by `FeatureFlagService` before
/// falling back to `defaultEnabled`.
model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  description    String
  defaultEnabled Boolean  @default(false)
  editionRules   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

/// A per-scope override, taking precedence over both `editionRules` and
/// `defaultEnabled`. `scopeId` is polymorphic against `scopeType` (the same
/// established pattern as `AttachableType`/`attachableId` — Module 2) — no
/// Prisma relation, since the referenced model varies.
model FeatureFlagOverride {
  id            String               @id @default(uuid())
  featureFlagId String
  scopeType     FeatureFlagScopeType
  scopeId       String
  enabled       Boolean
  createdAt     DateTime             @default(now())

  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, scopeType, scopeId])
  @@map("feature_flag_overrides")
}

// ---------------------------------------------------------------------------
// AI cost control (task #340)
// ---------------------------------------------------------------------------

/// Per-provider/per-model pricing, so cost estimation doesn't hardcode
/// dollar amounts in TypeScript. Seeded with publicly documented list
/// prices for the built-in cloud providers; `OLLAMA` rows are seeded at $0
/// since there's no metered cost to a local model. Operators can update
/// prices here without a code change if a provider's pricing changes.
model AiModelPricing {
  id                          String         @id @default(uuid())
  provider                    AiProviderName
  model                       String
  inputCentsPerMillionTokens  Int            @default(0)
  outputCentsPerMillionTokens Int            @default(0)
  updatedAt                   DateTime       @updatedAt

  @@unique([provider, model])
  @@map("ai_model_pricing")
}

/// Budget ceiling for a scope (mirrors `QuotaPolicy`'s scope model but kept
/// as its own table rather than overloading `QuotaPolicy` with cost-specific
/// fields, since AI budget enforcement — refuse the *next* AI call outright
/// — is a stricter, synchronous check than the softer "you're over quota,
/// keep going with warnings" model `QuotaEnforcer` otherwise applies to
/// metered resources like storage).
model AiBudgetPolicy {
  id                    String         @id @default(uuid())
  scopeType             QuotaScopeType
  scopeId               String?
  planTier              PlanTier?
  dailyTokenLimit       Int?
  monthlyTokenLimit     Int?
  dailyCostCentsLimit   Int?
  monthlyCostCentsLimit Int?
  hardStop              Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([scopeType, scopeId, planTier])
  @@map("ai_budget_policies")
}

// Module 15 — Support system (task #355).

enum SupportTicketCategory {
  BUG
  BILLING
  ACCOUNT
  FEATURE_REQUEST
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// A user-submitted support request. Deliberately not a full threaded
/// ticketing system with per-message rows — this platform has no
/// deployment-wide "platform admin" role to gate an in-app triage UI
/// behind (the same gap `ClusterOverviewService` already discloses), so
/// this table exists for audit history and for the submitter's own "my
/// tickets" list, while an operator actually triages via the notification
/// email `CreateSupportTicketHandler` sends to `SUPPORT_INBOX_EMAIL` — the
/// same "monitored inbox is the primary channel" posture SECURITY.md
/// already documents for security reports. `userId`/`workspaceId` are
/// nullable because the intake endpoint is deliberately public — someone
/// who can't log in is exactly who most needs to be able to reach support.
model SupportTicket {
  id       String  @id @default(uuid())
  /// Null for a logged-out submitter; set for an authenticated one so
  /// `ListMySupportTicketsQuery` can scope "my tickets" without a Prisma
  /// relation (matching `ApiKey.userId`'s plain-field precedent above).
  userId   String?
  workspaceId String?
  /// Always present — even for an authenticated submitter, since the
  /// reply naturally goes here rather than requiring a lookup back to
  /// `User.email` (which may not match where the person wants a reply).
  email    String
  category SupportTicketCategory
  subject  String
  message  String
  status   SupportTicketStatus @default(OPEN)
  /// Optional client-side snapshot from `useDiagnostics()` (task #353) —
  /// JSON blob of app/server version, latency, database status, browser
  /// info — attached at submission time so a first response doesn't have
  /// to start with "what browser are you using?" Never required; a ticket
  /// filed from outside the product (e.g. by email in the future) simply
  /// won't have one.
  diagnosticsSnapshot Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  // Module 18 — task #508 (database reliability review). Per-workspace
  // ticket listing had no covering index.
  @@index([workspaceId])
  @@map("support_tickets")
}

// =============================================================================
// Module 16 — Global Security Intelligence, Bug Bounty Platform & Collaboration
// See docs/adr/0016-global-security-intelligence-bugbounty-collaboration.md.
//
// Every `workspaceId`/`projectId`/`targetId`/`userId`/`createdBy` column below
// is a plain, un-relationed string field — matching `SupportTicket.userId`'s
// established precedent ("matching ApiKey.userId's plain-field precedent")
// rather than adding a `@relation` back-array to Workspace/Project/Target/
// User for every new Module 16 model, which would mean editing those four
// large, heavily-depended-on models 15+ times each. Relations between the
// *new* models introduced in this section are still declared properly.
// =============================================================================

// --- Research Session -------------------------------------------------------

enum ResearchSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// Groups Recon jobs, Vuln scans, Findings, Notes, Evidence, ad-hoc
/// Commands, AI conversations, and Reports produced during one research
/// engagement, without moving or re-owning any of that data — a
/// `ResearchSessionLink` row is a pointer, the linked row's real owner
/// (Project/Target/Program) is unchanged.
model ResearchSession {
  id          String                 @id @default(uuid())
  workspaceId String
  projectId   String?
  targetId    String?
  programId   String?
  name        String
  description String?
  status      ResearchSessionStatus  @default(ACTIVE)
  createdBy   String
  startedAt   DateTime               @default(now())
  endedAt     DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  links ResearchSessionLink[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([targetId])
  @@map("research_sessions")
}

enum ResearchSessionEntityType {
  RECON_JOB
  VULN_SCAN_JOB
  BUGBOUNTY_FINDING
  VULN_FINDING
  NOTE
  EVIDENCE
  AD_HOC_COMMAND
  AI_CONVERSATION
  AI_INVESTIGATION_SESSION
  BUG_REPORT
  ACTIVITY_EVENT
}

model ResearchSessionLink {
  id         String                     @id @default(uuid())
  sessionId  String
  entityType ResearchSessionEntityType
  entityId   String
  linkedAt   DateTime                   @default(now())

  session ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("research_session_links")
}

// --- Technology fingerprinting -----------------------------------------------

/// Normalized technology detections, derived from existing HTTPX/WhatWeb
/// recon output (`ReconFinding` rows of the relevant type) rather than a
/// second scanning pipeline — `TechnologyDetectionService` parses those
/// results into one row per (target, technology name) pair.
model Technology {
  id           String   @id @default(uuid())
  workspaceId  String
  projectId    String
  targetId     String
  name         String
  category     String?
  version      String?
  detectedVia  String
  confidence   Float    @default(1)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  cveMatches CveMatch[]

  @@unique([targetId, name])
  @@index([workspaceId, name])
  @@index([projectId])
  @@map("technologies")
}

// --- Asset Graph --------------------------------------------------------------

enum AssetGraphNodeType {
  DOMAIN
  SUBDOMAIN
  IP
  PORT
  URL
  ENDPOINT
  TECHNOLOGY
  CERTIFICATE
  ASN
  CLOUD_ASSET
  REPOSITORY
  FINDING
  // Module 17 — Security Asset Inventory (task #462). The spec's asset
  // type list (DOMAIN/SUBDOMAIN/IP/CIDR/URL/API/PORT/SERVICE/CERTIFICATE/
  // CLOUD_RESOURCE/REPOSITORY/MOBILE_APP/HOST/CONTAINER/
  // KUBERNETES_RESOURCE) overlaps almost entirely with this existing
  // enum (CLOUD_ASSET already covers CLOUD_RESOURCE, ASN/CERTIFICATE
  // already exist) — extending it here rather than introducing a second,
  // parallel "SecurityAsset" model with its own type enum, per the
  // explicit "do not duplicate graph infrastructure" instruction. Only
  // the genuinely new types are added.
  CIDR
  API
  SERVICE
  MOBILE_APP
  HOST
  CONTAINER
  KUBERNETES_RESOURCE
}

/// A refreshable *cache* of the asset relationship graph, not a new source
/// of truth — `AssetGraphService.rebuild(targetId)` derives every node/edge
/// from `Target`/`ReconFinding`/`Technology`/`BugBountyFinding` and
/// replaces this target's rows, the same "read-through, don't duplicate"
/// posture Module 6's Asset Inventory already established. Persisted
/// (rather than computed on every request) purely so the graph view and
/// Knowledge Graph queries don't re-derive it on every page load.
model AssetGraphNode {
  id          String             @id @default(uuid())
  workspaceId String
  projectId   String
  targetId    String
  nodeType    AssetGraphNodeType
  refId       String
  label       String
  metadata    Json?
  updatedAt   DateTime           @updatedAt
  createdAt   DateTime           @default(now())

  edgesFrom AssetGraphEdge[] @relation("AssetGraphEdgeFrom")
  edgesTo   AssetGraphEdge[] @relation("AssetGraphEdgeTo")

  @@unique([targetId, nodeType, refId])
  @@index([workspaceId, projectId])
  @@map("asset_graph_nodes")
}

enum AssetGraphEdgeType {
  RESOLVES_TO
  CONTAINS
  HOSTS
  USES
  REDIRECTS_TO
  BELONGS_TO
  DISCOVERED_BY
  AFFECTED_BY
}

model AssetGraphEdge {
  id          String             @id @default(uuid())
  workspaceId String
  fromNodeId  String
  toNodeId    String
  edgeType    AssetGraphEdgeType
  metadata    Json?
  createdAt   DateTime           @default(now())

  fromNode AssetGraphNode @relation("AssetGraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   AssetGraphNode @relation("AssetGraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, edgeType])
  @@index([workspaceId])
  @@map("asset_graph_edges")
}

// --- Change detection ---------------------------------------------------------

enum ChangeDetectionEventType {
  NEW_SUBDOMAIN
  REMOVED_SUBDOMAIN
  NEW_PORT
  CLOSED_PORT
  NEW_ENDPOINT
  CHANGED_TECHNOLOGY
  CHANGED_HTTP_HEADERS
  CHANGED_TLS_CERTIFICATE
  CHANGED_DNS
  CHANGED_SCOPE
  // Module 17 — Continuous Attack Surface Monitoring (task #463). The
  // spec's "AttackSurfaceEvent" is, in every respect that matters
  // (workspace/project/target-scoped, one row per detected change,
  // previous/new value pair, `detectedAt`), the same shape as this
  // pre-existing `ChangeDetectionEvent` model from Module 16 — reused
  // directly rather than building a second, parallel change-event model.
  // CLOSED_PORT/CHANGED_TLS_CERTIFICATE/CHANGED_DNS/CHANGED_HTTP_HEADERS
  // above already cover CLOSED_PORT/CERTIFICATE_CHANGE/DNS_CHANGE/
  // HTTP_CHANGE from the spec's list; only the genuinely new distinction
  // (a whole asset appearing/disappearing, not just its subdomain form;
  // an explicit new/removed technology rather than only "changed") is
  // added below.
  NEW_ASSET
  REMOVED_ASSET
  NEW_TECHNOLOGY
  REMOVED_TECHNOLOGY
}

/// Written by `ChangeDetectionService.diff()` whenever a Recon job
/// completes and a prior completed job exists for the same target —
/// compares the two `ReconFinding` sets (plus `Technology` rows) rather
/// than storing full snapshots.
model ChangeDetectionEvent {
  id            String                    @id @default(uuid())
  workspaceId   String
  projectId     String
  targetId      String
  reconJobId    String?
  changeType    ChangeDetectionEventType
  entityRef     String
  previousValue Json?
  newValue      Json?
  detectedAt    DateTime                  @default(now())

  @@index([targetId, changeType])
  @@index([workspaceId, detectedAt])
  @@map("change_detection_events")
}

// --- Finding correlation -------------------------------------------------------

enum CorrelationInsightKind {
  OPEN_PORT_EXPOSED_SERVICE
  OUTDATED_TECH_KNOWN_CVE
  SUBDOMAIN_TAKEOVER_DANGLING_DNS
  MISSING_HEADER_SENSITIVE_ENDPOINT
  AUTH_WEAKNESS_SENSITIVE_API
  // Module 17 — Change Intelligence (task #464). Unlike the five kinds
  // above (which re-evaluate a target's *current* full state on every
  // recon completion), these two are driven specifically by fresh
  // `ChangeDetectionEvent` rows from the run that just completed — i.e.
  // "this wasn't just found, it's NEW since the last scan", which is the
  // signal an attack-surface-monitoring analyst actually needs distinct
  // from a static correlation. See `FindingCorrelationService
  // .detectChangeIntelligence`.
  NEW_ASSET_POTENTIAL_EXPOSURE
  NEW_SERVICE_POTENTIAL_EXPOSURE
}

/// Output of `CorrelationEngineService` — a proposed insight linking two
/// or more already-persisted facts (never a new finding on its own; a
/// human or the AI Security Analyst still decides whether to promote one
/// into a `BugBountyFinding`).
model CorrelationInsight {
  id          String                  @id @default(uuid())
  workspaceId String
  projectId   String
  targetId    String?
  kind        CorrelationInsightKind
  title       String
  description String
  severity    VulnFindingSeverity?
  relatedRefs Json
  createdAt   DateTime                @default(now())

  @@index([workspaceId, kind])
  @@index([targetId])
  @@map("correlation_insights")
}

// --- Bug Bounty Submissions & reward tracking ----------------------------------

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  TRIAGED
  INFORMATIVE
  DUPLICATE
  NOT_APPLICABLE
  ACCEPTED
  RESOLVED
  BOUNTY_PAID
  CLOSED
  REOPENED
}

/// Tracks a finding's life *on the external platform* after a hunter
/// reports it — distinct from `BugReport` (the rendered document content)
/// and from `BugBountyFinding.stage` (this platform's internal validation
/// workflow): a `Submission` is the correspondence record (external id/
/// URL, platform response, reward) a `BugReport` gets attached to once
/// sent.
model Submission {
  id            String            @id @default(uuid())
  workspaceId   String
  projectId     String
  programId     String
  findingId     String
  bugReportId   String?
  title         String
  severity      VulnFindingSeverity
  status        SubmissionStatus  @default(DRAFT)
  submittedAt   DateTime?
  responseAt    DateTime?
  reward        Float?
  currency      String?           @default("USD")
  platform      BugBountyPlatform
  externalId    String?
  externalUrl   String?
  notes         String?
  createdBy     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  program BugBountyProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  finding BugBountyFinding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  rewardEntries RewardLedgerEntry[]

  @@index([workspaceId, status])
  @@index([programId])
  @@index([findingId])
  // Module 18 — task #508 (database reliability review). `externalId` (the
  // platform's own report ID) had no uniqueness constraint — re-importing/
  // re-syncing the same external submission could create a duplicate row.
  // Safe with a nullable column: Postgres treats each NULL as distinct in
  // a unique index, so draft submissions that don't have an externalId
  // yet never collide with each other.
  @@unique([workspaceId, platform, externalId])
  @@map("bugbounty_submissions")
}

/// One ledger line per reward event (a submission can be repaid, adjusted,
/// or bonused more than once) — monthly/yearly totals are a query
/// (`SUM(netAmount) GROUP BY date_trunc(...)`), not a separate rollup
/// table, avoiding a second source of truth that could drift.
model RewardLedgerEntry {
  id           String   @id @default(uuid())
  workspaceId  String
  submissionId String?
  programId    String
  amount       Float
  currency     String   @default("USD")
  feeAmount    Float?   @default(0)
  netAmount    Float
  occurredAt   DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([programId])
  @@map("reward_ledger_entries")
}

// --- Terminal workspace + safe command execution (task #388) --------------------

enum AdHocCommandStatus {
  PENDING
  PENDING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
  REJECTED
}

/// One row per Terminal-issued command — the audit journal + output store
/// for task #388. Execution never happens against this table directly;
/// AdHocCommandService resolves the same ToolRunnerRegistry/
/// ScannerRunnerRegistry Recon/Vuln jobs use (see that service's doc
/// comment for why there is deliberately no separate "shell exec"
/// implementation), then records the outcome here. `classification` is
/// stamped from the server-side command registry at request time (never
/// derived from client input), so this row alone is enough to answer "was
/// this command SAFE, did it require approval, or was it blocked" without
/// re-consulting the registry.
model AdHocCommand {
  id                String             @id @default(uuid())
  workspaceId       String
  projectId         String
  targetId          String
  tool              String
  kind              String
  argsSummary       String?
  classification    String
  status            AdHocCommandStatus @default(PENDING)
  approvalRequestId String?
  exitCode          Int?
  stdout            String?
  stderr            String?
  rejectionReason   String?
  requestedBy       String
  source            String             @default("WEB")
  researchSessionId String?
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([workspaceId, requestedBy, createdAt])
  @@index([targetId])
  @@index([approvalRequestId])
  @@map("adhoc_commands")
}

// --- Playbooks + Playbook Builder (task #389) ------------------------------------

enum PlaybookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlaybookExecutionStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum PlaybookExecutionStepStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  SKIPPED
  COMPLETED
  FAILED
  CANCELLED
}

enum PlaybookApprovalStatus {
  WAITING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
}

/// Task #389. `PlaybookStep` and `PlaybookVariable` (named separately in
/// the spec) are deliberately *not* their own SQL tables here — a
/// playbook's step graph and variable declarations are versioned as one
/// atomic unit (`PlaybookVersion.graph`/`.variables`, both JSONB), which
/// is what makes "each execution must preserve the exact version used"
/// (spec requirement) trivial: an execution just references a
/// `playbookVersionId`, and that row's `graph` is immutable once
/// published. Normalizing steps/variables into separate joined tables
/// would let a step be edited in place after executions already reference
/// it — exactly the failure mode "preserve the exact version" is meant to
/// prevent. See PlaybookGraph / PlaybookStepDefinition in
/// @pentesthub/shared/playbooks.ts for the JSON shape stored in `graph`.
model Playbook {
  id               String         @id @default(uuid())
  workspaceId      String
  name             String
  description      String?
  category         String
  isBuiltIn        Boolean        @default(false)
  status           PlaybookStatus @default(DRAFT)
  currentVersionId String?
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  archivedAt       DateTime?

  versions   PlaybookVersion[]
  executions PlaybookExecution[]

  @@index([workspaceId, status])
  @@map("playbooks")
}

model PlaybookVersion {
  id          String    @id @default(uuid())
  playbookId  String
  version     Int
  graph       Json
  variables   Json      @default("[]")
  publishedAt DateTime?
  publishedBy String?
  createdBy   String
  createdAt   DateTime  @default(now())

  playbook   Playbook             @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  executions PlaybookExecution[]

  @@unique([playbookId, version])
  @@map("playbook_versions")
}

model PlaybookExecution {
  id                String                   @id @default(uuid())
  workspaceId       String
  projectId         String
  playbookId        String
  playbookVersionId String
  targetId          String
  status            PlaybookExecutionStatus  @default(PENDING)
  isDryRun          Boolean                  @default(false)
  variableValues    Json                     @default("{}")
  requestedBy       String
  error             String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  playbook Playbook        @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  version  PlaybookVersion @relation(fields: [playbookVersionId], references: [id], onDelete: Restrict)
  steps    PlaybookExecutionStep[]
  approvals PlaybookApproval[]

  @@index([workspaceId, status])
  @@index([playbookId])
  @@map("playbook_executions")
}

model PlaybookExecutionStep {
  id             String                       @id @default(uuid())
  executionId    String
  nodeId         String
  stepType       String
  status         PlaybookExecutionStepStatus  @default(PENDING)
  input          Json?
  output         Json?
  error          String?
  reconJobId     String?
  vulnScanJobId  String?
  adHocCommandId String?
  approvalId     String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  execution PlaybookExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("playbook_execution_steps")
}

model PlaybookApproval {
  id                        String                  @id @default(uuid())
  executionId               String
  executionStepId           String
  workspaceId               String
  status                    PlaybookApprovalStatus  @default(WAITING_APPROVAL)
  securityApprovalRequestId String?
  requestedBy               String
  decidedBy                 String?
  decidedAt                 DateTime?
  expiresAt                 DateTime?
  createdAt                 DateTime                @default(now())

  execution PlaybookExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([workspaceId, status])
  @@map("playbook_approvals")
}

// --- CVE Intelligence -----------------------------------------------------------

/// A locally-cached CVE record. `source` records which pluggable provider
/// populated/last-refreshed it (NVD/CISA_KEV/OSV/GITHUB_ADVISORIES/
/// VENDOR/MANUAL) — see `docs/architecture/cve-intelligence.md`. No
/// provider is contacted automatically; `CveIntelligenceService` only
/// fetches when explicitly asked (manual refresh or an opt-in scheduled
/// job an operator enables), so a Community Edition deployment with
/// `CVE_INTELLIGENCE_PROVIDER=none` still has a fully queryable (if empty
/// until seeded) local cache.
model CveRecord {
  cveId       String    @id
  cvssScore   Float?
  cvssVector  String?
  cwe         String?
  cpeList     Json?
  epss        Float?
  description String?
  references  Json?
  publishedAt DateTime?
  source      String
  cachedAt    DateTime  @default(now())
  // Module 17 — Threat Intelligence (task #466). The spec's
  // "ThreatVulnerability" entity is CVE-plus-exploitation-context — since
  // this platform already has a global CVE cache (`CveRecord`, populated
  // from the same class of feeds: NVD/vendor advisories), extending it
  // with CISA KEV fields here is the reuse call, rather than a second,
  // parallel vulnerability-cache model that would need its own CVE-id
  // join back to this one. `isKnownExploited` is Risk Engine v2's single
  // highest-signal boolean input (task #474).
  isKnownExploited  Boolean   @default(false)
  kevAddedAt        DateTime?
  kevDueDate        DateTime?
  kevRansomwareUse  String?

  matches CveMatch[]

  @@index([cwe])
  @@index([isKnownExploited])
  @@map("cve_records")
}

/// A proposed technology+version -> CVE correlation, produced by
/// `VulnerabilityMatchingService` from `Technology` rows against the
/// local `CveRecord` cache via CPE — deliberately not auto-promoted into
/// a `BugBountyFinding`; a human (or the AI Security Analyst, itself
/// proposal-only) reviews `confidence`/`evidence` first.
model CveMatch {
  id           String   @id @default(uuid())
  workspaceId  String
  projectId    String
  targetId     String?
  technologyId String?
  findingId    String?
  cveId        String
  confidence   Float
  evidence     Json?
  createdAt    DateTime @default(now())

  cve        CveRecord   @relation(fields: [cveId], references: [cveId], onDelete: Cascade)
  technology Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  finding    BugBountyFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([workspaceId, cveId])
  @@index([technologyId])
  @@map("cve_matches")
}

// --- Approval gates & Global Security Policy -------------------------------------

/// Deliberately distinct from Module 10's `ApprovalWorkflow`/
/// `ApprovalRequest` (organization-level, multi-approver, Enterprise-role-
/// gated governance chains for things like tenant billing changes) — this
/// is a lightweight, workspace-scoped, single-approver gate for one
/// specific operation (an AI Investigation step, a large-scale scan, a
/// potentially destructive command), and it must work identically in a
/// self-hosted Community Edition deployment with no `Organization` at
/// all. Reusing Module 10's model here would either force an
/// Organization to exist (violating the Community Edition guarantee) or
/// silently repurpose an Enterprise-role field for a workspace-only
/// concept. See ADR 0016 §5.
enum SecurityApprovalRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

model SecurityApprovalRequest {
  id            String                     @id @default(uuid())
  workspaceId   String
  requestedBy   String
  operationType String
  riskLevel     SecurityApprovalRiskLevel
  resourceType  String
  resourceId    String?
  reason        String?
  payload       Json?
  status        SecurityApprovalStatus     @default(PENDING)
  decidedBy     String?
  decisionNote  String?
  expiresAt     DateTime?
  createdAt     DateTime                   @default(now())
  decidedAt     DateTime?

  investigationSteps AiInvestigationStep[]

  @@index([workspaceId, status])
  @@map("security_approval_requests")
}

/// One row per workspace (upserted, not created-many) — enforced at the
/// Scope Engine gate, the ToolRunner/ScannerRunner entry points, and the
/// Approval Gate service. A workspace with no row here gets the
/// documented safe defaults (see `global-security-policy.defaults.ts`),
/// matching the "absence of config means safe default, not unrestricted"
/// posture `QuotaService` already established in Module 15.
model GlobalSecurityPolicy {
  id                    String   @id @default(uuid())
  workspaceId           String   @unique
  maxScanRatePerMinute  Int?
  maxConcurrentJobs     Int?
  allowedTools          Json?
  blockedTools          Json?
  allowedTargetTypes    Json?
  requireApprovalFor    Json?
  dataRetentionDays     Int?
  evidenceRetentionDays Int?
  aiToolPermissions     Json?
  pluginPermissions     Json?
  updatedBy             String
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@map("global_security_policies")
}

// --- Public sharing -------------------------------------------------------------

enum ShareResourceType {
  REPORT
  FINDING
  EVIDENCE
  DASHBOARD
  PROJECT
}

enum SharePermission {
  VIEW
  COMMENT
}

/// `tokenHash` (sha256 of the raw bearer token) is the only persisted
/// form of the secret — mirrors ApiKey's `keyHash` pattern
/// (api-keys.commands.ts / api-key-auth.guard.ts): the raw token is
/// generated, returned to the caller exactly once at creation time, and
/// never stored or logged anywhere. Lookups on public access always hash
/// the presented token and query by that hash, so a stolen/leaked DB
/// snapshot can never be used to derive working share links, and a
/// timing-safe equality on a random 256-bit hash makes guessing
/// infeasible (non-enumerable). `tokenPrefix` (first 12 chars of the raw
/// token, e.g. `shl_xxxxxxxx`) exists purely for display/audit purposes
/// (so a user can recognize *which* link a log entry refers to) and is
/// never sufficient on its own to resolve a link.
model ShareLink {
  id             String            @id @default(uuid())
  workspaceId    String
  resourceType   ShareResourceType
  resourceId     String
  tokenHash      String            @unique
  tokenPrefix    String
  passwordHash   String?
  permission     SharePermission   @default(VIEW)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdBy      String
  createdAt      DateTime          @default(now())
  lastAccessedAt DateTime?
  accessCount    Int               @default(0)

  @@index([workspaceId, resourceType, resourceId])
  @@map("share_links")
}

// --- Extension API registry -------------------------------------------------------

/// Mirrors `packages/shared/src/extension-api.ts`'s `ExtensionType` union
/// exactly. `MARKETPLACE_PLUGIN` registrations are expected to carry a
/// `pluginInstallationId` pointing at an existing `PluginInstallation`
/// row (the real M13 marketplace install) rather than duplicating plugin
/// state here — the other six types are lighter-weight, code-level
/// extension points with no marketplace publishing pipeline behind them.
enum ExtensionType {
  RECON_PROVIDER
  SCANNER_PROVIDER
  INTELLIGENCE_PROVIDER
  AI_AGENT
  REPORT_TEMPLATE
  WORKFLOW_NODE
  MARKETPLACE_PLUGIN
}

/// Mirrors `ExtensionPermission` in the same shared file — a closed,
/// declared vocabulary. Stored as `String[]` (like `PluginVersion.
/// permissions`) rather than a Postgres enum array so new permissions
/// can be added without a migration; the closed-world check happens in
/// application code (`ExtensionPermissionEnforcer`), not at the DB layer.
model ExtensionRegistration {
  id                   String        @id @default(uuid())
  workspaceId          String
  name                 String
  version              String
  type                 ExtensionType
  permissions          String[]
  capabilities         String[]
  entrypoint           String
  metadata             Json?
  enabled              Boolean       @default(true)
  /// Only meaningful when `type == MARKETPLACE_PLUGIN`; null otherwise.
  /// Not a Prisma `@relation` (consistent with this module's other new
  /// models this session — Watcher/Reaction/ShareLink/
  /// ResearcherMemoryEntry — which use plain FK columns rather than
  /// growing the User/Workspace models' relation-array lists further).
  pluginInstallationId String?
  registeredBy         String
  registeredAt         DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([workspaceId, name, version])
  @@index([workspaceId, type, enabled])
  @@map("extension_registrations")
}

// --- AI Investigation Mode -------------------------------------------------------

/// Module 16 — task #398. Renamed from an earlier PLANNING-first draft
/// (see git history) to match the spec's explicit 8-state lifecycle
/// literally: DRAFT (plan being composed) -> AWAITING_APPROVAL (submitted,
/// SecurityApprovalRequest created) -> APPROVED (approval granted, not yet
/// started) -> RUNNING -> PAUSED/COMPLETED/FAILED/CANCELLED. APPROVED is
/// deliberately a distinct state from RUNNING so "approved but nothing
/// executed yet" is observable — matters because the Scope Engine and
/// ToolRunner gate is re-checked at RUNNING transition time, not baked
/// into the approval decision.
enum AiInvestigationStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

/// A controlled-autonomy session: `AiInvestigationOrchestratorService`
/// composes a plan (reusing Module 11's `AgentOrchestratorService` task
/// decomposition, never a parallel planner), the plan sits in
/// `AWAITING_APPROVAL` behind a `SecurityApprovalRequest` until the user
/// approves it, and every tool-executing step still passes through the
/// Scope Engine and ToolRunner allowlist exactly like a manually-started
/// job would — this model records the session, it does not grant it any
/// bypass.
model AiInvestigationSession {
  id                String                  @id @default(uuid())
  workspaceId       String
  projectId         String
  targetId          String
  researchSessionId String?
  goal              String
  status            AiInvestigationStatus   @default(DRAFT)
  plan              Json?
  approvalRequestId String?
  failureReason     String?
  createdBy         String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  completedAt       DateTime?

  steps AiInvestigationStep[]

  @@index([workspaceId, status])
  @@index([targetId])
  @@map("ai_investigation_sessions")
}

enum AiInvestigationStepStatus {
  PENDING
  AWAITING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model AiInvestigationStep {
  id                 String                     @id @default(uuid())
  sessionId          String
  stepIndex          Int
  kind               String
  description        String
  toolName           String?
  status             AiInvestigationStepStatus  @default(PENDING)
  approvalRequestId  String?
  input              Json?
  output             Json?
  errorMessage       String?
  startedAt          DateTime?
  finishedAt         DateTime?

  session          AiInvestigationSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvalRequest  SecurityApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@unique([sessionId, stepIndex])
  @@map("ai_investigation_steps")
}

// --- AI Memory (researcher memory) ------------------------------------------------

enum ResearcherMemoryKind {
  PREFERENCE
  PROJECT_CONTEXT
  NOTE
  IMPORTANT_FINDING
  DECISION
  CUSTOM_INSTRUCTION
}

/// The user-facing CRUD surface for "AI Memory" (editable/searchable/
/// deletable/exportable) — mirrored into `AiMemoryChunk` (sourceType
/// `RESEARCHER_MEMORY`) on write so it's retrievable by the existing RAG
/// layer instead of a second retrieval mechanism.
model ResearcherMemoryEntry {
  id          String                @id @default(uuid())
  workspaceId String
  userId      String
  kind        ResearcherMemoryKind
  title       String
  content     String
  tags        String[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([workspaceId, userId, kind])
  @@map("researcher_memory_entries")
}

// --- Collaboration extensions: watchers & reactions --------------------------------

/// Shared by Watcher/Reaction so both extend to any future entity kind
/// without a schema change — currently used for BugBountyFinding and
/// Comment, the two entities Module 9's collaboration layer already
/// supports comments/mentions/assignments on.
enum CollaborationEntityType {
  BUGBOUNTY_FINDING
  BUG_REPORT
  COMMENT
  RESEARCH_SESSION
  // Module 17 — Incident Management (task #470): incidents reuse the
  // existing Watcher/Reaction/Comment collaboration layer instead of a
  // parallel incident-comments mechanism.
  INCIDENT
}

model Watcher {
  id         String                  @id @default(uuid())
  entityType CollaborationEntityType
  entityId   String
  userId     String
  createdAt  DateTime                @default(now())

  @@unique([entityType, entityId, userId])
  @@index([userId])
  @@map("watchers")
}

model Reaction {
  id         String                  @id @default(uuid())
  entityType CollaborationEntityType
  entityId   String
  userId     String
  emoji      String
  createdAt  DateTime                @default(now())

  @@unique([entityType, entityId, userId, emoji])
  @@index([entityType, entityId])
  @@map("reactions")
}

// =============================================================================
// Module 17 — Security Operations Center, Threat Intelligence & Autonomous
// Research Platform. Builds on Module 16's Asset Graph / Change Detection /
// Correlation Engine / Risk Scoring / AI Investigation Mode / Approval Gates
// rather than duplicating them — see the doc comments on each extended enum
// above (AssetGraphNodeType, ChangeDetectionEventType, CollaborationEntityType,
// AttachableType, CveRecord) for the specific reuse decisions. New models
// below are the genuinely new domain: asset ownership, continuous-monitoring
// policy, the global threat-intelligence cache, its workspace-scoped
// correlation (ThreatMatch — same "global cache + workspace-scoped match"
// shape as CveRecord/CveMatch above), incidents, remediation, SLA, Risk
// Engine v2's factor history, and automation rules.
// =============================================================================

// --- Asset Ownership (task #462, spec section 3) --------------------------------

enum BusinessCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Deliberately NOT a column on `AssetGraphNode` — that model is a
/// rebuildable *cache* (`AssetGraphService.rebuild()` deletes and
/// recreates every row for a target on every rebuild; see its own doc
/// comment), so ownership metadata living there would be silently wiped
/// on the next recon scan. This table is keyed instead by the same
/// stable business identity `AssetGraphNode` uses for its own dedup
/// (`targetId` + `nodeType` + `refId`), so ownership survives graph
/// rebuilds even though the `AssetGraphNode.id` backing it does not.
/// `environment` reuses `TargetEnvironment` (extended with `TEST` above)
/// rather than a second environment enum.
model AssetOwnership {
  id                  String              @id @default(uuid())
  workspaceId         String
  targetId            String
  nodeType            AssetGraphNodeType
  refId               String
  owner               String?
  team                String?
  department          String?
  contact             String?
  environment         TargetEnvironment   @default(UNKNOWN)
  businessCriticality BusinessCriticality @default(MEDIUM)
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([targetId, nodeType, refId])
  @@index([workspaceId, businessCriticality])
  @@map("asset_ownerships")
}

// --- Continuous Attack Surface Monitoring (task #463, spec section 4) -----------

enum MonitoringTrigger {
  SCHEDULED
  MANUAL
  EVENT_TRIGGERED
}

enum MonitoringJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// A *policy* row, not an execution engine — `ContinuousMonitoringService`
/// resolves a due `MonitoringJob` into the exact same `ReconJob`/
/// `JobQueue`/`ToolRunner` path a manually-started recon scan already
/// uses (see spec section 4's own instruction not to build a second
/// execution engine), then hands the completed scan to the existing
/// `ChangeDetectionService.diff()` — `lastReconJobId` is a loose
/// (non-relation) pointer to the `ReconJob` that produced the most
/// recent `ChangeDetectionEvent` batch for this policy, mirroring the
/// loose-reference convention `Attachment.attachableId` already
/// established for polymorphic/optional back-references.
model MonitoringJob {
  id             String               @id @default(uuid())
  workspaceId    String
  projectId      String
  targetId       String
  trigger        MonitoringTrigger    @default(SCHEDULED)
  cronExpression String?
  enabled        Boolean              @default(true)
  status         MonitoringJobStatus  @default(PENDING)
  lastReconJobId String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([targetId, trigger])
  @@index([workspaceId, enabled, nextRunAt])
  @@map("monitoring_jobs")
}

// --- Threat Intelligence — global cache (task #466, spec sections 6-9) ----------
//
// `workspaceId` is nullable and deliberately means two different things,
// mirroring `CveRecord`'s existing "global, shared, no workspace column"
// posture for public feed data while still giving multi-tenant isolation
// to private data:
//   - `workspaceId: null`  -> public feed data (CISA KEV, NVD, OSV, GitHub
//     Advisories, and any other feed sourced from public/shared
//     `ThreatIntelSourceType`s) — visible to every workspace, the same way
//     `CveRecord` already is. This is correct sharing, not a leak: the
//     same CVE-2024-xxxx or the same CISA KEV entry IS the same public
//     fact regardless of which workspace looks it up.
//   - `workspaceId: <uuid>` -> private data (an operator's own STIX/TAXII
//     feed, a manual import, workspace-specific research) — visible only
//     to that workspace. Every query in this domain filters
//     `WHERE workspaceId = :callerWorkspaceId OR workspaceId IS NULL`,
//     never bare `findMany()` — this is the mechanism the multi-tenant
//     isolation tests (task #488) exercise against.

enum IndicatorType {
  IP
  DOMAIN
  URL
  HASH
  EMAIL
  CVE
  CPE
  ASN
  CERTIFICATE
  FILE
  MALWARE_FAMILY
}

enum IndicatorStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

model ThreatActor {
  id          String    @id @default(uuid())
  workspaceId String?
  name        String
  aliases     String[]
  description String?
  source      String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  tags        String[]
  cachedAt    DateTime  @default(now())

  @@index([workspaceId, name])
  // Task #495 (database review): `listActors` (threat-intel-catalog.service.ts)
  // orders by `lastSeenAt DESC` — the pre-existing `[workspaceId, name]` index
  // exists for the import upsert's `findFirst({workspaceId, name})` lookup and
  // doesn't serve this read path. Additive index, does not replace the
  // existing one.
  @@index([workspaceId, lastSeenAt])
  @@map("threat_actors")
}

model ThreatCampaign {
  id          String    @id @default(uuid())
  workspaceId String?
  name        String
  description String?
  source      String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  tags        String[]
  cachedAt    DateTime  @default(now())

  @@index([workspaceId, name])
  // Task #495: same rationale as `ThreatActor.@@index([workspaceId, lastSeenAt])`
  // above — `listCampaigns` orders by `lastSeenAt DESC`.
  @@index([workspaceId, lastSeenAt])
  @@map("threat_campaigns")
}

/// The core threat-intel primitive. `confidence` (0-1) and `source` are
/// always shown alongside `value` wherever this is rendered (spec section
/// 8's explicit "do not automatically treat an indicator as malicious
/// solely because it exists in a feed") — display logic, not something
/// enforced by the schema, but the fields exist specifically to make that
/// display possible.
model Indicator {
  id          String           @id @default(uuid())
  workspaceId String?
  type        IndicatorType
  value       String
  status      IndicatorStatus  @default(ACTIVE)
  confidence  Float            @default(0.5)
  source      String
  description String?
  firstSeenAt DateTime         @default(now())
  lastSeenAt  DateTime         @default(now())
  expiresAt   DateTime?
  tags        String[]
  createdBy   String?
  cachedAt    DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  matches ThreatMatch[]

  @@unique([workspaceId, type, value])
  @@index([type, status])
  @@index([workspaceId, status])
  @@map("indicators")
}

model ThreatReport {
  id          String    @id @default(uuid())
  workspaceId String?
  title       String
  summary     String
  source      String
  url         String?
  publishedAt DateTime?
  tags        String[]
  cachedAt    DateTime  @default(now())

  @@index([workspaceId, publishedAt])
  @@map("threat_reports")
}

/// `externalId` is the technique's id in whatever taxonomy it came from
/// (e.g. MITRE ATT&CK "T1190") — free text, not an enum, same rationale
/// as `BugBountyFinding.capec` (the taxonomy is externally maintained and
/// changes independently of this schema).
model ThreatTechnique {
  id          String   @id @default(uuid())
  workspaceId String?
  externalId  String
  name        String
  description String?
  tactic      String?
  source      String
  cachedAt    DateTime @default(now())

  @@unique([workspaceId, externalId])
  @@map("threat_techniques")
}

/// A generic, polymorphic edge between any two threat-intel objects
/// (actor->campaign, campaign->indicator, indicator->technique, etc.) —
/// STIX's own relationship model is exactly this shape (typed edges
/// between arbitrarily-typed objects), so `sourceType`/`targetType` are
/// free-text type discriminators (e.g. "THREAT_ACTOR", "INDICATOR") and
/// `relationType` is free-text too (STIX relationship names like
/// "uses"/"attributed-to"/"indicates" are numerous and externally
/// standardized) rather than closed enums — same "loose reference, not a
/// DB-level relation" posture `Attachment.attachableId` already
/// established for a table that needs to point at more parent types than
/// a real FK can express.
model ThreatRelationship {
  id           String   @id @default(uuid())
  workspaceId  String?
  sourceType   String
  sourceId     String
  targetType   String
  targetId     String
  relationType String
  confidence   Float    @default(0.5)
  source       String
  createdAt    DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  // Module 18 — task #508 (database reliability review). Per-workspace
  // relationship listing had no covering index (global rows use
  // workspaceId: null, same convention as Indicator).
  @@index([workspaceId])
  @@map("threat_relationships")
}

enum ThreatIntelSourceType {
  CISA_KEV
  NVD
  OSV
  GITHUB_ADVISORIES
  VENDOR_ADVISORY
  STIX_TAXII
  OPERATOR_FEED
  MANUAL_IMPORT
}

enum ThreatIntelImportStatus {
  SUCCEEDED
  PARTIAL
  FAILED
}

/// One row per import run (scheduled public-feed sync or a workspace's
/// own manual/STIX-TAXII upload) — `rejectedCount`/`rejectionSample`
/// exist specifically so a malformed/malicious feed payload (spec section
/// 38: "threat intelligence input must be treated as untrusted data")
/// leaves an audit trail of what was refused, not just what succeeded.
model ThreatIntelImportLog {
  id              String                   @id @default(uuid())
  workspaceId     String?
  sourceType      ThreatIntelSourceType
  status          ThreatIntelImportStatus
  importedCount   Int                      @default(0)
  rejectedCount   Int                      @default(0)
  rejectionSample Json?
  errorSummary    String?
  importedBy      String?
  startedAt       DateTime                 @default(now())
  finishedAt      DateTime?

  @@index([workspaceId, sourceType, startedAt])
  @@map("threat_intel_import_logs")
}

// --- Threat Intelligence correlation (task #469, spec section 10) --------------
//
// `ThreatMatch` is this domain's `CveMatch` equivalent: the workspace-
// scoped correlation of a global `Indicator` against something this
// workspace owns (an asset, a finding). Always workspace-scoped —
// unlike `Indicator` above, a match is never shared across tenants.

enum ThreatMatchAnalystStatus {
  NEW
  UNDER_REVIEW
  CONFIRMED
  FALSE_POSITIVE
  IGNORED
}

/// Deliberately does not imply compromise (spec section 10: "do NOT
/// automatically declare compromise") — `analystStatus` starts at `NEW`
/// and only a human (or the AI SOC Analyst, itself proposal-only per
/// section 15) moves it to `CONFIRMED`.
model ThreatMatch {
  id             String                   @id @default(uuid())
  workspaceId    String
  projectId      String?
  targetId       String?
  indicatorId    String
  assetNodeType  AssetGraphNodeType?
  assetRefId     String?
  findingId      String?
  confidence     Float
  source         String
  evidence       Json?
  analystStatus  ThreatMatchAnalystStatus @default(NEW)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, analystStatus])
  @@index([indicatorId])
  // Task #495: `listMatchesForTarget` (threat-match.service.ts) does
  // `where: { targetId }, orderBy: { confidence: 'desc' }` — widens the
  // pre-existing lone `[targetId]` index to `[targetId, confidence]`,
  // which still serves every plain `targetId`-only lookup (leftmost-
  // prefix match) while also covering the sort column, so the old
  // single-column index is redundant and dropped rather than duplicated.
  @@index([targetId, confidence])
  @@map("threat_matches")
}

// --- Incident Management (task #470, spec sections 11-14) -----------------------

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINMENT
  ERADICATION
  RECOVERY
  RESOLVED
  CLOSED
  REOPENED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// `severityFactors` stores the explainability breakdown spec section 12
/// requires (impact/confidence/asset criticality/exploitability/exposure/
/// threat-intel relevance) as structured JSON rather than six separate
/// nullable columns — matches the `mitreAttack`/`cvssBreakdown` precedent
/// on `BugBountyFinding` (descriptive, not filtered/queried at scale).
/// Never an opaque AI-only score (section 12) — the AI SOC Analyst
/// (task #471) proposes values for this breakdown, it does not compute a
/// hidden number.
model Incident {
  id          String           @id @default(uuid())
  workspaceId String
  projectId   String
  title       String
  description String
  severity    IncidentSeverity
  status      IncidentStatus   @default(OPEN)
  severityFactors Json?
  reporterId  String
  assigneeId  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?

  timeline        IncidentTimelineEvent[]
  assetLinks      IncidentAssetLink[]
  findingLinks    IncidentFindingLink[]
  indicatorLinks  IncidentIndicatorLink[]
  evidenceLinks   IncidentEvidenceLink[]
  sessionLinks    IncidentResearchSessionLink[]
  investigationSessions IncidentInvestigationSession[]
  playbookLinks   IncidentPlaybookLink[]

  @@index([workspaceId, status])
  @@index([workspaceId, severity])
  @@index([assigneeId])
  // Task #495: `IncidentsService.listForWorkspace` filters by
  // `workspaceId` + optional `projectId` and always orders by
  // `createdAt DESC` — neither is covered by the status/severity
  // composites above, so the filterless-or-projectId-only case (and the
  // ownership-check reverse lookups other M17 services do by
  // workspaceId+projectId) falls back to a full workspace scan + sort.
  @@index([workspaceId, projectId])
  @@index([workspaceId, createdAt])
  @@map("incidents")
}

enum IncidentTimelineEventType {
  CREATED
  FINDING_LINKED
  INDICATOR_LINKED
  ASSET_LINKED
  EVIDENCE_ADDED
  COMMENT
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  AI_ANALYSIS
  APPROVAL
  CONTAINMENT
  RESOLUTION
  /// Module 17 — task #473 (Defensive Security Playbooks). Written by
  /// `IncidentPlaybooksService` when a playbook run is started against
  /// this incident — never by the Playbook engine itself, which has no
  /// knowledge of incidents (see `IncidentPlaybookLink`'s doc comment).
  PLAYBOOK_EXECUTED
}

/// Append-only (spec section 13: "must be immutable/auditable") — no
/// `updatedAt`, and application code must never `update()`/`delete()` a
/// row here, only `create()`. Enforced at the service layer (Prisma
/// itself has no immutability constraint), same posture as
/// `AuditEvent`/`ActivityEvent` elsewhere in this schema.
model IncidentTimelineEvent {
  id          String                     @id @default(uuid())
  incidentId  String
  eventType   IncidentTimelineEventType
  actorUserId String?
  description String
  metadata    Json?
  createdAt   DateTime                   @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_timeline_events")
}

model IncidentAssetLink {
  id         String             @id @default(uuid())
  incidentId String
  targetId   String
  nodeType   AssetGraphNodeType
  refId      String
  linkedBy   String?
  linkedAt   DateTime           @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, targetId, nodeType, refId])
  @@map("incident_asset_links")
}

model IncidentFindingLink {
  id         String   @id @default(uuid())
  incidentId String
  findingId  String
  linkedBy   String?
  linkedAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, findingId])
  @@map("incident_finding_links")
}

model IncidentIndicatorLink {
  id          String   @id @default(uuid())
  incidentId  String
  indicatorId String
  linkedBy    String?
  linkedAt    DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, indicatorId])
  @@map("incident_indicator_links")
}

/// Links an existing `Evidence` row (never a second evidence store — spec
/// section 14: "reuse existing Evidence infrastructure") to an incident.
/// A join table rather than a direct FK on `Evidence` because `Evidence`
/// is already project/target-scoped and one piece of evidence can
/// legitimately be relevant to more than one incident.
model IncidentEvidenceLink {
  id         String   @id @default(uuid())
  incidentId String
  evidenceId String
  linkedBy   String?
  linkedAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([incidentId, evidenceId])
  @@map("incident_evidence_links")
}

model IncidentResearchSessionLink {
  id                String   @id @default(uuid())
  incidentId        String
  researchSessionId String
  linkedBy          String?
  linkedAt          DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, researchSessionId])
  @@map("incident_research_session_links")
}

// --- AI Investigation Workflow (task #472) — defensive lifecycle extension --------

/// Defensive counterpart to `AiInvestigationSession` (Module 16, offensive
/// recon/vuln-scan orchestration against a `Target`). This session type
/// is scoped to an `Incident` instead, and — unlike the offensive
/// version — every step kind is a read-only investigative action
/// (AI analysis, threat-intel lookup, correlation review, evidence
/// review); none of them dispatch a job that mutates external systems or
/// requires re-checking `ScopeEngineService`/`GlobalSecurityPolicyService`
/// tool permissions, because no ToolRunner-backed tool is ever invoked.
/// Same 8-state lifecycle as `AiInvestigationStatus` (kept as a separate
/// enum so the two lifecycles can diverge independently without
/// cross-module coupling) and the same reuse of `SecurityApprovalService`
/// for the approval gate (spec: "AI must NOT execute tools without
/// permission/approval" — applied here even though the steps are
/// read-only, so an incident's investigative activity stays auditable
/// and never silently AI-initiated).
enum IncidentInvestigationStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model IncidentInvestigationSession {
  id                String                       @id @default(uuid())
  workspaceId       String
  incidentId        String
  goal              String
  status            IncidentInvestigationStatus  @default(DRAFT)
  plan              Json?
  approvalRequestId String?
  failureReason     String?
  createdBy         String
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  completedAt       DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  steps    IncidentInvestigationStep[]

  @@index([workspaceId, incidentId])
  @@index([workspaceId, status])
  @@map("incident_investigation_sessions")
}

enum IncidentInvestigationStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// `kind` is a plain String (not an enum), mirroring
/// `AiInvestigationStep.kind` — validated at the service layer against a
/// fixed allowlist (AI_ANALYSIS/THREAT_INTEL_LOOKUP/CORRELATION_REVIEW/
/// EVIDENCE_REVIEW/MANUAL_REVIEW) so new read-only step kinds can be
/// added without a migration, while an AI-proposed kind outside the
/// allowlist is always downgraded to MANUAL_REVIEW rather than executed.
model IncidentInvestigationStep {
  id           String                            @id @default(uuid())
  sessionId    String
  stepIndex    Int
  kind         String
  description  String
  status       IncidentInvestigationStepStatus  @default(PENDING)
  output       Json?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?

  session IncidentInvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepIndex])
  @@map("incident_investigation_steps")
}

// --- Defensive Security Playbooks (task #473) — extends the Module 16 -----------
// -- Playbook engine, never rewrites it: `IncidentPlaybookLink` is a pure join --
// -- table recording that a `PlaybookExecution` (Module 16's existing execution --
// -- engine, entirely untouched by this task) was run in the context of an -----
// -- Incident. `PlaybookExecution` itself has no `incidentId` column and no ----
// -- knowledge that Incidents exist — `IncidentPlaybooksService` resolves a ----
// -- real `Target` from the incident's linked assets (`IncidentAssetLink`) and --
// -- calls the existing `PlaybookExecutionService.start()` unmodified, then ----
// -- records the link here and appends one `PLAYBOOK_EXECUTED` timeline event. --

/// See doc comment above. `executionId` deliberately has no formal Prisma
/// relation to `PlaybookExecution` (plain String, like
/// `AutomationRuleExecutionLog.approvalRequestId` elsewhere in this
/// schema) — avoids adding a back-relation array to a Module 16 model,
/// keeping this task's changes additive-only from that model's
/// perspective.
model IncidentPlaybookLink {
  id          String   @id @default(uuid())
  incidentId  String
  executionId String
  playbookId  String
  linkedBy    String?
  linkedAt    DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, executionId])
  @@index([executionId])
  @@map("incident_playbook_links")
}

// --- Remediation tracking & verification (task #477, spec sections 21-22) ------

enum RemediationStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  READY_FOR_VERIFICATION
  VERIFIED
  CLOSED
}

enum RemediationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model RemediationTask {
  id            String              @id @default(uuid())
  workspaceId   String
  projectId     String
  findingId     String?
  incidentId    String?
  assetNodeType AssetGraphNodeType?
  assetRefId    String?
  owner         String?
  team          String?
  priority      RemediationPriority @default(MEDIUM)
  dueDate       DateTime?
  status        RemediationStatus   @default(OPEN)
  notes         String?
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  closedAt      DateTime?

  evidenceLinks RemediationEvidenceLink[]

  @@index([workspaceId, status])
  @@index([findingId])
  @@index([incidentId])
  // Task #495: same gap as `Incident` above — `RemediationService
  // .listForWorkspace` filters by workspaceId + optional projectId and
  // orders by `createdAt DESC`.
  @@index([workspaceId, projectId])
  @@index([workspaceId, createdAt])
  @@map("remediation_tasks")
}

model RemediationEvidenceLink {
  id                String   @id @default(uuid())
  remediationTaskId String
  evidenceId        String
  linkedBy          String?
  linkedAt          DateTime @default(now())

  remediationTask RemediationTask @relation(fields: [remediationTaskId], references: [id], onDelete: Cascade)
  evidence        Evidence        @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([remediationTaskId, evidenceId])
  @@map("remediation_evidence_links")
}

/// Spec section 22's own finding-verification lifecycle (OPEN ->
/// FIXED_CLAIMED -> VERIFICATION -> VERIFIED -> CLOSED) is distinct in
/// meaning from `RemediationStatus` above (that's the remediation *task's*
/// project-management state; this is the *finding's* own claim-then-prove
/// state) and distinct from `BugBountyFindingStage` (the bug-bounty
/// platform-submission workflow) — added as new columns on
/// `BugBountyFinding` rather than a new model, following the same
/// additive-columns precedent as this model's existing `cve`/`epss`/
/// `cvssBreakdown` fields from Module 16. See the field additions on
/// `BugBountyFinding` below.
enum FindingVerificationStatus {
  OPEN
  FIXED_CLAIMED
  VERIFICATION
  VERIFIED
  CLOSED
}

// --- SLA Engine (task #478, spec section 23) -------------------------------------
//
// A `SlaPolicy` model already exists (Module 10 — Advanced Analytics),
// keyed by `(organizationId, workspaceId, severity: VulnFindingSeverity)`
// with `targetHours` — it already IS the "workspace-specific SLA policy"
// spec section 23 asks for, computed at read time against
// `BugBountyFinding` timestamps by the Analytics module (see that
// model's own doc comment). Reused as-is here rather than duplicated;
// `Incident.severity` (`IncidentSeverity`, 4 levels) maps 1:1 onto
// `VulnFindingSeverity`'s LOW/MEDIUM/HIGH/CRITICAL at the service layer
// when an incident's SLA clock starts (incidents never use the fifth,
// finding-only `INFO` level). What genuinely doesn't exist yet — and is
// new here — is a *persisted event log* of SLA clocks actually
// starting/breaching/resolving; the existing policy was deliberately
// read-time-only ("no new finding-level storage needed"), which doesn't
// give the Notification Engine (task #482) or SOC Event Bus (task #486)
// anything to subscribe to. `SlaEvent` closes that gap without touching
// the existing `SlaPolicy` model or its Analytics consumer.

enum SlaEventType {
  STARTED
  BREACHED
  RESOLVED
}

model SlaEvent {
  id          String       @id @default(uuid())
  workspaceId String
  incidentId  String?
  findingId   String?
  policyId    String
  eventType   SlaEventType
  dueAt       DateTime
  occurredAt  DateTime?
  breached    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  policy SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([workspaceId, breached])
  @@index([incidentId])
  @@index([findingId])
  // Task #495: `SlaService.checkForBreaches` — called from
  // `SlaBreachCheckerService`'s poll loop, so this runs on every tick,
  // not just on a user request — does
  // `where: { eventType: 'STARTED', dueAt: { lt: now } }, orderBy: { dueAt: 'asc' }`.
  // None of the existing indexes cover `eventType`/`dueAt` at all; a
  // frequently-polled scan is exactly the query this platform's own
  // "no unbounded queries" performance principle (task #494) means to
  // catch, so it gets a dedicated index rather than relying on the
  // `take: 200` cap alone to keep it cheap.
  @@index([eventType, dueAt])
  @@map("sla_events")
}

// --- Risk Engine v2 (task #474, spec sections 18-19) -----------------------------

enum RiskTier {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Append-only history (spec section 18: "do not silently replace
/// previous scores") — `RiskScoringService`'s existing synchronous
/// `score()` method (Module 16, task #380) is unchanged and still used
/// for the immediate "what would this score" preview; this table is
/// where a persisted, timestamped snapshot goes whenever that score is
/// actually recorded against a finding/asset, so risk history is a query
/// (`ORDER BY computedAt DESC LIMIT 1` for "current", full list for
/// "trend") rather than a single mutable column that silently loses its
/// prior value. `factors` stores every input the transparent formula
/// used (cvss/epss/kev/assetCriticality/exposure/technologyConfidence/
/// findingConfidence/threatIntelSignal/exploitability/businessImpact/
/// ageDays/remediationStatus) so "why did this score this way" (spec
/// section 19) is always answerable from this one row.
model RiskFactorSnapshot {
  id            String              @id @default(uuid())
  workspaceId   String
  findingId     String?
  assetNodeType AssetGraphNodeType?
  assetRefId    String?
  riskScore     Float
  riskTier      RiskTier
  factors       Json
  computedBy    String?
  computedAt    DateTime            @default(now())

  @@index([workspaceId, findingId, computedAt])
  @@index([workspaceId, assetNodeType, assetRefId, computedAt])
  @@map("risk_factor_snapshots")
}

// --- Automation rules (task #487, spec section 32) --------------------------------

enum AutomationRuleTriggerType {
  KEV_MATCH
  INDICATOR_MATCH
  SLA_BREACH
  NEW_INTERNET_FACING_ASSET
  CUSTOM
}

enum AutomationRuleStatus {
  ENABLED
  DISABLED
}

/// `requiresApproval` defaults `true` deliberately — spec section 32 is
/// explicit that automation "must still pass permission/scope/approval/
/// policy" and "no rule may bypass security controls"; a rule whose
/// action would invoke a tool or launch a playbook is routed through the
/// existing `SecurityApprovalService`/`ScopeEngine` exactly like a
/// manually-triggered action would be, never a shortcut around them. Pure
/// notification-only actions (e.g. "SLA breached -> notify owner") are
/// the one class of action safe to run without an approval gate, and a
/// rule author can only turn `requiresApproval` off by explicitly
/// selecting a notification-only action kind in `actionConfig` — enforced
/// in the service layer, not the schema.
model AutomationRule {
  id               String                    @id @default(uuid())
  workspaceId      String
  name             String
  description      String?
  triggerType      AutomationRuleTriggerType
  triggerConfig    Json
  actionConfig     Json
  status           AutomationRuleStatus      @default(ENABLED)
  requiresApproval Boolean                   @default(true)
  createdBy        String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  executions AutomationRuleExecutionLog[]

  @@index([workspaceId, triggerType, status])
  @@map("automation_rules")
}

model AutomationRuleExecutionLog {
  id          String   @id @default(uuid())
  ruleId      String
  workspaceId String
  triggeredBy String
  outcome     String
  detail      Json?
  createdAt   DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  // Module 18 — task #508 (database reliability review). Per-workspace
  // execution-log listing had no covering index.
  @@index([workspaceId, createdAt])
  @@map("automation_rule_execution_logs")
}

// --- Security Reporting (task #481, spec section 24 — Report Builder) ------------
//
// Deliberately a NEW, workspace-scoped model rather than an extension of
// either existing report generator:
//   - `BugReport` is structurally bug-bounty-only — `programId` is a
//     required, cascading FK to `BugBountyProgram`, and its renderer
//     (`renderBugReportTemplate`) is typed to `{BugReport, BugBountyProgram,
//     BugBountyFinding}`. Attaching Incident/Indicator/RemediationTask
//     content there would mean adding a polymorphic source discriminator
//     to a Module 6/9 model this session must not rewrite.
//   - `EnterpriseReport` is the closer structural cousin (a JSON-content
//     snapshot, no per-report template), but it's Organization-scoped
//     (`organizationId`) — Enterprise Edition's tenant concept. Building
//     SOC reporting only on top of it would make it a paid-tier-only
//     feature, violating the Community Edition guarantee. `SecurityReport`
//     copies its shape (JSON content blob, no rendering pipeline needed
//     yet) but keys off `workspaceId` only, so a Community Edition
//     workspace (no Organization) can generate one.
// Content is a computed JSON snapshot built by composing the *existing*
// Incidents/SLA/Remediation/ThreatIntel/SecurityMetrics services — no
// duplicated aggregation logic, matching this session's "extend, don't
// rewrite" + "reuse existing report infrastructure" constraints applied
// at the pattern level (JSON-snapshot report) rather than the model level
// (a Module 6-owned table).

enum SecurityReportType {
  INCIDENT_SUMMARY
  THREAT_INTEL_SUMMARY
  POSTURE_SUMMARY
}

model SecurityReport {
  id            String             @id @default(uuid())
  workspaceId   String
  type          SecurityReportType
  title         String
  periodStart   DateTime?
  periodEnd     DateTime?
  contentJson   Json
  generatedBy   String?
  generatedByAi Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([workspaceId, type, createdAt])
  @@map("security_reports")
}
