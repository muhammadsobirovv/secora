// PentestHub AI — Auth + platform-foundation data model.
// See docs/modules/01-auth.md and docs/adr/0001-auth-module.md for rationale.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// `extensions = [vector]` (Module 5 / RAG) makes `prisma migrate dev` emit
// `CREATE EXTENSION IF NOT EXISTS vector` automatically. See AiMemoryChunk
// below for how the resulting `vector` Postgres type is used — Prisma
// Client has no native vector type, so that one column is written/read via
// $queryRaw/$executeRaw only (see PrismaAiMemoryRepository), same escape
// hatch this project already uses for anything Prisma Client can't type.
datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

/// A registered user account. Password auth and OAuth auth are both optional
/// per-user — passwordHash is null for OAuth-only accounts.
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String?
  displayName      String
  avatarUrl        String?
  emailVerified    Boolean    @default(false)
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  oauthAccounts           OAuthAccount[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  mfaFactor               MfaFactor?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfaChallengeTokens      MfaChallengeToken[]
  oauthExchangeCodes      OAuthExchangeCode[]
  auditEvents             AuditEvent[]
  userRoles               UserRole[]
  workspaceMemberships    WorkspaceMember[]
  apiKeys                 ApiKey[]
  preferences             UserPreferences?
  // Module 15 — additive back-relation.
  marketplacePublisherProfile MarketplacePublisher?

  projectsCreated     Project[]
  projectMemberships  ProjectMember[]
  projectFavorites    ProjectFavorite[]
  targetsCreated      Target[]
  notesAuthored       Note[]
  evidenceCreated     Evidence[]
  attachmentsUploaded Attachment[]
  activityEvents      ActivityEvent[]
  reconJobsRequested  ReconJob[]
  vulnScanJobsRequested VulnScanJob[]
  vulnScanTemplatesCreated VulnScanTemplate[]
  vulnFindingsCreated VulnFinding[]
  aiConversations     AiConversation[]
  // Module 11 — additive back-relations.
  orchestrationRunsRequested OrchestrationRun[]
  promptTemplatesCreated     PromptTemplate[]
  // Module 6 (Bug Bounty Workspace) additive back-relations.
  bugBountyProgramsCreated     BugBountyProgram[]
  bugBountyFindingsCreated     BugBountyFinding[]
  bugReportsCreated            BugReport[]
  payloadLibraryEntriesCreated PayloadLibraryEntry[]
  knowledgeBaseNotesAuthored   KnowledgeBaseNote[]
  bookmarks                    Bookmark[]
  bugBountyCalendarEventsCreated BugBountyCalendarEvent[]
  bugBountyNotifications       BugBountyNotification[]
  // Module 9 — additive back-relations.
  reportCustomTemplatesCreated ReportCustomTemplate[]
  workspaceInvitesSent         WorkspaceInvite[]        @relation("WorkspaceInviteInviter")
  workspaceInvitesAccepted     WorkspaceInvite[]        @relation("WorkspaceInviteAcceptedBy")
  commentsAuthored             Comment[]
  mentionsReceived             Mention[]
  assignmentsAssigned          Assignment[]             @relation("AssignmentAssignee")
  assignmentsGiven             Assignment[]             @relation("AssignmentAssigner")
  taskItemsAssigned            TaskItem[]               @relation("TaskItemAssignee")
  taskItemsCreated             TaskItem[]               @relation("TaskItemCreator")
  scheduledJobsCreated         ScheduledJob[]
  notificationChannelConfigs   NotificationChannelConfig[]
  webhookTokensCreated         WebhookToken[]
  // Module 10 — additive back-relations.
  organizationsCreated          Organization[]              @relation("OrganizationCreator")
  organizationMemberships       OrganizationMember[]
  departmentsManaged            Department[]                @relation("DepartmentManager")
  teamsLed                      Team[]                      @relation("TeamLead")
  organizationInvitesSent       OrganizationInvite[]         @relation("OrganizationInviteInviter")
  temporaryPermissionsReceived  TemporaryPermission[]        @relation("TemporaryPermissionUser")
  temporaryPermissionsGranted   TemporaryPermission[]        @relation("TemporaryPermissionGrantor")
  approvalRequestsMade          ApprovalRequest[]            @relation("ApprovalRequestRequester")
  approvalRequestsDecided       ApprovalRequest[]            @relation("ApprovalRequestDecider")
  pluginsAuthored                Plugin[]                     @relation("PluginAuthor")
  pluginInstallations            PluginInstallation[]         @relation("PluginInstaller")
  pluginRatings                  PluginRating[]                @relation("PluginRater")
  integrationConnectionsCreated  IntegrationConnection[]      @relation("IntegrationConnector")
  wikiPagesAuthored               WikiPage[]                   @relation("WikiPageAuthor")
  reviewQueueItemsSubmitted       ReviewQueueItem[]            @relation("ReviewQueueSubmitter")
  reviewQueueItemsAssigned        ReviewQueueItem[]            @relation("ReviewQueueAssignee")
  chatChannelsCreated              InternalChatChannel[]        @relation("ChatChannelCreator")
  chatMessagesAuthored             InternalChatMessage[]        @relation("ChatMessageAuthor")
  enterpriseReportsGenerated       EnterpriseReport[]           @relation("EnterpriseReportGenerator")
  complianceExportsRequested       ComplianceExportRequest[]    @relation("ComplianceExportRequester")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ---------------------------------------------------------------------------
// OAuth
// ---------------------------------------------------------------------------

/// A linked OAuth identity (Google, GitHub, ...). A user can link multiple providers.
model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

/// One-time code handed to the frontend after an OAuth callback, exchanged
/// for real tokens via POST /auth/oauth/exchange. Keeps access/refresh
/// tokens out of the redirect URL (browser history, referrer headers, logs).
model OAuthExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_exchange_codes")
}

// ---------------------------------------------------------------------------
// Sessions & tokens
// ---------------------------------------------------------------------------

/// One browser/app session tied to a specific device. Distinct from RefreshToken:
/// a session is the human-facing "device" record; a refresh token is the credential.
model Session {
  id           String    @id @default(uuid())
  userId       String
  deviceName   String
  ipAddress    String
  userAgent    String
  /// Parsed from userAgent at session-creation time (ua-parser-js). Nullable
  /// because parsing can fail on unusual/unknown user agents.
  browser      String?
  os           String?
  /// Geo-IP location, e.g. "City, Country". Left unpopulated for now — no
  /// geo-IP provider is configured in this environment. Column exists so a
  /// provider can be wired later without a migration.
  location     String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Refresh tokens are stored hashed (never plaintext) and rotated on every use.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  sessionId         String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// MFA
// ---------------------------------------------------------------------------

/// TOTP-based MFA factor. One per user for v1 (no backup-codes-as-separate-factor yet).
model MfaFactor {
  id          String    @id @default(uuid())
  userId      String    @unique
  secret      String
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes MfaBackupCode[]

  @@map("mfa_factors")
}

/// Individually hashed, single-use backup codes. Replaces a plain string
/// array so each code can be consumed exactly once and never stored in
/// plaintext.
model MfaBackupCode {
  id          String    @id @default(uuid())
  mfaFactorId String
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  mfaFactor MfaFactor @relation(fields: [mfaFactorId], references: [id], onDelete: Cascade)

  @@index([mfaFactorId])
  @@map("mfa_backup_codes")
}

/// Issued after password verification when MFA is enabled; consumed by
/// POST /auth/mfa/challenge to complete login.
model MfaChallengeToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenge_tokens")
}

// ---------------------------------------------------------------------------
// Email verification / password reset
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// RBAC foundation (Role / Permission / UserRole / RolePermission)
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Workspaces (Module 1: personal workspace at registration; Module 2:
// settings/avatar + the Projects/Targets/... foundation attaches here)
// ---------------------------------------------------------------------------

/// Every user gets one personal Workspace created at registration (see
/// docs/adr/0001-auth-module.md). Invites, switching, and multi-member
/// workflows beyond the OWNER/ADMIN/MEMBER foundation are future-module
/// work. `plan` is reserved for a future billing tier — unread by
/// anything this sprint, just avoids a migration on a large table later.
model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  avatarUrl   String?
  description String?
  plan        String?
  /// Module 10 — nullable tenant/team pointers. A Workspace created before
  /// Module 10 (or any personal workspace after it) has both `null`, and
  /// behaves exactly as it always has; setting them opts the workspace into
  /// the Organization -> Team hierarchy without changing anything about how
  /// Modules 1-9 read/write the workspace itself.
  organizationId String?
  teamId         String?
  // Module 15 — task #352 (demo mode). isDemo marks a workspace created by
  // POST /demo/session rather than registration — the sole switch
  // `resolveTargetForCaller` checks to reject new ReconJob/VulnScanJob
  // creation (demo workspaces only ever contain pre-seeded, already-
  // completed synthetic data; a public "try it" entry point must never be
  // able to trigger a real network scan against an arbitrary target).
  // demoExpiresAt drives DemoCleanupService's sweep — null for every
  // non-demo workspace.
  isDemo         Boolean   @default(false)
  demoExpiresAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)

  members        WorkspaceMember[]
  settings       WorkspaceSettings?
  projects       Project[]
  tags           Tag[]
  attachments    Attachment[]
  activityEvents ActivityEvent[]
  reconJobs      ReconJob[]
  reconFindings  ReconFinding[]
  vulnScanJobs      VulnScanJob[]
  vulnFindings      VulnFinding[]
  vulnScanTemplates VulnScanTemplate[]
  aiConversations   AiConversation[]
  aiMemoryChunks    AiMemoryChunk[]
  aiProviderCredentials AiProviderCredential[]
  // Module 11 — additive back-relations.
  orchestrationRuns OrchestrationRun[]
  promptTemplates   PromptTemplate[]
  // Module 6 (Bug Bounty Workspace) — additive back-relations, same
  // treatment every prior module received (see reconJobs/vulnFindings/
  // aiConversations above). No existing column or behavior changes.
  bugBountyPrograms      BugBountyProgram[]
  bugBountyFindings      BugBountyFinding[]
  bugReports             BugReport[]
  payloadLibraryEntries  PayloadLibraryEntry[]
  knowledgeBaseNotes     KnowledgeBaseNote[]
  bookmarks              Bookmark[]
  bugBountyCalendarEvents BugBountyCalendarEvent[]
  bugBountyNotifications BugBountyNotification[]
  // Module 9 — additive back-relations.
  reportCustomTemplates      ReportCustomTemplate[]
  workspaceInvites           WorkspaceInvite[]
  comments                   Comment[]
  assignments                Assignment[]
  taskItems                  TaskItem[]
  scheduledJobs              ScheduledJob[]
  notificationChannelConfigs NotificationChannelConfig[]
  webhookTokens              WebhookToken[]
  apiKeys                    ApiKey[]
  // Module 10 — additive back-relations.
  integrationConnections IntegrationConnection[]
  wikiPages              WikiPage[]
  reviewQueueItems       ReviewQueueItem[]
  chatChannels           InternalChatChannel[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceSettings {
  id                   String        @id @default(uuid())
  workspaceId          String        @unique
  defaultProjectStatus ProjectStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

model WorkspaceMember {
  id          String              @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole
  joinedAt    DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// REVIEWER/TRIAGER/MANAGER added in Module 9 (Bug Bounty Platform +
/// Collaboration + Reporting Suite) — additive values on top of Module 1's
/// OWNER/ADMIN/MEMBER foundation, not a replacement. MEMBER is kept as the
/// generic fallback role for workspaces that don't need the finer-grained
/// bug-bounty-specific roles; existing rows keep working unchanged.
/// Suggested permission shape (enforced in `collaboration/permissions.util.ts`,
/// not by the enum itself): OWNER > ADMIN > MANAGER > TRIAGER > REVIEWER >
/// MEMBER, where MANAGER can manage Programs/Automation/Collaboration,
/// TRIAGER can transition Finding/Report lifecycle stages, and REVIEWER has
/// read + comment access only.
enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MANAGER
  TRIAGER
  REVIEWER
  MEMBER
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// `visibility` is reserved for future access-control beyond
/// ProjectMember/WorkspaceMember — not enforced by any query this sprint.
/// `deletedAt` (soft delete) is independent of `status`: an ARCHIVED
/// project is still visible in an "archived" filter; a deleted one isn't
/// visible anywhere until restored... except deletion has no restore path
/// (only archive does) — see ProjectsModule README-equivalent (ADR 0002).
enum ProjectVisibility {
  PRIVATE
  WORKSPACE
  PUBLIC
}

model Project {
  id          String            @id @default(uuid())
  workspaceId String
  name        String
  description String?
  status      ProjectStatus     @default(ACTIVE)
  visibility  ProjectVisibility @default(WORKSPACE)
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator        User              @relation(fields: [createdBy], references: [id])
  members        ProjectMember[]
  favorites      ProjectFavorite[]
  targets        Target[]
  notes          Note[]
  evidence       Evidence[]
  tags           ProjectTag[]
  activityEvents ActivityEvent[]
  reconJobs      ReconJob[]
  reconFindings  ReconFinding[]
  vulnScanJobs   VulnScanJob[]
  vulnFindings   VulnFinding[]
  aiConversations AiConversation[]
  aiMemoryChunks  AiMemoryChunk[]
  // Module 11 — additive back-relation.
  orchestrationRuns OrchestrationRun[]
  // Module 6 (Bug Bounty Workspace) additive back-relations.
  bugBountyPrograms  BugBountyProgram[]
  bugBountyFindings  BugBountyFinding[]
  bugReports         BugReport[]
  knowledgeBaseNotes KnowledgeBaseNote[]
  // Module 9 — additive back-relations.
  scheduledJobs ScheduledJob[]
  taskItems     TaskItem[]

  @@index([workspaceId])
  @@map("projects")
}

enum ProjectMemberRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTOR)
  addedAt   DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// Per-user favorite — not a flat boolean on Project, since different
/// members of the same project favorite it independently.
model ProjectFavorite {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_favorites")
}

// ---------------------------------------------------------------------------
// Tags (workspace-scoped, reusable across Projects and Targets)
// ---------------------------------------------------------------------------

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectTags ProjectTag[]
  targetTags  TargetTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

model TargetTag {
  targetId String
  tagId    String

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([targetId, tagId])
  @@map("target_tags")
}

// ---------------------------------------------------------------------------
// Targets
// ---------------------------------------------------------------------------

enum TargetType {
  DOMAIN
  SUBDOMAIN
  URL
  IP_ADDRESS
  CIDR
  API
  MOBILE_APP
  INTERNAL_ASSET
}

enum TargetEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  // Module 17 — Security Asset Ownership (task #3) asks for a dedicated
  // TEST value distinct from DEVELOPMENT; additive, no existing value's
  // meaning changes. Reused directly by AssetOwnership.environment below
  // instead of a second environment enum.
  TEST
  UNKNOWN
}

enum TargetScopeStatus {
  IN_SCOPE
  OUT_OF_SCOPE
  PENDING_REVIEW
}

/// `value` holds the actual domain/IP/URL/CIDR/... string; `type` says how
/// to interpret it. `customFields` is a forward-compat escape hatch for
/// future-module per-target data without a schema change — still unused
/// by Recon (Module 3), which stores its structured results in
/// ReconFinding instead, keeping this field free for later modules.
model Target {
  id           String            @id @default(uuid())
  projectId    String
  type         TargetType
  value        String
  name         String?
  description  String?
  environment  TargetEnvironment @default(UNKNOWN)
  scopeStatus  TargetScopeStatus @default(PENDING_REVIEW)
  customFields Json?
  createdBy    String
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator              User           @relation(fields: [createdBy], references: [id])
  notes                Note[]
  evidence             Evidence[]
  tags                 TargetTag[]
  reconJobs            ReconJob[]
  reconFindings        ReconFinding[]
  promotedFromFindings ReconFinding[] @relation("ReconFindingPromotedTarget")
  vulnScanJobs         VulnScanJob[]
  vulnFindings         VulnFinding[]
  // Module 6 (Bug Bounty Workspace) additive back-relations.
  bugBountyProgramLinks BugBountyProgramTarget[]
  bugBountyFindings     BugBountyFinding[]
  knowledgeBaseNotes    KnowledgeBaseNote[]
  // Module 9 — additive back-relation.
  scheduledJobs         ScheduledJob[]

  @@index([projectId])
  @@index([type])
  @@map("targets")
}

// ---------------------------------------------------------------------------
// Notes (Markdown; optionally attached to a specific Target)
// ---------------------------------------------------------------------------

model Note {
  id        String    @id @default(uuid())
  projectId String
  targetId  String?
  title     String?
  content   String
  authorId  String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  Target? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([targetId])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

enum EvidenceType {
  SCREENSHOT
  HTTP_REQUEST
  HTTP_RESPONSE
  FILE
  LOG
  VIDEO
  // Module 4 (Vulnerability Engine) additions — purely additive, existing
  // values/usages (Recon) are untouched. See docs/adr/0004.
  PAYLOAD
  COMMAND
  // Module 16 additions — Evidence Workspace section asked for audio
  // capture and AI-analysis snapshots alongside the existing kinds.
  AUDIO
  AI_ANALYSIS
}

/// `textContent` holds HTTP request/response or log text captured inline;
/// screenshots/files/video are backed by an Attachment instead. `checksum`
/// (SHA-256 hex) is computed at upload time for file-backed evidence.
model Evidence {
  id          String       @id @default(uuid())
  projectId   String
  targetId    String?
  type        EvidenceType
  title       String
  description String?
  textContent String?
  checksum    String?
  /// Module 16 addition — where this evidence item was captured from
  /// (e.g. "browser-extension", "terminal-workspace", "ai-investigation",
  /// "manual-upload", "recon-tool:httpx") — the spec's Evidence Workspace
  /// section asks every item to record its source alongside the existing
  /// SHA-256/timestamp/author/related-finding fields (`checksum`/
  /// `createdAt`/`createdBy`/the various `*Links` relations below).
  source      String?
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target        Target?           @relation(fields: [targetId], references: [id], onDelete: SetNull)
  creator       User              @relation(fields: [createdBy], references: [id])
  reconToolRuns ReconJobToolRun[]
  vulnToolRuns  VulnScanJobToolRun[]
  vulnFindingsAsRequest    VulnFinding[] @relation("VulnFindingRequestEvidence")
  vulnFindingsAsResponse   VulnFinding[] @relation("VulnFindingResponseEvidence")
  vulnFindingsAsScreenshot VulnFinding[] @relation("VulnFindingScreenshotEvidence")
  vulnFindingsAsPayload    VulnFinding[] @relation("VulnFindingPayloadEvidence")
  vulnFindingsAsCommand    VulnFinding[] @relation("VulnFindingCommandEvidence")
  vulnFindingsAsRawOutput  VulnFinding[] @relation("VulnFindingRawOutputEvidence")
  // Module 6 (Bug Bounty Workspace) — many-to-many via join tables rather
  // than more named optional pointers, since a bug bounty finding/report
  // can carry an arbitrary number of screenshots/requests, unlike
  // VulnFinding's fixed six categories.
  bugBountyFindingLinks BugBountyFindingEvidence[]
  bugReportLinks        BugReportEvidence[]
  // Module 17 — Incident/Remediation evidence (tasks #470/#477): reuse
  // this same Evidence store via join tables rather than a second
  // evidence mechanism.
  incidentLinks         IncidentEvidenceLink[]
  remediationLinks      RemediationEvidenceLink[]

  @@index([projectId])
  @@index([targetId])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// Attachments (polymorphic — see docs/adr/0002-workspace-foundation-module.md)
// ---------------------------------------------------------------------------

enum AttachableType {
  WORKSPACE
  PROJECT
  TARGET
  NOTE
  EVIDENCE
  // Module 6 (Bug Bounty Workspace) additions — purely additive new enum
  // values, no existing value's meaning changes. Reuses the existing
  // polymorphic Attachment table instead of a second attachment mechanism
  // (Nothing should be duplicated).
  KNOWLEDGE_BASE_NOTE
  BUG_REPORT
  // Module 17 — Incident evidence (task #470/#14): lets incidents use the
  // existing generic Attachment mechanism for raw files, same as every
  // other attachable entity above — no second file-attachment path.
  INCIDENT
}

/// No DB-level FK to the attached-to row (attachableType/attachableId is a
/// loose reference, not a relation) — the parent-existence check happens
/// in the upload command handler, not the database. Deliberate: this is
/// the one relation in the schema that needs to point at five different
/// parent tables, which a real FK can't express. workspaceId is always
/// set (even when attachableType is TARGET/NOTE/etc.) so storage
/// ownership/quota tracking never needs to join through the polymorphic
/// reference.
model Attachment {
  id             String         @id @default(uuid())
  workspaceId    String
  attachableType AttachableType
  attachableId   String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  uploadedBy     String
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploadedBy], references: [id])

  @@index([attachableType, attachableId])
  @@index([workspaceId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Recon (Module 3) — see docs/adr/0003-recon-engine-module.md
// ---------------------------------------------------------------------------

enum ReconTool {
  NMAP
  SUBFINDER
  HTTPX
  DNSX
  NAABU
  WHATWEB
  ASSETFINDER
  GOWITNESS
  AMASS
  KATANA
  GAU
  WAYBACKURLS
  WHOIS
  ASN
}

enum ReconJobStatus {
  PENDING
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReconJobLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum ReconFindingType {
  SUBDOMAIN
  URL
  OPEN_PORT
  SERVICE
  TECHNOLOGY
  DNS_RECORD
  HTTP_HEADER
  CERTIFICATE
  SCREENSHOT
  SECURITY_HEADER
  WHOIS_RECORD
  ASN
}

/// One requested scan against one Target. `tools` is the immutable request
/// spec captured at creation time; per-tool *live* state lives in
/// ReconJobToolRun so a future "retry only the failed tools" doesn't need
/// to mutate the original request. workspaceId/projectId are denormalized
/// off target->project->workspace (same reasoning as Attachment.workspaceId
/// above) so the worker's claim/list queries never join through
/// Target/Project just to filter or authorize.
model ReconJob {
  id                String         @id @default(uuid())
  workspaceId       String
  projectId         String
  targetId          String
  tools             ReconTool[]
  status            ReconJobStatus @default(PENDING)
  retryCount        Int            @default(0)
  maxRetries        Int            @default(2)
  timeoutSeconds    Int            @default(600)
  nextAttemptAt     DateTime?
  claimedAt         DateTime?
  claimedBy         String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  error             String?
  requestedBy       String
  // Module 18 — task #505 (Request correlation/traceability). The
  // X-Request-Id of the HTTP request that created this job, captured at
  // creation time via getRequestId() (see CreateReconJobHandler) so a
  // worker-process log line for this job can be correlated back to the API
  // request that queued it, even though the worker never re-establishes
  // the original AsyncLocalStorage context. Nullable — populated on a
  // best-effort basis; never a security/authorization signal.
  requestId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target    Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  requester User              @relation(fields: [requestedBy], references: [id])
  toolRuns  ReconJobToolRun[]
  logs      ReconJobLog[]
  findings  ReconFinding[]

  // The worker's claim query: WHERE status IN ('PENDING','RETRYING') ORDER BY createdAt.
  @@index([status, createdAt])
  @@index([targetId])
  @@index([projectId])
  @@index([workspaceId])
  @@map("recon_jobs")
}

/// Per-tool execution state within a job — what the "progress" UI and the
/// worker's sequential per-tool loop both read/write.
model ReconJobToolRun {
  id                  String         @id @default(uuid())
  jobId               String
  tool                ReconTool
  status              ReconJobStatus @default(PENDING)
  startedAt           DateTime?
  completedAt         DateTime?
  exitCode            Int?
  findingsCount       Int            @default(0)
  errorMessage        String?
  rawOutputEvidenceId String?
  createdAt           DateTime       @default(now())

  job               ReconJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rawOutputEvidence Evidence?     @relation(fields: [rawOutputEvidenceId], references: [id], onDelete: SetNull)
  logs              ReconJobLog[]

  @@index([jobId])
  @@map("recon_job_tool_runs")
}

/// Append-only, source of truth for the SSE live-log stream. `seq` is a
/// separate monotonic cursor from `id` (a UUIDv4 PK isn't sortable, and
/// fast tool output can produce several rows within the same millisecond,
/// so `createdAt` alone isn't a safe "since" cursor either).
model ReconJobLog {
  id        String           @id @default(uuid())
  seq       BigInt           @unique @default(autoincrement())
  jobId     String
  toolRunId String?
  level     ReconJobLogLevel @default(INFO)
  message   String
  createdAt DateTime         @default(now())

  job     ReconJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  toolRun ReconJobToolRun? @relation(fields: [toolRunId], references: [id], onDelete: SetNull)

  @@index([jobId, seq])
  @@map("recon_job_logs")
}

/// Polymorphic, tool-agnostic result row — the "common schema" every tool
/// adapter's Normalizer writes into; a new tool needs no schema change,
/// only a new Normalizer producing rows in this shape. `data` holds the
/// full type-specific structured details; `value` is a short
/// human-readable summary for list views. Screenshots are the one type
/// that's file-backed: `data` holds only the *latest* pointer
/// (`{evidenceId, attachmentId, url}`); the full, non-overwritten capture
/// history lives in Evidence+Attachment instead (see ReconJobToolRun).
/// Deduplication is this table's unique constraint below plus an
/// upsert-on-conflict write, not separate application logic.
model ReconFinding {
  id               String           @id @default(uuid())
  jobId            String
  workspaceId      String
  projectId        String
  targetId         String
  type             ReconFindingType
  value            String
  data             Json
  source           ReconTool
  dedupKey         String
  firstSeenAt      DateTime         @default(now())
  lastSeenAt       DateTime         @default(now())
  promotedTargetId String?
  createdAt        DateTime         @default(now())

  job            ReconJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target         Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  promotedTarget Target?   @relation("ReconFindingPromotedTarget", fields: [promotedTargetId], references: [id], onDelete: SetNull)

  @@unique([targetId, type, dedupKey])
  @@index([jobId])
  @@index([targetId, type])
  @@index([projectId])
  // Module 18 — task #508 (database reliability review). workspaceId-only
  // list/count queries (e.g. workspace-wide finding totals/dashboards) had
  // no covering index — every other filter here already does via the
  // indexes above.
  @@index([workspaceId])
  @@map("recon_findings")
}

// ---------------------------------------------------------------------------
// Vulnerability Engine (Module 4) — see docs/adr/0004-vulnerability-engine-module.md
// Consumes Recon's Target assets and produces validated VulnFinding rows.
// Mirrors Module 3's job/worker architecture exactly (see that ADR for the
// rationale this module deliberately reuses rather than reinvents):
// ScanJob (request) -> ScanJobToolRun (per-scanner live state) -> ScanJobLog
// (SSE source of truth) -> VulnFinding (deduplicated result). Evidence is
// the existing Module 2 Evidence/Attachment pair, not a parallel table —
// HTTP request/response/payload/command/raw-output are all just text
// (Evidence.textContent); only a future visual scanner (ZAP) would ever
// need Evidence.type=SCREENSHOT + a real Attachment.
// ---------------------------------------------------------------------------

/// v1 adapters. SQLMap/XSStrike/Dalfox/Wapiti/OWASP ZAP are documented
/// extension points (see ScannerRunnerRegistry) but have no enum value yet
/// — adding one is a single-line addition here plus a migration, same as
/// any other new enum value; it does not by itself imply an adapter exists.
enum VulnScanner {
  NUCLEI
  FFUF
  DIRSEARCH
  FEROXBUSTER
  NIKTO
}

/// PAUSED is the one addition relative to ReconJobStatus (Module 3 has no
/// pause/resume) — see VulnScanJobExecutionService for how a pause differs
/// from a cancel (graceful: finishes the in-flight scanner, does not
/// AbortController.abort() it).
enum VulnScanJobStatus {
  PENDING
  RUNNING
  PAUSED
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum VulnScanJobLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum VulnFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VulnFindingStatus {
  NEW
  CONFIRMED
  DUPLICATE
  ACCEPTED_RISK
  FIXED
  FALSE_POSITIVE
}

/// How sure the *scanner* was, independent of the analyst's own
/// FindingStatus triage decision — e.g. Nuclei template matches are always
/// CONFIRMED (a template match is definitionally exact); a ffuf/dirsearch/
/// feroxbuster content-discovery hit is only ever MEDIUM (a 200/301 on a
/// guessed path is suggestive, not proof); Nikto's signature-based checks
/// vary per plugin and default to MEDIUM.
enum VulnFindingConfidence {
  LOW
  MEDIUM
  HIGH
  CONFIRMED
}

/// OWASP Top 10:2021 category identifiers. UNKNOWN covers findings a
/// scanner can't map to any category (most raw content-discovery hits).
enum OwaspCategory {
  A01_BROKEN_ACCESS_CONTROL
  A02_CRYPTOGRAPHIC_FAILURES
  A03_INJECTION
  A04_INSECURE_DESIGN
  A05_SECURITY_MISCONFIGURATION
  A06_VULNERABLE_OUTDATED_COMPONENTS
  A07_IDENTIFICATION_AUTH_FAILURES
  A08_SOFTWARE_DATA_INTEGRITY_FAILURES
  A09_LOGGING_MONITORING_FAILURES
  A10_SERVER_SIDE_REQUEST_FORGERY
  UNKNOWN
}

/// A reusable named preset of {scanners, per-scanner config} — "Start Scan"
/// can reference one instead of the caller re-specifying scanner options
/// every time. `config` is a free-form JSON map keyed by VulnScanner (e.g.
/// {"NUCLEI": {"severity": ["high","critical"]}, "FFUF": {"wordlist": "..."}}
/// ), read by each ScannerRunner via VulnScanJob.config at execution time —
/// adding a new scanner-specific option is never a schema change.
/// isBuiltIn templates (seeded, createdBy null) can't be deleted.
model VulnScanTemplate {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  description String?
  scanners    VulnScanner[]
  config      Json?
  isBuiltIn   Boolean       @default(false)
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  jobs      VulnScanJob[]

  @@index([workspaceId])
  @@map("vuln_scan_templates")
}

/// One requested vulnerability scan against one Target — mirrors ReconJob
/// field-for-field except `priority` (Job System: Priority) and the
/// pause/resume + heartbeat columns (Job System: Pause/Resume, Worker
/// Heartbeat, Dead Worker Recovery), none of which Module 3 needed.
/// `config` is the resolved effective per-scanner options for *this* job
/// (copied from the template at creation time if templateId is set, or
/// caller-supplied directly) — immutable once the job exists, same
/// reasoning as ReconJob.tools.
model VulnScanJob {
  id                String            @id @default(uuid())
  workspaceId       String
  projectId         String
  targetId          String
  scanners          VulnScanner[]
  templateId        String?
  config            Json?
  status            VulnScanJobStatus @default(PENDING)
  priority          Int               @default(0)
  retryCount        Int               @default(0)
  maxRetries        Int               @default(2)
  timeoutSeconds    Int               @default(1800)
  nextAttemptAt     DateTime?
  claimedAt         DateTime?
  claimedBy         String?
  lastHeartbeatAt   DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  pauseRequestedAt  DateTime?
  pausedAt          DateTime?
  error             String?
  requestedBy       String
  // Module 18 — task #505. Same purpose/rationale as ReconJob.requestId.
  requestId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target    Target                @relation(fields: [targetId], references: [id], onDelete: Cascade)
  template  VulnScanTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  requester User                  @relation(fields: [requestedBy], references: [id])
  toolRuns  VulnScanJobToolRun[]
  logs      VulnScanJobLog[]
  findings  VulnFinding[]

  // The worker's claim query: WHERE status IN ('PENDING','RETRYING') ORDER
  // BY priority DESC, createdAt ASC (Job System: Priority).
  @@index([status, priority, createdAt])
  @@index([targetId])
  @@index([projectId])
  @@index([workspaceId])
  @@map("vuln_scan_jobs")
}

/// Per-scanner execution state within a job — identical role to
/// ReconJobToolRun.
model VulnScanJobToolRun {
  id                  String            @id @default(uuid())
  jobId               String
  scanner             VulnScanner
  status              VulnScanJobStatus @default(PENDING)
  startedAt           DateTime?
  completedAt         DateTime?
  exitCode            Int?
  findingsCount       Int               @default(0)
  errorMessage        String?
  rawOutputEvidenceId String?
  createdAt           DateTime          @default(now())

  job               VulnScanJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rawOutputEvidence Evidence?        @relation(fields: [rawOutputEvidenceId], references: [id], onDelete: SetNull)
  logs              VulnScanJobLog[]

  @@index([jobId])
  @@map("vuln_scan_job_tool_runs")
}

/// Append-only SSE log source of truth — identical role to ReconJobLog
/// (see that model's comment for why `seq` exists separately from `id`).
model VulnScanJobLog {
  id        String              @id @default(uuid())
  seq       BigInt              @unique @default(autoincrement())
  jobId     String
  toolRunId String?
  level     VulnScanJobLogLevel @default(INFO)
  message   String
  createdAt DateTime            @default(now())

  job     VulnScanJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  toolRun VulnScanJobToolRun? @relation(fields: [toolRunId], references: [id], onDelete: SetNull)

  @@index([jobId, seq])
  @@map("vuln_scan_job_logs")
}

/// The unified Finding model. `path` + `vulnType` + `signature` are the
/// three extra dedup inputs beyond target/scanner that ReconFinding didn't
/// need (Deduplication: "Target, Path, Scanner, Vulnerability Type,
/// Signature") — `dedupKey` below is the pure-function hash of all three
/// plus `matchedAt`, so the actual dedup rule stays in one small utility
/// (tool-runners/dedup/vuln-dedup-key.util.ts), never scattered across
/// normalizers, exactly like Module 3. Evidence is six *optional* pointers
/// rather than a join table — simplest shape for "at most one of each
/// kind per finding", which is all six categories in the spec ever need.
model VulnFinding {
  id             String                @id @default(uuid())
  jobId          String
  workspaceId    String
  projectId      String
  targetId       String
  title          String
  description    String
  severity       VulnFindingSeverity
  cvssScore      Float?
  cvssVector     String?
  cwe            String?
  owaspCategory  OwaspCategory?
  scanner        VulnScanner
  scannerVersion String?
  confidence     VulnFindingConfidence @default(MEDIUM)
  status         VulnFindingStatus     @default(NEW)
  vulnType       String
  path           String?
  signature      String
  matchedAt      String
  data           Json
  dedupKey       String
  tags           String[]
  references     String[]
  createdBy      String?
  firstSeenAt    DateTime              @default(now())
  lastSeenAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  requestEvidenceId    String?
  responseEvidenceId   String?
  screenshotEvidenceId String?
  payloadEvidenceId    String?
  commandEvidenceId    String?
  rawOutputEvidenceId  String?

  job      VulnScanJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target   Target      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  creator  User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  requestEvidence    Evidence? @relation("VulnFindingRequestEvidence", fields: [requestEvidenceId], references: [id], onDelete: SetNull)
  responseEvidence   Evidence? @relation("VulnFindingResponseEvidence", fields: [responseEvidenceId], references: [id], onDelete: SetNull)
  screenshotEvidence Evidence? @relation("VulnFindingScreenshotEvidence", fields: [screenshotEvidenceId], references: [id], onDelete: SetNull)
  payloadEvidence    Evidence? @relation("VulnFindingPayloadEvidence", fields: [payloadEvidenceId], references: [id], onDelete: SetNull)
  commandEvidence    Evidence? @relation("VulnFindingCommandEvidence", fields: [commandEvidenceId], references: [id], onDelete: SetNull)
  rawOutputEvidence  Evidence? @relation("VulnFindingRawOutputEvidence", fields: [rawOutputEvidenceId], references: [id], onDelete: SetNull)
  // Module 6 (Bug Bounty Workspace) — optional back-relation for the
  // provenance link described on BugBountyFinding.vulnFindingId.
  bugBountyFinding BugBountyFinding?

  @@unique([targetId, scanner, dedupKey])
  @@index([jobId])
  @@index([targetId, severity])
  @@index([projectId])
  @@index([workspaceId, status])
  @@map("vuln_findings")
}

// ---------------------------------------------------------------------------
// Activity timeline (user-facing collaboration history — deliberately
// separate from AuditEvent, which is immutable security logging; see
// docs/adr/0002-workspace-foundation-module.md)
// ---------------------------------------------------------------------------

/// entityType/entityId is a loose reference for the same reason as
/// Attachment above, plus one more: this table must be able to describe
/// entities from modules that don't exist yet (Recon, AI, ...) without a
/// schema change — an ActivityEvent surviving its subject's hard deletion
/// is a feature (the timeline still reads "Target X was deleted"), not a
/// bug, so the lack of cascade-on-delete here is intentional, not just
/// tolerated.
model ActivityEvent {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String?
  actorUserId String?
  verb        String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// API keys (foundation for future CLI / browser extension / automation)
// ---------------------------------------------------------------------------

/// Schema + repository only this sprint — no issuing/listing/revoking
/// endpoints and no API-key auth strategy yet.
/// Module 9 activates this model (schema-only since Module 1): adds
/// issuing/listing/revoking endpoints and an API-key Nest auth guard
/// (`public-api/api-key.strategy.ts`), plus rate limiting keyed off
/// `id`. `workspaceId` is new and nullable — null means a *personal* key
/// (scoped to whatever the user themselves can access, matching the
/// original Module 1 design intent), non-null means a *workspace* key
/// (the spec's "Workspace API Keys" — scoped to that workspace
/// regardless of which member's `userId` created it, so it keeps working
/// if that member later leaves the workspace).
model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String?
  name        String
  /// Hashed like refresh tokens — the raw key is shown once at creation
  /// and never stored.
  keyHash    String    @unique
  /// Short visible identifier (e.g. first 8 chars of the raw key) so a
  /// user can tell keys apart in a list without re-exposing the secret.
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  /// Module 15 — API key management improvements (task #336). Empty
  /// array means "no restriction" (the pre-existing default behavior),
  /// never "deny all" — an operator who never touches this field sees no
  /// behavior change. CIDR notation supported by
  /// `ApiKeyAuthGuard`'s IP check (e.g. `"203.0.113.0/24"`), plain IPs
  /// also accepted.
  ipAllowlist        String[] @default([])
  /// Per-key override of the throttler's default limit — `null` means
  /// "use the global `@Throttle` default the route already declares."
  rateLimitPerMinute Int?
  /// Set by `RotateApiKeyCommand` on the *new* key row, pointing back at
  /// the key it replaces — the old key is simultaneously revoked, never
  /// deleted, so audit history and `ApiRequestLog.apiKeyId` references
  /// stay intact.
  rotatedFromId      String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// User preferences
// ---------------------------------------------------------------------------

model UserPreferences {
  id                   String   @id @default(uuid())
  userId               String   @unique
  theme                Theme    @default(SYSTEM)
  language             String   @default("en")
  timezone             String   @default("UTC")
  notificationsEnabled Boolean  @default(true)
  // Module 15 — Privacy controls (task #342). Per-user override consulted
  // by the future telemetry collector (task #347) before sending any
  // event for this user — default false (opted in) matches the operator-
  // level TELEMETRY_ENABLED default of false in env.validation.ts, so
  // telemetry only ever fires when both the operator has turned it on AND
  // the user hasn't individually opted out.
  telemetryOptOut      Boolean  @default(false)
  // Module 15 — task #351 (first-run onboarding). Null until the user
  // finishes (or dismisses) the onboarding flow; `apps/web`'s dashboard
  // shows the onboarding overlay whenever this is null. Stamped
  // server-side via PATCH /users/me/preferences {onboardingCompleted:true}.
  onboardingCompletedAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// userId is nullable + SetNull on delete so audit history survives account
/// deletion (a deleted account's history is still worth keeping).
/// Module 18 — task #519 (audit log integrity sweep). Confirmed
/// append-only in practice: a full sweep of apps/api/src found zero
/// `auditEvent.update`/`.delete`/`.updateMany`/`.deleteMany` calls
/// anywhere, and the one retention/pruning job in the codebase
/// (DataRetentionEnforcerService) has no `AuditEvent` case in its
/// resourceType switch, so nothing ever deletes rows here. That said,
/// disclosed known limitation (not fixed this phase): there is no
/// tamper-evidence field (a `previousHash`/`hash`-chain column, or a
/// signature) that would let an operator detect a row altered or deleted
/// out-of-band via direct DB access, bypassing the application entirely —
/// this table is exactly as tamper-resistant as the database's own access
/// controls and backups, no more. A correct fix would add a hash-chain
/// column (each row's hash covering its own fields plus the previous
/// row's hash) plus a periodic verification job that walks the chain and
/// alerts on a break — a real feature addition (schema migration, a
/// backfill strategy for existing rows, a new scheduled job, and
/// operational docs), out of proportion to a single audit phase and not
/// verifiable end-to-end in this sandbox (no DB access to test a
/// migration/backfill against real data). Tracked as a concrete
/// follow-up in docs/operations/ (Phase 29).
model AuditEvent {
  id        String         @id @default(uuid())
  userId    String?
  type      AuditEventType
  ipAddress String
  userAgent String
  metadata  Json?
  createdAt DateTime       @default(now())
  // Module 18 — task #505 (Request correlation/traceability). The
  // X-Request-Id of the HTTP request that produced this event, when one
  // was active — PrismaAuditRepository.record() defaults this from
  // observability/request-context.ts's getRequestId() so existing callers
  // don't each need to pass it explicitly. Nullable: some audit events are
  // written from background job/worker code paths with no active HTTP
  // request context.
  requestId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([requestId])
  @@map("audit_events")
}

enum AuditEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  REFRESH_TOKEN_ROTATED
  REFRESH_TOKEN_REUSE_DETECTED
  EMAIL_VERIFIED
  VERIFICATION_EMAIL_RESENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_SUCCESS
  MFA_CHALLENGE_FAILURE
  OAUTH_LINKED
  OAUTH_LOGIN
  SESSION_REVOKED
  // Module 9 additions — additive only, existing values/behavior unchanged.
  API_KEY_CREATED
  API_KEY_REVOKED
  WEBHOOK_TOKEN_CREATED
  WEBHOOK_TOKEN_REVOKED
  WEBHOOK_DELIVERY_REDELIVERED
  WORKSPACE_MEMBER_INVITED
  WORKSPACE_MEMBER_ROLE_CHANGED
  WORKSPACE_MEMBER_REMOVED
  // Module 10 additions — additive only, existing values/behavior unchanged.
  ORGANIZATION_CREATED
  ORGANIZATION_MEMBER_INVITED
  ORGANIZATION_MEMBER_ROLE_CHANGED
  ORGANIZATION_MEMBER_REMOVED
  TEMPORARY_PERMISSION_GRANTED
  TEMPORARY_PERMISSION_REVOKED
  APPROVAL_REQUEST_DECIDED
  PLUGIN_INSTALLED
  PLUGIN_REMOVED
  INTEGRATION_CONNECTED
  INTEGRATION_DISCONNECTED
  WORKER_NODE_REGISTERED
  // Module 18 — task #519 (audit log integrity sweep), disclosed known
  // gap: this value has never had a writer anywhere in apps/api/src since
  // it was added (Module 9) — API key rotation, the closest existing
  // "secret rotation" action, deliberately logs API_KEY_REVOKED with
  // metadata.reason: 'rotated' instead (see api-keys.commands.ts's
  // RotateApiKeyHandler). Kept rather than removed since deleting an enum
  // value is a breaking schema change for a value that may still be
  // referenced by historical rows or external tooling; left orphaned
  // rather than wired to a guessed call site, since which action this was
  // originally meant to cover (BYOK credential rotation? encryption key
  // rotation?) isn't recoverable from the code as it stands.
  SECRET_ROTATED
  // Module 15 additions — additive only, existing values/behavior unchanged.
  // Privacy controls (task #342).
  DATA_EXPORT_REQUESTED
  ACCOUNT_DELETION_REQUESTED
  // Demo mode (task #352).
  DEMO_SESSION_STARTED
  // Support system (task #355).
  SUPPORT_TICKET_CREATED
  // Module 16 — Scope Engine decision log (task #370). Written for every
  // tool-execution attempt, allowed or denied — the spec's "record the
  // decision in audit logs" requirement, and the primary evidence trail
  // the dedicated security review (task #407) checks for scope-bypass
  // testing.
  SCOPE_VALIDATION_ALLOWED
  SCOPE_VALIDATION_DENIED
  SECURITY_APPROVAL_REQUESTED
  SECURITY_APPROVAL_DECIDED
  AI_INVESTIGATION_STARTED
  AI_INVESTIGATION_STEP_EXECUTED
  // Module 16 — Terminal workspace (task #388) / Playbooks (task #389).
  // TERMINAL_COMMAND_EXECUTED is written for every ad-hoc command
  // resolution — SAFE run, REQUIRES_APPROVAL request, or BLOCKED
  // rejection — the "every execution creates an audit event" requirement
  // (spec section "TERMINAL AUDIT"). PLAYBOOK_STEP_EXECUTED mirrors it for
  // each playbook execution step.
  TERMINAL_COMMAND_EXECUTED
  PLAYBOOK_STEP_EXECUTED
  // Module 16 — Public Sharing (task #392). Written on every share-link
  // create/revoke and on every *access* against a password-protected or
  // otherwise sensitive link, so a workspace can audit who saw/attempted
  // a shared resource, not just who created the link (spec: "audit
  // logging" under Public Sharing).
  SHARE_LINK_CREATED
  SHARE_LINK_REVOKED
  SHARE_LINK_ACCESSED
  SHARE_LINK_ACCESS_DENIED
  // Module 16 — AI Memory (task #397). "Audit important memory
  // mutations" — written for IMPORTANT_FINDING/DECISION kind entries
  // (the two kinds the spec calls out as needing an audit trail) on
  // create/update/delete; PREFERENCE/NOTE/PROJECT_CONTEXT/
  // CUSTOM_INSTRUCTION mutations are lower-stakes and rely on
  // AiMemoryChunk's own existing storage instead of a second audit path.
  AI_MEMORY_ENTRY_MUTATED
  // Module 16 — Extension API registry (task #401).
  EXTENSION_REGISTERED
  EXTENSION_ENABLED
  EXTENSION_DISABLED
  EXTENSION_UNREGISTERED
  // Module 16 — hardening pass: wires ExtensionPermissionEnforcer into a
  // real invocation path (POST /extensions/:id/invoke). One audit type
  // covers both outcomes (success/failure recorded in `metadata.ok`)
  // rather than a pair of INVOKED/INVOCATION_FAILED types, matching how
  // this enum otherwise favors one type per *action*, not per outcome.
  EXTENSION_INVOKED
  // Module 17 — SOC/Threat Intelligence/Incident/Remediation/Automation.
  // A curated set (one per major mutating action family, not one per CRUD
  // verb per model — same "audit the decision, not every field write"
  // posture as every prior module's additions to this enum).
  INDICATOR_CREATED
  INDICATOR_IMPORTED
  INDICATOR_EXPIRED
  INDICATOR_DISABLED
  THREAT_INTEL_IMPORT_REJECTED
  THREAT_MATCH_CREATED
  THREAT_MATCH_STATUS_CHANGED
  INCIDENT_CREATED
  INCIDENT_STATUS_CHANGED
  INCIDENT_ASSIGNED
  ASSET_OWNERSHIP_CHANGED
  REMEDIATION_TASK_CREATED
  REMEDIATION_TASK_STATUS_CHANGED
  FINDING_VERIFICATION_STATUS_CHANGED
  SLA_POLICY_CHANGED
  AUTOMATION_RULE_CREATED
  AUTOMATION_RULE_EXECUTED
  AUTOMATION_RULE_BLOCKED
  // Module 17 -- hardening pass: three previously-unused audit actions
  // that had dedicated call sites written for them (AI Investigation
  // completion, finding verification, remediation evidence linking) but
  // no enum value to write -- each is a distinct action from its nearest
  // existing neighbor (AI_INVESTIGATION_STEP_EXECUTED is per-step, not
  // per-run completion; FINDING_VERIFICATION_STATUS_CHANGED covers the
  // review-status field generally, this is specifically the verify
  // action; REMEDIATION_TASK_STATUS_CHANGED doesn't cover evidence
  // attachment).
  AI_INVESTIGATION_EXECUTED
  FINDING_VERIFIED
  REMEDIATION_EVIDENCE_LINKED
}

// ---------------------------------------------------------------------------
// AI Security Copilot (Module 5) — see docs/adr/0005-ai-security-copilot-module.md
// A conversation is always project-scoped (workspaceId denormalized off
// project->workspace at creation, same reasoning as VulnScanJob/ReconJob —
// list/auth queries never join through Project just to filter). The RAG
// store (AiMemoryChunk) is the one new kind of table this module
// introduces: chunked + embedded workspace/project content for semantic
// retrieval. Every read against it is filtered by workspaceId first
// (Security: Workspace Isolation) — a raw-query bug can leak across
// projects within a workspace at worst, never across workspaces.
// ---------------------------------------------------------------------------

enum AiProviderName {
  OPENAI
  ANTHROPIC
  GEMINI
  OLLAMA
  OPENROUTER
}

/// Local-First Migration Phase 1 (BYOK — "Bring Your Own Key"): a
/// workspace's own credential for one AI provider, so the backend never
/// has to fall back to the operator's server-configured keys for that
/// workspace. See docs/migration/local-first-architecture-migration.md
/// and docs/adr/0007-local-first-desktop-agent-architecture.md.
///
/// The AI call itself still executes backend-side (this is a deliberate,
/// lower-risk Phase 1 scope decision — see the roadmap doc's Phase 1
/// entry): only the *credential source* changes from "operator env var"
/// to "this workspace's own encrypted key", so RAG/tool-calling/prompt-
/// injection-guard machinery in Module 5 keeps working unmodified for
/// BYOK workspaces. `encryptedApiKey` is AES-256-GCM ciphertext (see
/// common/crypto/credential-encryption.util.ts), decrypted only
/// in-memory per request inside AiProviderRegistryService — never logged,
/// never returned to any client (AiProviderCredentialDto exposes only
/// `keyPreview`).
model AiProviderCredential {
  id              String         @id @default(uuid())
  workspaceId     String
  provider        AiProviderName
  /// Null for providers that don't need a key at all (a local Ollama/LM
  /// Studio server reached purely via `baseUrl`).
  encryptedApiKey String?
  /// Last 4 characters of the raw key, so a user can tell keys apart in
  /// the settings UI without the secret ever being re-displayed — same
  /// intent as ApiKey.prefix, but from the tail: most provider key
  /// formats vary their prefix length/shape, the tail is a steadier
  /// "is this the key I think it is" check.
  keyPreview      String?
  /// Local/self-hosted providers (Ollama, LM Studio) or an alternate
  /// endpoint (Azure OpenAI's per-resource URL) override the adapter's
  /// hardcoded default host when set.
  baseUrl         String?
  /// Per-workspace default model for this provider, overriding the
  /// adapter's env-configured default when set.
  model           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("ai_provider_credentials")
}

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AiMessageStatus {
  PENDING
  STREAMING
  COMPLETE
  FAILED
  CANCELLED
}

/// What kind of workspace/project record a RAG chunk was derived from —
/// lets a similarity-search hit be traced back to the real row (via
/// sourceId) and re-fetched for full, untruncated detail rather than
/// trusting the embedded chunk text alone.
enum AiMemorySourceType {
  FINDING
  RECON_FINDING
  NOTE
  EVIDENCE
  CONVERSATION_MESSAGE
  SCAN_TEMPLATE
  TARGET
  PROJECT
  CUSTOM
  // Module 6 (Bug Bounty Workspace) additions — feed the same RAG store so
  // the AI Security Copilot (Module 5) can answer questions about, and
  // Duplicate Detection can semantically compare, bug bounty findings/
  // reports/payloads without a second embedding pipeline.
  BUGBOUNTY_FINDING
  BUG_REPORT
  PAYLOAD_LIBRARY_ENTRY
  // Module 11 (AI Security Copilot) additions — same "feed the one RAG
  // store, don't build a parallel index" reasoning as the Module 6
  // additions above. KNOWLEDGE_BASE_REFERENCE backs the AI Knowledge Base
  // (OWASP/CWE/CAPEC/MITRE/NIST/CVE semantic search over
  // KnowledgeBaseReferenceEntry rows); AGENT_TASK_OUTPUT/
  // ORCHESTRATION_RUN let the long-term memory layer recall what an agent
  // concluded on a past run when planning a new one.
  KNOWLEDGE_BASE_REFERENCE
  AGENT_TASK_OUTPUT
  ORCHESTRATION_RUN
  // Module 16 addition — ResearcherMemoryEntry rows are mirrored into
  // this same RAG store on create/update so "AI Memory" (spec section 36)
  // is retrievable by the existing similarity search rather than a
  // second, parallel retrieval mechanism.
  RESEARCHER_MEMORY
  // Module 17 additions (task #485 — AI Memory extension, spec section
  // 36 applied to SOC context). Same "feed the one RAG store" reasoning
  // as every addition above: INCIDENT covers an incident's own summary
  // plus each analyst free-text note (IncidentsService.addNote) as a
  // separate chunked source, so "what did the analyst say about this
  // incident" is answerable by the same similarity search AiChatService
  // already uses. REMEDIATION_TASK mirrors a task's owner/priority/notes.
  // RISK_ASSESSMENT mirrors each immutable RiskFactorSnapshot (never
  // re-indexed under the same sourceId, since a snapshot is append-only
  // history, not a mutable "current" record — see that model's own doc
  // comment) so "why was this scored this way" stays semantically
  // searchable across a finding/asset's full scoring history.
  INCIDENT
  REMEDIATION_TASK
  RISK_ASSESSMENT
}

/// One chat thread. `provider`/`model` are captured per-conversation (not
/// only globally configured) so a workspace can pin — or compare — a
/// specific provider/model without a schema change (AI Provider
/// Architecture: "changing providers must only require configuration").
model AiConversation {
  id         String          @id @default(uuid())
  workspaceId String
  projectId  String
  userId     String
  title      String?
  provider   AiProviderName?
  model      String?
  pinned     Boolean         @default(false)
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  toolCalls AiToolCallLog[]

  @@index([workspaceId, projectId])
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

/// One turn in a conversation. `content` is the final rendered text;
/// `status` tracks the SSE streaming lifecycle (PENDING while queued,
/// STREAMING while the caller-visible SSE stream is still appending
/// tokens, COMPLETE/FAILED/CANCELLED terminal — see AiChatStreamService).
/// `bookmarked`/`pinned` back the AI Message Actions spec directly, no
/// join table needed (single-owner favoriting, unlike ProjectFavorite).
model AiMessage {
  id               String          @id @default(uuid())
  conversationId   String
  role             AiMessageRole
  content          String
  status           AiMessageStatus @default(COMPLETE)
  provider         AiProviderName?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  bookmarked       Boolean         @default(false)
  pinned           Boolean         @default(false)
  errorMessage     String?
  /// Module 11 — AI Chat conversation branching. Null for every message
  /// created before this column existed (or any message that is simply
  /// "the next turn" in a linear thread, which is still the common case).
  /// Set when a user regenerates/edits a specific assistant turn and
  /// wants to keep the original reply reachable instead of overwriting
  /// it in place: the new message points `parentMessageId` at the
  /// message it branches from, so a conversation becomes a tree instead
  /// of a strict list. `regenerate()`/`continueGeneration()` in
  /// AiChatService are unaffected for the common linear case — this is
  /// purely additive.
  parentMessageId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  conversation  AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentMessage AiMessage?      @relation("MessageBranch", fields: [parentMessageId], references: [id], onDelete: SetNull)
  branches      AiMessage[]     @relation("MessageBranch")
  toolCalls     AiToolCallLog[]

  @@index([conversationId, createdAt])
  @@index([parentMessageId])
  @@map("ai_messages")
}

/// One internal-tool invocation the AI made while composing a message (AI
/// Tool Calling) — doubles as an audit trail (Security: Prompt Injection
/// Protection review) and lets the UI render "Searched Findings for
/// '...'" tool-use indicators.
model AiToolCallLog {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String?
  toolName       String
  input          Json
  output         Json?
  errorMessage   String?
  durationMs     Int?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("ai_tool_call_logs")
}

/// The RAG store. `embedding` is a raw pgvector column — Prisma Client
/// excludes `Unsupported` fields from generated create/select input, so
/// all reads/writes of this one column go through $queryRaw/$executeRaw
/// in PrismaAiMemoryRepository; every other column on this model stays
/// fully typed through the normal Client. `content` is the chunked,
/// embedded text; `sourceType`+`sourceId` trace back to the real record.
/// `projectId` is nullable because some memory (workspace-wide
/// conversation summaries) isn't project-scoped, but `workspaceId` is
/// always required — the one column every similarity-search query filters
/// on first.
model AiMemoryChunk {
  id          String                       @id @default(uuid())
  workspaceId String
  projectId   String?
  sourceType  AiMemorySourceType
  sourceId    String
  chunkIndex  Int                          @default(0)
  content     String
  embedding   Unsupported("vector(1536)")?
  metadata    Json?
  /// Module 11 — Long-Term Memory "expiration policies". Null (the
  /// default, and the value for every chunk indexed before this column
  /// existed) means "keep indefinitely", matching every prior module's
  /// behavior. Agent-run-derived memory (AGENT_TASK_OUTPUT/
  /// ORCHESTRATION_RUN) is indexed with a TTL instead, since a stale
  /// recon/plan conclusion from months ago recalled as if current would
  /// actively mislead a new orchestration run. AiMemoryExpiryService
  /// deletes rows where `expiresAt < now()` on a schedule.
  expiresAt   DateTime?
  createdAt   DateTime                     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId])
  @@index([sourceType, sourceId])
  @@index([expiresAt])
  @@map("ai_memory_chunks")
}

// ---------------------------------------------------------------------------
// Bug Bounty Workspace (Module 6) — see docs/adr/0006-bug-bounty-workspace-module.md
//
// Integrates with, never duplicates, Modules 1-5: Programs/Findings/Reports
// link to existing Target/Evidence/VulnFinding rows by FK instead of
// re-storing their data; Asset Inventory is a read-through aggregation over
// Target+ReconFinding+VulnFinding+Evidence (no BugBountyAsset table exists).
// BugBountyFinding is intentionally its own model rather than an extension
// of VulnFinding: VulnFinding.jobId is NOT NULL (every VulnFinding must
// come from an automated VulnScanJob — Module 4's core assumption), but the
// majority of real bug-bounty findings are discovered manually, so forcing
// them through VulnFinding would mean fabricating scan jobs for manual
// work. BugBountyFinding.vulnFindingId is an optional link for the case
// where a finding *did* originate from an automated scan, giving the best
// of both: full integration when there's scan provenance, no forced
// coupling when there isn't.
// ---------------------------------------------------------------------------

enum BugBountyPlatform {
  HACKERONE
  BUGCROWD
  INTIGRITI
  YESWEHACK
  SYNACK
  INTERNAL
  PRIVATE
  CUSTOM
}

enum BugBountyProgramStatus {
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum ScopeItemType {
  DOMAIN
  WILDCARD
  URL
  MOBILE_APP
  API
  CIDR
  IP_RANGE
  ASN
  CLOUD_ASSET
  // Module 9 additions — additive only.
  HOST
  INTERNAL_ASSET
  GITHUB_ORG
  THIRD_PARTY
}

/// REVIEW_NEEDED/DEPRECATED added in Module 9. UNKNOWN is kept as the
/// importer's default for a pattern that hasn't been classified yet;
/// REVIEW_NEEDED is a deliberate manual flag ("a human should look at
/// this") distinct from UNKNOWN ("nobody has looked at this yet"), and
/// DEPRECATED marks a once-valid scope entry a program has since removed
/// (kept for history rather than deleted, matching Target's soft-delete
/// convention elsewhere in the schema).
enum ScopeClassification {
  IN_SCOPE
  OUT_OF_SCOPE
  UNKNOWN
  REVIEW_NEEDED
  DEPRECATED
}

/// Module 16 addition. Purely descriptive metadata about how the program
/// itself is listed on its platform — not an access-control mechanism for
/// this workspace's own data (every program row is already workspace-
/// scoped and RBAC-protected the same way every other Module 6 resource
/// is); this only records whether the *external* bounty program is
/// public/private/invite-only, since that changes how a hunter is allowed
/// to reference or share it.
enum BugBountyProgramVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

/// A program the hunter is engaged on. `projectId` is nullable — a program
/// can be tracked workspace-wide (a personal HackerOne program the hunter
/// is hunting on solo) or tied to a specific client Project, matching how
/// Note already makes its Project link required but Target link optional.
model BugBountyProgram {
  id                String                 @id @default(uuid())
  workspaceId       String
  projectId         String?
  name              String
  platform          BugBountyPlatform
  organization      String?
  url               String?
  status            BugBountyProgramStatus @default(ACTIVE)
  rulesMarkdown     String?
  bountyTable       Json?
  severityMatrix    Json?
  disclosurePolicy  String?
  notesMarkdown     String?
  tags              String[]
  createdBy         String
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  // --- Module 9 additions (additive columns only) ---
  /// "Favorite" star, distinct from Bookmark (which is a generic
  /// cross-entity favorites list) — kept as a direct column since every
  /// program list view needs it and a join against Bookmark for every row
  /// would be needless overhead for something this cheap to store inline.
  favorite          Boolean                @default(false)
  /// Safe Harbor language, kept separate from `rulesMarkdown` (general
  /// policy) since Safe Harbor is a distinct, often-quoted legal clause
  /// hunters look up specifically before testing.
  safeHarbor        String?
  /// Structured rate-limit rules, e.g. `{ "requestsPerSecond": 5,
  /// "concurrentScans": 1, "notes": "no automated scanning 22:00-06:00 UTC" }`
  /// — kept as Json (not fixed columns) since programs express this
  /// wildly differently and the Recon/Scanner job schedulers only need to
  /// read it as advisory metadata, not enforce it mechanically yet.
  rateLimits        Json?
  /// Set by the Program Importer on every successful (re-)import — powers
  /// "detect updates automatically" (see importers/program-update-detector.ts):
  /// a re-import computes a fresh fingerprint of the normalized payload and
  /// compares it against this column to decide whether anything changed.
  lastImportedAt    DateTime?
  importFingerprint String?
  // --- Module 16 additions (additive only) — the spec's Program Management
  // section names five fields this model didn't have a dedicated column
  // for yet: `description`/`notesMarkdown` already existed but were
  // conflated (notesMarkdown is the hunter's private notes, not a public
  // program summary) — description is now separate; `rulesMarkdown`/`url`
  // already covered "rules"/"programUrl", policyUrl is the (often
  // different) disclosure-policy document link `disclosurePolicy` (a free
  // text field below) didn't capture as a URL specifically.
  description   String?
  policyUrl     String?
  visibility    BugBountyProgramVisibility @default(PUBLIC)
  currency      String?                    @default("USD")
  rewardRangeMin Float?
  rewardRangeMax Float?

  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator       User                     @relation(fields: [createdBy], references: [id])
  scopeItems    BugBountyProgramScopeItem[]
  targetLinks   BugBountyProgramTarget[]
  findings      BugBountyFinding[]
  reports       BugReport[]
  calendarEvents BugBountyCalendarEvent[]
  scheduledJobs ScheduledJob[]
  // Module 16 additive back-relation.
  submissions   Submission[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([workspaceId, favorite])
  @@map("bugbounty_programs")
}

/// One scope rule. `pattern` holds the raw text (domain/wildcard/URL/CIDR/
/// ASN/...); `type` says how to interpret it, `classification` is the
/// auto-classification result (or manual override) — mirrors
/// Target.type/value/scopeStatus (Module 2) one level up, at the program
/// level rather than the individual-asset level.
model BugBountyProgramScopeItem {
  id             String               @id @default(uuid())
  programId      String
  type           ScopeItemType
  pattern        String
  classification ScopeClassification @default(UNKNOWN)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  program BugBountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, classification])
  @@map("bugbounty_program_scope_items")
}

/// Links an existing Target (Module 2) to a Program, without adding a
/// column to the Target table itself — a Target can belong to more than
/// one program over its lifetime (e.g. rescoped between engagements), and
/// a join table keeps that history-friendly instead of a single nullable
/// FK on Target.
model BugBountyProgramTarget {
  programId String
  targetId  String
  linkedAt  DateTime @default(now())

  program BugBountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  target  Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([programId, targetId])
  @@map("bugbounty_program_targets")
}

/// Module 9 adds DRAFT/INFORMATIVE/ACCEPTED/REJECTED, additive to Module
/// 6's original 9-value lifecycle — mapping onto the spec's requested
/// Draft/Validated/Confirmed/Reported/Duplicate/Informative/Accepted/
/// Resolved/Closed/Rejected list as: DRAFT->Draft, NEW/TRIAGED->Validated,
/// VERIFIED->Confirmed, REPORTED->Reported, DUPLICATE->Duplicate,
/// INFORMATIVE->Informative, ACCEPTED->Accepted, RESOLVED->Resolved,
/// CLOSED/ARCHIVED->Closed, REJECTED->Rejected. Existing rows and code
/// referencing NEW/TRIAGED/VERIFIED/... are unaffected; DRAFT is the new
/// default entry point for findings created before they're validated.
enum BugBountyFindingStage {
  DRAFT
  NEW
  TRIAGED
  VERIFIED
  REPORTED
  DUPLICATE
  INFORMATIVE
  ACCEPTED
  NEED_MORE_INFO
  REJECTED
  RESOLVED
  CLOSED
  ARCHIVED
  // --- Module 16 additions (additive only) — closes the gap between this
  // enum's existing 13 values and the spec's Finding Validation Workflow
  // (New/Triaged/Needs Validation/Confirmed/False Positive/Duplicate/
  // Accepted Risk/Remediated/Closed/Reopened): NEED_MORE_INFO already
  // covers "Needs Validation", VERIFIED already covers "Confirmed",
  // DUPLICATE/CLOSED are already present — these four are the genuinely
  // missing terminal/re-open states. See
  // docs/adr/0016-global-security-intelligence-bugbounty-collaboration.md.
  FALSE_POSITIVE
  ACCEPTED_RISK
  REMEDIATED
  REOPENED
}

/// The bug-bounty-specific finding lifecycle (9 stages) — deliberately
/// separate from VulnFindingStatus (Module 4's 5-value scanner-confirmation
/// status): a submission's life after a hunter decides to report it
/// (Triaged → Reported → Duplicate/NeedMoreInfo → Resolved → Closed →
/// Archived) has no equivalent in Module 4, which stops at
/// CONFIRMED/RESOLVED. `vulnFindingId` is an optional provenance link (see
/// file-level doc comment above) — `endpoint`/`payload`/`vulnType` are
/// captured directly here (not just via the optional VulnFinding link)
/// specifically so Duplicate Detection has stable fields to compare against
/// even for manually-created findings with no VulnFinding at all.
model BugBountyFinding {
  id            String                @id @default(uuid())
  workspaceId   String
  projectId     String
  programId     String
  targetId      String?
  vulnFindingId String?               @unique
  title         String
  description   String
  severity      VulnFindingSeverity
  cvssScore     Float?
  cvssVector    String?
  cwe           String?
  vulnType      String?
  endpoint      String?
  payload       String?
  stage         BugBountyFindingStage @default(NEW)
  duplicateOfId String?
  bountyAmount  Float?
  currency      String?               @default("USD")
  tags          String[]
  createdBy     String
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  // --- Module 9 additions: standardized vulnerability classification, on
  // top of the existing free-text `cwe` field (kept for backward compat —
  // pre-Module-9 findings already have a `cwe` string; this doesn't touch
  // that data, it adds three more classification axes alongside it). ---
  /// CAPEC (Common Attack Pattern Enumeration and Classification) id,
  /// e.g. "CAPEC-66" for SQL Injection — one per finding, since CAPEC
  /// patterns are attack-technique-level and a finding is normally one
  /// technique; free text (not an enum) because CAPEC's ~600 entries
  /// change independently of this schema.
  capec         String?
  /// Reuses Module 4's OwaspCategory enum (OWASP Top 10 mapping) rather
  /// than introducing a second one — the categories are the same list
  /// regardless of whether the finding originated from a Vuln Scan or was
  /// entered manually as a bug-bounty finding.
  owaspCategory OwaspCategory?
  /// MITRE ATT&CK technique references, e.g.
  /// `[{"id":"T1190","name":"Exploit Public-Facing Application"}]` — kept
  /// as Json array (not a join table) since a finding can map to more
  /// than one technique and this is descriptive metadata, not something
  /// queried/filtered on at scale yet.
  mitreAttack   Json?
  /// The individual CVSS 3.1 vector components the calculator UI was
  /// last run with (see cvss/cvss-calculator.util.ts), e.g.
  /// `{"AV":"N","AC":"L","PR":"N","UI":"N","S":"U","C":"H","I":"H","A":"H"}`
  /// — stored alongside the derived `cvssScore`/`cvssVector` strings so
  /// the calculator can be re-opened pre-filled instead of having to
  /// re-parse the vector string every time.
  cvssBreakdown Json?
  // --- Module 16 additions (additive only) — "Finding Intelligence" section.
  // CWE/CVSS/OWASP/CAPEC/MITRE already exist above (Module 9); these close
  // the remaining gap: EPSS/CPE (feed CveMatch/RiskScoringService below),
  // a numeric confidence distinct from the workflow `stage`, free-text
  // exploitability/impact narratives (AI-assisted, never auto-scored to a
  // false precision), and the deterministic dedup fingerprint.
  cve             String?
  epss            Float?
  cpe             String?
  confidence      Float?
  exploitability  String?
  businessImpact  String?
  /// SHA-256 hex, computed by FindingFingerprintService from
  /// target+endpoint+vulnType+parameter+evidence-signature+scanner — see
  /// docs/architecture/finding-fingerprinting.md. Indexed (not unique):
  /// two findings sharing a fingerprint are dedup *candidates* the
  /// existing Duplicate Detection (Module 6) still confirms/links, not an
  /// automatic hard merge.
  fingerprint     String?
  /// Output of RiskScoringService — recomputed whenever any risk input
  /// changes (severity/cvss/epss/confidence/...), never hand-edited.
  riskScore       Float?
  riskLevel       String?
  // --- Module 17 additions (additive only) — Remediation Verification
  // (task #477, spec section 22). Deliberately distinct from `stage`
  // (the bug-bounty-platform submission workflow, e.g. NEW/TRIAGED/
  // REPORTED) — this tracks whether a *fix* has actually been proven,
  // not whether the finding itself has been triaged/reported. Changing
  // `verificationStatus` to VERIFIED must never happen just because a
  // user set it — the service layer requires `verificationEvidenceId` to
  // point at a real `Evidence` row before that transition is allowed
  // (spec: "verification must require actual evidence").
  verificationStatus     FindingVerificationStatus @default(OPEN)
  verificationEvidenceId String?
  verifiedBy             String?
  verifiedAt              DateTime?

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  program       BugBountyProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  target        Target?           @relation(fields: [targetId], references: [id], onDelete: SetNull)
  vulnFinding   VulnFinding?      @relation(fields: [vulnFindingId], references: [id], onDelete: SetNull)
  creator       User              @relation(fields: [createdBy], references: [id])
  duplicateOf   BugBountyFinding? @relation("BugBountyFindingDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    BugBountyFinding[] @relation("BugBountyFindingDuplicate")
  evidenceLinks BugBountyFindingEvidence[]
  reports       BugReport[]
  knowledgeBaseNotes KnowledgeBaseNote[]
  submissions   Submission[]
  cveMatches    CveMatch[]

  @@index([workspaceId, stage])
  @@index([programId])
  @@index([projectId])
  @@index([fingerprint])
  @@map("bugbounty_findings")
}

/// Many-to-many Finding <-> Evidence — unlike VulnFinding's six fixed
/// optional pointers (one screenshot, one request, ...), a bug bounty
/// finding can carry an arbitrary number of each, so a join table fits
/// better than more named FK columns.
model BugBountyFindingEvidence {
  findingId  String
  evidenceId String
  addedAt    DateTime @default(now())

  finding  BugBountyFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([findingId, evidenceId])
  @@map("bugbounty_finding_evidence")
}

enum BugReportTemplate {
  HACKERONE
  BUGCROWD
  INTIGRITI
  MARKDOWN
  PDF
  HTML
}

enum BugReportStatus {
  DRAFT
  SUBMITTED
  TRIAGED
  ACCEPTED
  REJECTED
  DUPLICATE
  RESOLVED
  CLOSED
}

/// Module 9 — the report's *audience/purpose* template, orthogonal to
/// `BugReportTemplate` above (which is really an export/platform-format
/// choice: HackerOne-shaped Markdown vs. plain Markdown vs. HTML). A
/// report can be, say, a CLIENT-kind report exported in HTML format, or a
/// BUG_BOUNTY-kind report exported HackerOne-shaped. Kept as a second
/// field rather than folding into `BugReportTemplate` to avoid a breaking
/// rename of that enum (see the file-level "Do NOT rewrite previous
/// modules" constraint).
enum ReportTemplateKind {
  EXECUTIVE
  TECHNICAL
  BUG_BOUNTY
  CLIENT
  COMPLIANCE
  CUSTOM
}

/// Export format, used by the report export endpoint alongside the
/// existing `BugReportExportFormat` shared-package union — DOCX/TXT are
/// new in Module 9 (Module 6 only had PDF/Markdown/HTML/JSON/CSV, and CSV
/// was never really a "report" format so much as a findings-list export).
enum ReportExportFormat {
  MARKDOWN
  PDF
  DOCX
  HTML
  JSON
  TXT
}

/// A workspace-defined custom report template — an ordered list of named
/// Markdown sections (with `{{placeholders}}` resolved from the
/// BugReport/Finding/Program at render time by
/// `reports/custom-template-renderer.ts`), for when none of the five
/// built-in ReportTemplateKind values fit (e.g. a specific client's own
/// required report structure).
model ReportCustomTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  /// `[{"heading": "Executive Summary", "bodyTemplate": "..."}]`
  sections    Json
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])
  reports   BugReport[]

  @@index([workspaceId])
  @@map("report_custom_templates")
}

/// `version` is optimistic locking on the draft — the one genuinely new
/// concurrency-control pattern this module introduces (grepped: no
/// existing model in this schema uses a version column; see ADR 0006 for
/// why reports specifically need it — a draft can be open in the AI Report
/// Draft Assistant and hand-edited in the same browser tab, and losing one
/// side's edit silently is worse here than in any Module 1-5 entity).
/// `aiGenerated`/`aiModel`/`aiGeneratedAt` track provenance of the *last*
/// AI draft pass without duplicating the drafted text into separate
/// "ai-original" columns — the same summary/impact/etc. fields are edited
/// in place after generation.
model BugReport {
  id                 String            @id @default(uuid())
  workspaceId        String
  projectId          String?
  programId          String
  findingId          String?
  title              String
  template           BugReportTemplate @default(MARKDOWN)
  status             BugReportStatus   @default(DRAFT)
  summary            String?
  impact             String?
  stepsToReproduce   String?
  proofOfConcept     String?
  cwe                String?
  cvssScore          Float?
  cvssVector         String?
  references         String[]
  mitigation         String?
  aiGenerated        Boolean           @default(false)
  aiModel            String?
  aiGeneratedAt      DateTime?
  bountyAmount       Float?
  currency           String?           @default("USD")
  platformReportUrl  String?
  platformReportId   String?
  // --- Module 9 additions ---
  templateKind       ReportTemplateKind @default(BUG_BOUNTY)
  customTemplateId   String?
  /// Set on the last AI grammar-correction pass (Report Builder's
  /// "Grammar correction" feature) — distinct from `aiGeneratedAt`
  /// (which marks a full draft generation) so the UI can show "grammar
  /// checked 2 hours ago" without implying the whole report was
  /// regenerated.
  grammarCheckedAt   DateTime?
  /// Set on the last AI technical-review pass ("Technical review" —
  /// checks CVSS/CWE consistency, missing repro steps, vague impact
  /// language) — stores the reviewer's findings, not just a timestamp.
  technicalReview    Json?
  submittedAt        DateTime?
  /// Set when status first transitions to TRIAGED — feeds Statistics'
  /// averageTimeToTriagedHours (submittedAt -> triagedAt).
  triagedAt          DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  version            Int               @default(1)
  createdBy          String
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  program        BugBountyProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  finding        BugBountyFinding?   @relation(fields: [findingId], references: [id], onDelete: SetNull)
  creator        User                @relation(fields: [createdBy], references: [id])
  customTemplate ReportCustomTemplate? @relation(fields: [customTemplateId], references: [id], onDelete: SetNull)
  evidenceLinks  BugReportEvidence[]
  calendarEvents BugBountyCalendarEvent[]
  knowledgeBaseNotes KnowledgeBaseNote[]

  @@index([workspaceId, status])
  @@index([programId])
  @@index([findingId])
  @@map("bugbounty_reports")
}

/// Many-to-many Report <-> Evidence, same reasoning as
/// BugBountyFindingEvidence above.
model BugReportEvidence {
  reportId   String
  evidenceId String
  addedAt    DateTime @default(now())

  report   BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  evidence Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([reportId, evidenceId])
  @@map("bugbounty_report_evidence")
}

enum PayloadCategory {
  XSS
  SQLI
  SSRF
  SSTI
  XXE
  IDOR
  CSRF
  LFI
  RFI
  RCE
  DESERIALIZATION
  JWT
  GRAPHQL
  CSP
  CORS
  OPEN_REDIRECT
}

/// `workspaceId` nullable: null rows are the seeded, shared-across-every-
/// workspace default library; non-null rows are a workspace's own custom
/// payloads. `createdBy` nullable for the same reason (seed rows have no
/// author).
model PayloadLibraryEntry {
  id             String          @id @default(uuid())
  workspaceId    String?
  category       PayloadCategory
  title          String
  description    String
  example        String
  references     String[]
  tags           String[]
  aiExplanation  String?
  createdBy      String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([workspaceId])
  @@map("payload_library_entries")
}

/// Personal knowledge base note. `checklist` is a small JSON array of
/// `{text, done}` items rather than a separate table — same
/// forward-compat-escape-hatch reasoning as Target.customFields (Module 2),
/// scoped down since checklists here are genuinely just a flat list, not
/// structured domain data. Links to Target/Finding/Report are all optional
/// direct FKs (matches Note.targetId in Module 2) rather than a polymorphic
/// reference, since there are only three link targets and all three are
/// well-known types.
/// Module 9 — distinguishes the Knowledge Base's original free-form NOTE
/// kind from the more structured reference material the spec asks for
/// (Cheat Sheets, Methodologies, Playbooks, CVE references, Tool
/// references, saved AI conversation snapshots). Deliberately not
/// separate tables per kind: every one of these is fundamentally
/// "a title + Markdown body + optional checklist + tags + optional
/// entity links", so one table with a discriminator column avoids seven
/// near-identical models and seven near-identical repositories/CRUD
/// surfaces for what the UI can render with one form + a kind picker.
enum KnowledgeBaseEntryKind {
  NOTE
  CHEAT_SHEET
  METHODOLOGY
  PLAYBOOK
  CVE_REFERENCE
  TOOL_REFERENCE
  AI_CONVERSATION_SNAPSHOT
}

model KnowledgeBaseNote {
  id               String    @id @default(uuid())
  workspaceId      String
  projectId        String?
  targetId         String?
  findingId        String?
  reportId         String?
  title            String?
  contentMarkdown  String
  checklist        Json?
  authorId         String
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // --- Module 9 additions ---
  kind             KnowledgeBaseEntryKind @default(NOTE)
  /// Tagging support (spec: "Support tagging"). A plain array, matching
  /// every other tags column in this schema (BugBountyProgram.tags,
  /// PayloadLibraryEntry.tags, ...) rather than routing through the
  /// generic Tag/ProjectTag/TargetTag join-table system (Module 2), since
  /// that system is Project/Target-scoped specifically and KB entries are
  /// workspace-wide.
  tags             String[] @default([])
  /// For kind=CVE_REFERENCE: the CVE identifier, e.g. "CVE-2024-12345" —
  /// nullable/unused for every other kind. A dedicated column (not just a
  /// tag) because CVE lookups need to be exact-match indexed.
  cveId            String?
  /// For kind=AI_CONVERSATION_SNAPSHOT: the source AiConversation this
  /// snapshot was saved from (see knowledge-base.commands.ts's
  /// `saveConversationSnapshot` — a point-in-time copy, not a live link,
  /// so the KB entry survives the original conversation being deleted).
  sourceConversationId String?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  target    Target?           @relation(fields: [targetId], references: [id], onDelete: SetNull)
  finding   BugBountyFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  report    BugReport?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  author    User              @relation(fields: [authorId], references: [id])

  @@index([workspaceId])
  @@index([projectId])
  @@index([targetId])
  @@index([workspaceId, kind])
  @@map("knowledge_base_notes")
}

enum BookmarkEntityType {
  TARGET
  FINDING
  REPORT
  PAYLOAD
  NOTE
  PROGRAM
}

/// Loose reference (entityType/entityId, no DB-level FK) — same pattern as
/// ActivityEvent/Attachment (Module 2): a bookmark must be able to point at
/// five different tables, which a real FK can't express, and a bookmark
/// surviving its target's deletion (until the UI prunes it) is acceptable.
model Bookmark {
  id          String             @id @default(uuid())
  workspaceId String
  userId      String
  entityType  BookmarkEntityType
  entityId    String
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([workspaceId])
  @@map("bugbounty_bookmarks")
}

enum CalendarEventType {
  SUBMISSION_DEADLINE
  FOLLOW_UP
  RETEST
  DISCLOSURE
}

model BugBountyCalendarEvent {
  id          String            @id @default(uuid())
  workspaceId String
  programId   String?
  reportId    String?
  type        CalendarEventType
  title       String
  dueAt       DateTime
  completedAt DateTime?
  notes       String?
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Set once a Report Deadline / Reminder notification has been created
  /// for this event (BugBountyDeadlineNotifierService) — the dedupe
  /// marker that keeps the poller from re-notifying on every tick.
  notifiedAt  DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  program   BugBountyProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  report    BugReport?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  creator   User              @relation(fields: [createdBy], references: [id])

  @@index([workspaceId, dueAt])
  @@index([dueAt, notifiedAt])
  @@map("bugbounty_calendar_events")
}

enum BugBountyNotificationType {
  REPORT_DEADLINE
  REMINDER
  PROGRAM_UPDATE
  AI_RECOMMENDATION
  // Module 10 — Automation Engine: raised by a Workflow's `notify` step
  // (see automation-engine/workflow-executor.service.ts).
  WORKFLOW_ALERT
  // Module 15 — AI cost control (task #340): raised by
  // AiBudgetEnforcerService when a workspace crosses a soft (warning) or
  // hard (blocked) AiBudgetPolicy limit.
  AI_BUDGET_ALERT
  // Module 17 — Automation rules engine (task #487): raised by a NOTIFY
  // action (the only action kind an automation rule may run unattended,
  // per AutomationRule.requiresApproval's doc comment).
  AUTOMATION_RULE_ALERT
  // Module 17 — Notification engine extensions (task #482). These three
  // are raised unconditionally by SocNotificationService's EventBus
  // subscribers (apps/api/src/modules/soc-notifications/) whenever the
  // corresponding SOC event fires — independent of whether the workspace
  // has any AUTOMATION_RULE_ALERT-producing automation rule configured.
  // See that module's doc comment for why baseline SOC notifications are
  // not made conditional on automation-rule setup.
  INCIDENT_CREATED
  SLA_BREACH
  THREAT_INDICATOR_MATCH
  // Module 17 — SOC Event Bus wiring (task #486). Raised by the same
  // unconditional EventBus-subscriber pattern as the three values above,
  // on `RemediationTaskClosedEvent` (RemediationService.setStatus →
  // CLOSED, after the finding-verification guard already passed).
  REMEDIATION_TASK_CLOSED
}

/// `relatedEntityType`/`relatedEntityId` is a loose reference, same
/// reasoning as Bookmark above.
model BugBountyNotification {
  id                String                    @id @default(uuid())
  workspaceId       String
  userId            String
  type              BugBountyNotificationType
  title             String
  body              String?
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime                  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([workspaceId, createdAt])
  @@map("bugbounty_notifications")
}

// ---------------------------------------------------------------------------
// Module 9 — Bug Bounty Platform + Collaboration + Reporting Suite
// See docs/adr/0009-bug-bounty-operating-system.md. Everything below this
// line is additive: new models/enums only, plus the additive column/enum
// edits made earlier in this file (grep "Module 9" throughout for every
// touch point). No Module 1-8 model was renamed, dropped, or had a
// required column added to an existing row set without a default.
// ---------------------------------------------------------------------------

// --- Collaboration -----------------------------------------------------

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// An outstanding invite to join a Workspace at a given role. Distinct
/// from WorkspaceMember (which is the accepted, active membership row) —
/// mirrors the EmailVerificationToken/PasswordResetToken pattern already
/// in this schema (a bearer token, an expiry, a status) rather than
/// inventing a new one.
model WorkspaceInvite {
  id               String                @id @default(uuid())
  workspaceId      String
  email            String
  role             WorkspaceMemberRole   @default(MEMBER)
  token            String                @unique
  status           WorkspaceInviteStatus @default(PENDING)
  invitedBy        String
  acceptedByUserId String?
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter    User      @relation("WorkspaceInviteInviter", fields: [invitedBy], references: [id])
  acceptedBy User?     @relation("WorkspaceInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email])
  @@map("workspace_invites")
}

/// Polymorphic (loose-reference, no DB FK) entity comment thread — same
/// established pattern as Bookmark/ActivityEvent for "must be able to
/// point at several different tables". `parentCommentId` makes this a
/// one-level-deep reply thread (a reply's own replies are flattened under
/// the same parent in the UI) rather than unbounded nesting, which is
/// enough for the spec's "Comments" + "Mentions" requirement without the
/// query complexity of a real tree.
enum CommentEntityType {
  PROGRAM
  FINDING
  REPORT
  TARGET
  NOTE
  TASK
}

model Comment {
  id             String            @id @default(uuid())
  workspaceId    String
  entityType     CommentEntityType
  entityId       String
  authorId       String
  bodyMarkdown   String
  parentCommentId String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  mentions  Mention[]

  @@index([workspaceId, entityType, entityId])
  @@index([parentCommentId])
  @@map("comments")
}

/// One row per @mentioned user in a Comment — lets the mentioned user's
/// notification feed and "unread mentions" badge query directly by
/// `mentionedUserId` instead of parsing `bodyMarkdown` for `@handles` on
/// every read.
model Mention {
  id              String    @id @default(uuid())
  commentId       String
  mentionedUserId String
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId, readAt])
  @@map("mentions")
}

enum AssignableEntityType {
  PROGRAM
  FINDING
  REPORT
  TARGET
  TASK
}

enum AssignmentStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// "Assign this Finding/Report/Target/Task to a teammate" — separate from
/// Comment/Mention since an assignment is a stateful piece of work
/// tracking (has its own OPEN/IN_PROGRESS/DONE lifecycle and a due date),
/// not a message. One active assignment per entity is not enforced at the
/// DB level (a Program could reasonably have more than one active
/// assignee, e.g. co-triagers) — the API layer decides whether to allow
/// multiples per entityId.
model Assignment {
  id         String               @id @default(uuid())
  workspaceId String
  entityType AssignableEntityType
  entityId   String
  assigneeId String
  assignedBy String
  status     AssignmentStatus     @default(OPEN)
  dueAt      DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User      @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigner  User      @relation("AssignmentAssigner", fields: [assignedBy], references: [id])

  @@index([workspaceId, entityType, entityId])
  @@index([assigneeId, status])
  @@map("assignments")
}

/// A lightweight to-do item — the spec's "Task Lists", distinct from
/// Assignment (which attaches to an *existing* domain entity like a
/// Finding) in that a Task can exist standalone ("write the monthly
/// report", "rotate the pairing token") with only an optional loose link
/// back to whatever it's about.
model TaskItem {
  id          String    @id @default(uuid())
  workspaceId String
  projectId   String?
  entityType  String?
  entityId    String?
  title       String
  description String?
  done        Boolean   @default(false)
  assigneeId  String?
  dueAt       DateTime?
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee  User?     @relation("TaskItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator   User      @relation("TaskItemCreator", fields: [createdBy], references: [id])

  @@index([workspaceId, done])
  @@index([assigneeId, done])
  @@map("task_items")
}

// --- Automation (scheduled jobs) ---------------------------------------

enum ScheduledJobKind {
  DAILY_RECON
  WEEKLY_NUCLEI
  MONTHLY_ASSET_DISCOVERY
  SCOPE_REFRESH
  SCREENSHOT_UPDATE
  REPORT_BACKUP
  CUSTOM
}

enum ScheduledJobRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// A recurring job definition. `cronExpression` is standard 5-field cron
/// (evaluated by the same lightweight in-process scheduler described in
/// automation/scheduled-job-runner.service.ts — no external job queue
/// infra added for this). `kind` selects which handler runs; `config` is
/// kind-specific (e.g. DAILY_RECON's config picks which recon tools to
/// run). This is a *server-side* schedule for workspace-linked
/// automation; the Desktop Agent (Module 7) has its own local job
/// scheduling for fully offline recon and is unaffected by this table.
model ScheduledJob {
  id             String            @id @default(uuid())
  workspaceId    String
  projectId      String?
  programId      String?
  targetId       String?
  name           String
  kind           ScheduledJobKind
  cronExpression String
  config         Json?
  enabled        Boolean           @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastRunStatus  ScheduledJobRunStatus?
  createdBy      String
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  program   BugBountyProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  target    Target?           @relation(fields: [targetId], references: [id], onDelete: SetNull)
  creator   User              @relation(fields: [createdBy], references: [id])
  runs      ScheduledJobRun[]

  @@index([workspaceId, enabled])
  @@index([nextRunAt])
  @@map("scheduled_jobs")
}

model ScheduledJobRun {
  id             String                @id @default(uuid())
  scheduledJobId String
  status         ScheduledJobRunStatus @default(PENDING)
  startedAt      DateTime              @default(now())
  finishedAt     DateTime?
  log            String?
  resultSummary  Json?

  scheduledJob ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  @@index([scheduledJobId, startedAt])
  @@map("scheduled_job_runs")
}

// --- Notifications: multi-channel delivery ------------------------------

enum NotificationChannel {
  DESKTOP
  BROWSER
  EMAIL
  WEBHOOK
  DISCORD
  SLACK
  TELEGRAM
  CUSTOM_API
}

/// Per-user (or workspace-default, when `userId` is null) delivery
/// configuration for one channel. `config` is channel-shaped Json, e.g.
/// `{"webhookUrl": "..."}` for DISCORD/SLACK, `{"botToken": "...",
/// "chatId": "..."}` for TELEGRAM, `{"endpoint": "...", "headers": {...}}`
/// for CUSTOM_API — any secret inside it (webhook URLs count, since they're
/// bearer-capability URLs; bot tokens definitely) is encrypted at rest
/// with the same AES-256-GCM envelope `security/encryption.service.ts`
/// already uses for AiProviderCredential (Module 5 Phase 1 BYOK), reused
/// here rather than re-implemented.
model NotificationChannelConfig {
  id          String              @id @default(uuid())
  workspaceId String
  userId      String?
  channel     NotificationChannel
  config      Json
  enabled     Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, channel])
  @@index([userId, channel])
  @@map("notification_channel_configs")
}

/// One row per (notification, channel) delivery attempt — lets the
/// Notification Center show "delivered to Slack, failed on Telegram"
/// instead of a single opaque status, and gives the multi-channel
/// dispatcher (notifications-channels/notification-dispatcher.service.ts)
/// something to retry against.
model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  status         String
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  notification BugBountyNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_deliveries")
}

// --- Public API: webhook tokens -----------------------------------------

/// Outbound webhook registration — distinct from ApiKey (which
/// authenticates *inbound* requests to PentestHub's API). `secret` signs
/// the outbound payload (HMAC-SHA256, header `X-PentestHub-Signature`) so
/// the receiving endpoint can verify authenticity; encrypted at rest the
/// same way NotificationChannelConfig's secrets are.
model WebhookToken {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  url             String
  secret          String
  events          String[]
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdBy       String
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])
  deliveries WebhookDelivery[]

  @@index([workspaceId, enabled])
  @@map("webhook_tokens")
}

/// One row per delivery attempt of a real domain event to a
/// WebhookToken's URL. Module 10 addition — the Module 9 WebhookToken
/// model only supported manual registration + an on-demand `test`
/// delivery; this is what turns it into an actual event-driven webhook
/// system: WebhookDispatchHandler (in
/// apps/api/src/modules/public-api/webhooks/) listens on the same
/// EventBus every ActivityDomainEvent already flows through, matches
/// `event.verb` against each enabled WebhookToken's `events` array (or a
/// `"*"` wildcard subscription), and inserts one PENDING row per match.
/// WebhookDeliveryQueueService (a minute-tick poller, same hand-rolled
/// `setInterval` pattern as ScheduledJobRunnerService/
/// ReportScheduleRunnerService — see those files' doc comments for why
/// no `@nestjs/schedule` dependency is used) then delivers PENDING rows
/// with exponential backoff up to `maxAttempts`, moving anything still
/// failing after that to DEAD_LETTER for manual redelivery via the
/// `POST .../deliveries/:id/redeliver` route.
model WebhookDelivery {
  id            String                @id @default(uuid())
  webhookTokenId String
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempt       Int                   @default(0)
  maxAttempts   Int                   @default(6)
  statusCode    Int?
  error         String?
  nextAttemptAt DateTime              @default(now())
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  webhookToken WebhookToken @relation(fields: [webhookTokenId], references: [id], onDelete: Cascade)

  @@index([webhookTokenId, status])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTER
}

// =============================================================================
// Module 10 — Enterprise Platform + SaaS + Global Infrastructure
//
// Everything below is additive, per the project's standing schema-evolution
// rule (see docs/adr/0010-enterprise-platform.md). `Workspace` keeps its
// Module 1-9 meaning unchanged (a single-team working area); `Organization`
// is a new, optional tenant layer *above* it — a Workspace's `organizationId`
// is nullable specifically so every personal/small-team workspace created by
// Modules 1-9 keeps working with zero migration. Enterprise customers get
// Organization -> Department/Team -> Workspace; everyone else never needs to
// know Organization exists.
// =============================================================================

// --- Multi-tenant architecture ----------------------------------------------

enum OrganizationStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
}

/// The tenant. A Workspace optionally belongs to one Organization; an
/// Organization has many Workspaces, Departments, and Teams. Tenant
/// isolation is enforced the same way workspace isolation always has been
/// in this codebase — every query scopes by `organizationId`, enumeration-
/// safe 404s on cross-tenant access (see `enterprise/tenant-scope.util.ts`).
model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  domain    String?
  logoUrl   String?
  plan      String             @default("free")
  status    OrganizationStatus @default(ACTIVE)
  createdBy String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  /// Module 14 — Tenant Management (Enterprise Edition only; see
  /// `EditionService`/`RequiresEdition`). All nullable/defaulted so
  /// Community Edition organizations (which never touch these fields)
  /// need no data migration and no UI ever forces a value into them.
  /// `billingProviderCustomerId`/`subscriptionStatus` are a payment-
  /// provider-agnostic pair a real Stripe/Paddle/etc. webhook handler
  /// would populate — this module ships the hook surface
  /// (`BillingWebhookController`), not a payment integration itself.
  billingEmail              String?
  billingProviderCustomerId String?
  subscriptionStatus        String?   @default("none")
  subscriptionRenewsAt      DateTime?
  customDomain              String?
  customDomainVerifiedAt    DateTime?
  brandingPrimaryColor      String?
  brandingFaviconUrl        String?

  creator User @relation("OrganizationCreator", fields: [createdBy], references: [id])

  members                OrganizationMember[]
  departments            Department[]
  teams                  Team[]
  workspaces             Workspace[]
  invites                OrganizationInvite[]
  quota                  ResourceQuota?
  settings               OrganizationSettings?
  customRoles            CustomRole[]
  permissionGroups       PermissionGroup[]
  resourcePermissions    ResourcePermission[]
  temporaryPermissions   TemporaryPermission[]
  approvalWorkflows      ApprovalWorkflow[]
  approvalRequests       ApprovalRequest[]
  workerNodes            WorkerNode[]
  distributedJobs        DistributedJob[]
  installedPlugins       PluginInstallation[]
  publishedPlugins       Plugin[]
  integrationConnections IntegrationConnection[]
  wikiPages              WikiPage[]
  reviewQueueItems       ReviewQueueItem[]
  chatChannels           InternalChatChannel[]
  enterpriseReports      EnterpriseReport[]
  reportSchedules        ReportSchedule[]
  slaPolicies            SlaPolicy[]
  dataRetentionPolicies  DataRetentionPolicy[]
  backupPolicies         BackupPolicy[]
  complianceExports      ComplianceExportRequest[]
  apiRequestLogs         ApiRequestLog[]
  workflows              Workflow[]
  backupRuns             BackupRun[]
  licenses               License[]
  // Module 15 — additive back-relations. `subscription` is 1:1
  // (`Subscription.organizationId` is `@unique`) — every Organization,
  // Community or Enterprise, gets exactly one, defaulted to
  // `PlanTier.FREE`/`BillingProviderKind.NONE` at creation.
  subscription  Subscription?
  invoices      Invoice[]
  paymentMethods PaymentMethod[]

  @@map("organizations")
}

/// Ten-level enterprise role hierarchy (Module 10 spec). Deliberately kept
/// separate from `WorkspaceMemberRole` (Module 1) and the bug-bounty
/// Collaboration roles (Module 9) rather than merging: those two answer
/// "what can you do inside one workspace," this answers "what can you do
/// across a whole tenant." `enterprise/enterprise-permissions.util.ts`
/// defines the total order and the action->minimum-role matrix, mirroring
/// the pattern `collaboration/permissions.util.ts` established in Module 9.
enum EnterpriseRole {
  SUPER_ADMIN
  ORG_OWNER
  ADMIN
  SECURITY_MANAGER
  TEAM_LEAD
  PENTESTER
  BUG_HUNTER
  DEVELOPER
  VIEWER
  GUEST
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
}

model OrganizationMember {
  id             String                    @id @default(uuid())
  organizationId String
  userId         String
  role           EnterpriseRole            @default(VIEWER)
  departmentId   String?
  status         OrganizationMemberStatus  @default(ACTIVE)
  joinedAt       DateTime                  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamMemberships TeamMember[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

/// Self-referencing hierarchy (`parentDepartmentId`) — "Department support"
/// in the spec. A department groups Teams and OrganizationMembers under one
/// manager; nesting depth is unbounded, walked at read time
/// (`enterprise/department-hierarchy.util.ts`), not materialized.
model Department {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  parentDepartmentId String?
  managerUserId      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment Department?   @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[]  @relation("DepartmentHierarchy")
  manager          User?         @relation("DepartmentManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  members          OrganizationMember[]
  teams            Team[]

  @@index([organizationId])
  @@map("departments")
}

/// "Team hierarchy" — nested via `parentTeamId`, distinct from Department
/// (a department is an org unit; a team is a working group that may span,
/// or sit inside, a department, and owns zero or more Workspaces where the
/// actual pentest/bug-bounty work happens).
model Team {
  id             String   @id @default(uuid())
  organizationId String
  departmentId   String?
  parentTeamId   String?
  name           String
  leadUserId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parentTeam   Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams   Team[]       @relation("TeamHierarchy")
  lead         User?        @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members      TeamMember[]
  workspaces   Workspace[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id                   String   @id @default(uuid())
  teamId               String
  organizationMemberId String
  joinedAt             DateTime @default(now())

  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMemberId])
  @@map("team_members")
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model OrganizationInvite {
  id             String                    @id @default(uuid())
  organizationId String
  email          String
  role           EnterpriseRole
  departmentId   String?
  teamId         String?
  invitedBy      String
  token          String                    @unique
  status         OrganizationInviteStatus  @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime                  @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("OrganizationInviteInviter", fields: [invitedBy], references: [id])

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invites")
}

/// "Resource quotas" — soft limits checked at write time
/// (`enterprise/quota-enforcement.util.ts`); exceeding one raises a normal
/// 403 `QUOTA_EXCEEDED`, never a hard outage. `null` on any field means
/// unlimited (paid/custom plans).
model ResourceQuota {
  id                    String   @id @default(uuid())
  organizationId        String   @unique
  maxWorkspaces         Int?
  maxMembers            Int?
  maxTeams              Int?
  maxStorageMb          Int?
  maxScansPerMonth      Int?
  maxAiTokensPerMonth   Int?
  maxApiKeysPerMember   Int?
  maxWebhooksPerWorkspace Int?
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("resource_quotas")
}

model OrganizationSettings {
  id                    String   @id @default(uuid())
  organizationId        String   @unique
  enforceMfa            Boolean  @default(false)
  allowedEmailDomains   String[]
  defaultMemberRole     EnterpriseRole @default(VIEWER)
  sessionTimeoutMinutes Int?
  dataResidency         String?
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// --- RBAC & ABAC expansion ---------------------------------------------------

/// "Custom roles" — an organization can define a role beyond the fixed
/// `EnterpriseRole` ladder. `basedOnRole` anchors it at a rank in the total
/// order (for `requireRole()`-style comparisons) while
/// `CustomRolePermission` rows add specific permission keys on top.
model CustomRole {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String?
  basedOnRole    EnterpriseRole  @default(VIEWER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  CustomRolePermission[]

  @@unique([organizationId, name])
  @@map("custom_roles")
}

model CustomRolePermission {
  id            String @id @default(uuid())
  customRoleId  String
  permissionKey String

  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@unique([customRoleId, permissionKey])
  @@map("custom_role_permissions")
}

/// A named, reusable bundle of permission keys ("Read-only auditor",
/// "Report reviewer") an org admin can hand out without minting a whole
/// CustomRole.
model PermissionGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  permissionKeys String[]
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("permission_groups")
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PermissionSubjectType {
  USER
  TEAM
  ROLE
}

/// ABAC: an explicit rule grants or denies an action on a specific resource
/// (or resource type) to a subject, optionally gated by JSON-encoded
/// attribute conditions (e.g. `{"resourceOwnerId": "$self"}` or
/// `{"tag": "production"}`), evaluated by
/// `enterprise/abac-evaluator.util.ts`. DENY always wins over ALLOW when
/// both match — same "most restrictive wins" rule Module 6's scope
/// classifier already uses for OUT_OF_SCOPE vs IN_SCOPE.
model ResourcePermission {
  id             String                 @id @default(uuid())
  organizationId String
  subjectType    PermissionSubjectType
  subjectId      String
  resourceType   String
  resourceId     String?
  action         String
  effect         PermissionEffect       @default(ALLOW)
  conditions     Json?
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType, resourceId])
  @@index([subjectType, subjectId])
  @@map("resource_permissions")
}

/// Time-boxed permission grant ("break glass" access, temporary elevated
/// review rights). Expired rows are simply ignored by the evaluator rather
/// than deleted, preserving an audit trail of what was granted and when.
model TemporaryPermission {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  permissionKey  String
  resourceType   String?
  resourceId     String?
  grantedBy      String
  reason         String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("TemporaryPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantor      User         @relation("TemporaryPermissionGrantor", fields: [grantedBy], references: [id])

  @@index([organizationId, userId])
  @@map("temporary_permissions")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Defines what needs sign-off (e.g. "publishing a plugin", "exporting
/// compliance data") and who can approve it; `ApprovalRequest` is one
/// instance of that workflow being triggered.
model ApprovalWorkflow {
  id               String          @id @default(uuid())
  organizationId   String
  name             String
  resourceType     String
  requiredApprovals Int            @default(1)
  approverRole     EnterpriseRole  @default(ADMIN)
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     ApprovalRequest[]

  @@map("approval_workflows")
}

model ApprovalRequest {
  id             String                 @id @default(uuid())
  workflowId     String
  organizationId String
  requestedBy    String
  resourceType   String
  resourceId     String
  reason         String?
  status         ApprovalRequestStatus  @default(PENDING)
  decidedBy      String?
  decisionNote   String?
  createdAt      DateTime               @default(now())
  decidedAt      DateTime?

  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User             @relation("ApprovalRequestRequester", fields: [requestedBy], references: [id])
  decider      User?            @relation("ApprovalRequestDecider", fields: [decidedBy], references: [id])

  @@index([organizationId, status])
  @@map("approval_requests")
}

// --- Distributed job system --------------------------------------------------

enum WorkerNodeStatus {
  ONLINE
  DRAINING
  OFFLINE
  UNHEALTHY
}

/// A single worker process (the existing `worker.main.ts` binary, or a
/// future dedicated machine) registers itself here and renews
/// `lastHeartbeatAt` on an interval; `enterprise/worker-health.util.ts`
/// marks a node UNHEALTHY once its heartbeat is older than a threshold, and
/// the scheduler stops assigning it new jobs. This is additive
/// infrastructure alongside the existing single-process
/// `ReconJobPollerService`/`VulnScanJobPollerService` pollers (Modules 3-4)
/// — see ADR 0010 §3 for why those were not rewritten to use it yet.
model WorkerNode {
  id               String           @id @default(uuid())
  organizationId   String?
  name             String
  hostname         String
  status           WorkerNodeStatus @default(ONLINE)
  capabilities     String[]
  maxConcurrency   Int              @default(4)
  currentLoad      Int              @default(0)
  registeredAt     DateTime         @default(now())
  lastHeartbeatAt  DateTime         @default(now())
  /// Module 14 — Auto Update: the running worker binary's version
  /// (`npm_package_version` of the process that called register/
  /// heartbeat), nullable so pre-existing rows and any client that
  /// doesn't report one aren't broken. Powers version-skew visibility
  /// across a horizontally-scaled worker fleet during a rolling upgrade
  /// — see docs/architecture/auto-update.md.
  version          String?

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         DistributedJob[]
  jobEvents    JobEvent[]

  @@index([status])
  @@map("worker_nodes")
}

enum DistributedJobPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DistributedJobStatus {
  QUEUED
  ASSIGNED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  RETRYING
}

/// The generic distributed-queue row: `type` + `payload` describe the unit
/// of work (recon scan, report render, workflow step, ...), not a fixed
/// enum of job kinds — new job types need zero schema change, matching the
/// Desktop Agent's `offline_queue` design philosophy (Module 7).
model DistributedJob {
  id             String                  @id @default(uuid())
  organizationId String?
  workspaceId    String?
  type           String
  payload        Json
  priority       DistributedJobPriority  @default(NORMAL)
  status         DistributedJobStatus    @default(QUEUED)
  workerId       String?
  attempts       Int                     @default(0)
  maxAttempts    Int                     @default(3)
  lastError      String?
  scheduledFor   DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdBy      String?
  // Module 18 — task #505. Same purpose/rationale as ReconJob.requestId —
  // a dedicated column (rather than folding it into `payload`) so it's
  // queryable/indexable without a job-type-specific JSON path, and every
  // job type gets correlation for free without each `type` handler having
  // to remember to put it in its own payload shape.
  requestId      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker       WorkerNode?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  events       JobEvent[]

  @@index([status, priority, scheduledFor])
  @@index([workerId])
  // Module 18 — task #508 (database reliability review). Workspace/
  // organization-scoped job listings (Admin Console job history, per-
  // workspace usage views) had no covering index.
  @@index([workspaceId])
  @@index([organizationId])
  @@map("distributed_jobs")
}

