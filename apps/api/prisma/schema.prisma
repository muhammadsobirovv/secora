  edition        LicenseEdition @default(ENTERPRISE)
  licenseKeyHash String         @unique
  issuedTo       String
  seats          Int?
  status         LicenseStatus  @default(ACTIVE)
  activatedAt    DateTime       @default(now())
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

