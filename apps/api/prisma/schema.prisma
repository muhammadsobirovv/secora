// PentestHub AI — Auth + platform-foundation data model.
// See docs/modules/01-auth.md and docs/adr/0001-auth-module.md for rationale.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

/// A registered user account. Password auth and OAuth auth are both optional
/// per-user — passwordHash is null for OAuth-only accounts.
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String?
  displayName      String
  avatarUrl        String?
  emailVerified    Boolean    @default(false)
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  oauthAccounts           OAuthAccount[]
  refreshTokens            RefreshToken[]
  sessions                  Session[]
  mfaFactor                 MfaFactor?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfaChallengeTokens       MfaChallengeToken[]
  oauthExchangeCodes       OAuthExchangeCode[]
  auditEvents               AuditEvent[]
  userRoles                 UserRole[]
  workspaceMemberships    WorkspaceMember[]
  apiKeys                   ApiKey[]
  preferences                UserPreferences?

  projectsCreated      Project[]
  projectMemberships   ProjectMember[]
  projectFavorites     ProjectFavorite[]
  targetsCreated       Target[]
  notesAuthored        Note[]
  evidenceCreated      Evidence[]
  attachmentsUploaded  Attachment[]
  activityEvents       ActivityEvent[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ---------------------------------------------------------------------------
// OAuth
// ---------------------------------------------------------------------------

/// A linked OAuth identity (Google, GitHub, ...). A user can link multiple providers.
model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

/// One-time code handed to the frontend after an OAuth callback, exchanged
/// for real tokens via POST /auth/oauth/exchange. Keeps access/refresh
/// tokens out of the redirect URL (browser history, referrer headers, logs).
model OAuthExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_exchange_codes")
}

// ---------------------------------------------------------------------------
// Sessions & tokens
// ---------------------------------------------------------------------------

/// One browser/app session tied to a specific device. Distinct from RefreshToken:
/// a session is the human-facing "device" record; a refresh token is the credential.
model Session {
  id           String    @id @default(uuid())
  userId       String
  deviceName   String
  ipAddress    String
  userAgent    String
  /// Parsed from userAgent at session-creation time (ua-parser-js). Nullable
  /// because parsing can fail on unusual/unknown user agents.
  browser      String?
  os           String?
  /// Geo-IP location, e.g. "City, Country". Left unpopulated for now — no
  /// geo-IP provider is configured in this environment. Column exists so a
  /// provider can be wired later without a migration.
  location     String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Refresh tokens are stored hashed (never plaintext) and rotated on every use.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  sessionId         String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// MFA
// ---------------------------------------------------------------------------

/// TOTP-based MFA factor. One per user for v1 (no backup-codes-as-separate-factor yet).
model MfaFactor {
  id          String    @id @default(uuid())
  userId      String    @unique
  secret      String
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes MfaBackupCode[]

  @@map("mfa_factors")
}

/// Individually hashed, single-use backup codes. Replaces a plain string
/// array so each code can be consumed exactly once and never stored in
/// plaintext.
model MfaBackupCode {
  id          String    @id @default(uuid())
  mfaFactorId String
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  mfaFactor MfaFactor @relation(fields: [mfaFactorId], references: [id], onDelete: Cascade)

  @@index([mfaFactorId])
  @@map("mfa_backup_codes")
}

/// Issued after password verification when MFA is enabled; consumed by
/// POST /auth/mfa/challenge to complete login.
model MfaChallengeToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenge_tokens")
}

// ---------------------------------------------------------------------------
// Email verification / password reset
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// RBAC foundation (Role / Permission / UserRole / RolePermission)
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userRoles        UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Workspaces (Module 1: personal workspace at registration; Module 2:
// settings/avatar + the Projects/Targets/... foundation attaches here)
// ---------------------------------------------------------------------------

/// Every user gets one personal Workspace created at registration (see
/// docs/adr/0001-auth-module.md). Invites, switching, and multi-member
/// workflows beyond the OWNER/ADMIN/MEMBER foundation are future-module
/// work. `plan` is reserved for a future billing tier — unread by
/// anything this sprint, just avoids a migration on a large table later.
model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  avatarUrl   String?
  description String?
  plan        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        WorkspaceMember[]
  settings       WorkspaceSettings?
  projects       Project[]
  tags           Tag[]
  attachments    Attachment[]
  activityEvents ActivityEvent[]

  @@map("workspaces")
}

model WorkspaceSettings {
  id                   String        @id @default(uuid())
  workspaceId          String        @unique
  defaultProjectStatus ProjectStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

model WorkspaceMember {
  id          String              @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole
  joinedAt    DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// `visibility` is reserved for future access-control beyond
/// ProjectMember/WorkspaceMember — not enforced by any query this sprint.
/// `deletedAt` (soft delete) is independent of `status`: an ARCHIVED
/// project is still visible in an "archived" filter; a deleted one isn't
/// visible anywhere until restored... except deletion has no restore path
/// (only archive does) — see ProjectsModule README-equivalent (ADR 0002).
enum ProjectVisibility {
  PRIVATE
  WORKSPACE
  PUBLIC
}

model Project {
  id          String            @id @default(uuid())
  workspaceId String
  name        String
  description String?
  status      ProjectStatus     @default(ACTIVE)
  visibility  ProjectVisibility @default(WORKSPACE)
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User            @relation(fields: [createdBy], references: [id])
  members   ProjectMember[]
  favorites ProjectFavorite[]
  targets        Target[]
  notes          Note[]
  evidence       Evidence[]
  tags           ProjectTag[]
  activityEvents ActivityEvent[]

  @@index([workspaceId])
  @@map("projects")
}

enum ProjectMemberRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTOR)
  addedAt   DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// Per-user favorite — not a flat boolean on Project, since different
/// members of the same project favorite it independently.
model ProjectFavorite {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_favorites")
}

// ---------------------------------------------------------------------------
// Tags (workspace-scoped, reusable across Projects and Targets)
// ---------------------------------------------------------------------------

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectTags ProjectTag[]
  targetTags  TargetTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

model TargetTag {
  targetId String
  tagId    String

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([targetId, tagId])
  @@map("target_tags")
}

// ---------------------------------------------------------------------------
// Targets
// ---------------------------------------------------------------------------

enum TargetType {
  DOMAIN
  SUBDOMAIN
  URL
  IP_ADDRESS
  CIDR
  API
  MOBILE_APP
  INTERNAL_ASSET
}

enum TargetEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  UNKNOWN
}

enum TargetScopeStatus {
  IN_SCOPE
  OUT_OF_SCOPE
  PENDING_REVIEW
}

/// `value` holds the actual domain/IP/URL/CIDR/... string; `type` says how
/// to interpret it. No Recon logic reads/writes this model yet —
/// `customFields` is a forward-compat escape hatch for future-module
/// per-target data without a schema change.
model Target {
  id           String            @id @default(uuid())
  projectId    String
  type         TargetType
  value        String
  name         String?
  description  String?
  environment  TargetEnvironment @default(UNKNOWN)
  scopeStatus  TargetScopeStatus @default(PENDING_REVIEW)
  customFields Json?
  createdBy    String
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User        @relation(fields: [createdBy], references: [id])
  notes    Note[]
  evidence Evidence[]
  tags     TargetTag[]

  @@index([projectId])
  @@index([type])
  @@map("targets")
}

// ---------------------------------------------------------------------------
// Notes (Markdown; optionally attached to a specific Target)
// ---------------------------------------------------------------------------

model Note {
  id        String    @id @default(uuid())
  projectId String
  targetId  String?
  title     String?
  content   String
  authorId  String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  Target? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([targetId])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

enum EvidenceType {
  SCREENSHOT
  HTTP_REQUEST
  HTTP_RESPONSE
  FILE
  LOG
  VIDEO
}

/// `textContent` holds HTTP request/response or log text captured inline;
/// screenshots/files/video are backed by an Attachment instead. `checksum`
/// (SHA-256 hex) is computed at upload time for file-backed evidence.
model Evidence {
  id          String       @id @default(uuid())
  projectId   String
  targetId    String?
  type        EvidenceType
  title       String
  description String?
  textContent String?
  checksum    String?
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  Target? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([targetId])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// Attachments (polymorphic — see docs/adr/0002-workspace-foundation-module.md)
// ---------------------------------------------------------------------------

enum AttachableType {
  WORKSPACE
  PROJECT
  TARGET
  NOTE
  EVIDENCE
}

/// No DB-level FK to the attached-to row (attachableType/attachableId is a
/// loose reference, not a relation) — the parent-existence check happens
/// in the upload command handler, not the database. Deliberate: this is
/// the one relation in the schema that needs to point at five different
/// parent tables, which a real FK can't express. workspaceId is always
/// set (even when attachableType is TARGET/NOTE/etc.) so storage
/// ownership/quota tracking never needs to join through the polymorphic
/// reference.
model Attachment {
  id             String         @id @default(uuid())
  workspaceId    String
  attachableType AttachableType
  attachableId   String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  uploadedBy     String
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploadedBy], references: [id])

  @@index([attachableType, attachableId])
  @@index([workspaceId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Activity timeline (user-facing collaboration history — deliberately
// separate from AuditEvent, which is immutable security logging; see
// docs/adr/0002-workspace-foundation-module.md)
// ---------------------------------------------------------------------------

/// entityType/entityId is a loose reference for the same reason as
/// Attachment above, plus one more: this table must be able to describe
/// entities from modules that don't exist yet (Recon, AI, ...) without a
/// schema change — an ActivityEvent surviving its subject's hard deletion
/// is a feature (the timeline still reads "Target X was deleted"), not a
/// bug, so the lack of cascade-on-delete here is intentional, not just
/// tolerated.
model ActivityEvent {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String?
  actorUserId String?
  verb        String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// API keys (foundation for future CLI / browser extension / automation)
// ---------------------------------------------------------------------------

/// Schema + repository only this sprint — no issuing/listing/revoking
/// endpoints and no API-key auth strategy yet.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  /// Hashed like refresh tokens — the raw key is shown once at creation
  /// and never stored.
  keyHash    String    @unique
  /// Short visible identifier (e.g. first 8 chars of the raw key) so a
  /// user can tell keys apart in a list without re-exposing the secret.
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// User preferences
// ---------------------------------------------------------------------------

model UserPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique
  theme                 Theme    @default(SYSTEM)
  language              String   @default("en")
  timezone              String   @default("UTC")
  notificationsEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// userId is nullable + SetNull on delete so audit history survives account
/// deletion (a deleted account's history is still worth keeping).
model AuditEvent {
  id        String         @id @default(uuid())
  userId    String?
  type      AuditEventType
  ipAddress String
  userAgent String
  metadata  Json?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@map("audit_events")
}

enum AuditEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  REFRESH_TOKEN_ROTATED
  REFRESH_TOKEN_REUSE_DETECTED
  EMAIL_VERIFIED
  VERIFICATION_EMAIL_RESENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_SUCCESS
  MFA_CHALLENGE_FAILURE
  OAUTH_LINKED
  OAUTH_LOGIN
  SESSION_REVOKED
}
