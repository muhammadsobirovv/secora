  finishedAt     DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backupPolicy BackupPolicy? @relation(fields: [backupPolicyId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([status])
