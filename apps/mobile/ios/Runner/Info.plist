<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Module 12 — usage-description strings are mandatory on iOS for every
  privacy-sensitive API this app calls (camera/mic/photos/biometrics/
  speech) or App Store review rejects the build outright. Assumes the rest
  of the standard `flutter create --platforms=ios .` Xcode project scaffold
  already exists (CFBundleIdentifier, CFBundleVersion, and the Flutter-
  managed keys below are placeholders `flutter create` fills concretely) —
  see docs/mobile/flutter-development-guide.md "Project scaffolding".
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>PentestHub AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>pentesthub_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Evidence Capture -->
	<key>NSCameraUsageDescription</key>
	<string>PentestHub AI uses the camera to capture evidence (screenshots, photos, video) for your engagements.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PentestHub AI uses the microphone for voice chat with the AI Copilot and for audio evidence recording.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PentestHub AI needs access to your photo library to attach existing images as evidence.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PentestHub AI saves exported reports and captured evidence to your photo library when you choose to.</string>

	<!-- Biometric Authentication -->
	<key>NSFaceIDUsageDescription</key>
	<string>PentestHub AI uses Face ID to unlock the app after your session locks.</string>

	<!-- Voice -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PentestHub AI uses speech recognition for hands-free and push-to-talk chat with the AI Copilot.</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pentesthub</string>
			</array>
			<key>CFBundleURLName</key>
			<string>ai.pentesthub.mobile.oauth</string>
		</dict>
	</array>
</dict>
</plist>
