# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# Prisma generated client
apps/api/generated/

# Dev-local mail/storage provider output
apps/api/.mail-outbox/
apps/api/.storage/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
__pycache__/
*.pyc

# Module 11 — pnpm's local package store, created by this sandbox's
# `pnpm install`; never source, never something to commit.
.pnpm-store/

# Module 10 — Production Deployment: real Kubernetes Secret manifests
# (as opposed to the committed 02-secret.yaml.example template) must
# never be committed — see that file's own comment for the recommended
# way to create the real Secret without writing plaintext to disk at all.
deploy/k8s/*secret*.yaml
!deploy/k8s/*secret*.yaml.example
